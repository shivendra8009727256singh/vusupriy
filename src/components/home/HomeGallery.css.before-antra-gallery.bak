.home-gallery {
  --gallery-gold: #b48f4e;
  --gallery-teal: #004758;

  position: relative;
  overflow: hidden;
  padding: 110px 0 90px;
  background: #f5f2ed;
  color: #171717;
}

.home-gallery-heading {
  display: grid;
  grid-template-columns: minmax(0, 1.45fr) minmax(260px, 0.55fr);
  gap: 60px;
  align-items: end;
  margin-bottom: 70px;
}

.home-gallery-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 22px;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  font-size: 11px;
  font-weight: 700;
}

.home-gallery-eyebrow i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--gallery-gold);
}

.home-gallery-heading h2 {
  margin: 0;
  max-width: 900px;
  font-size: clamp(54px, 6.5vw, 104px);
  line-height: 0.9;
  letter-spacing: -0.055em;
  font-weight: 500;
}

.home-gallery-heading h2 em {
  color: var(--gallery-gold);
  font-family: Georgia, 'Times New Roman', serif;
  font-weight: 400;
}

.home-gallery-heading-side {
  padding-bottom: 8px;
}

.home-gallery-heading-side p {
  margin: 0 0 26px;
  max-width: 390px;
  color: #686868;
  font-size: 15px;
  line-height: 1.75;
}

.home-gallery-heading-side a {
  display: inline-flex;
  align-items: center;
  gap: 18px;
  color: #171717;
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-size: 12px;
  font-weight: 700;
}

.home-gallery-heading-side a span {
  color: var(--gallery-gold);
  font-size: 17px;
}

.home-gallery-stage {
  position: relative;
  width: 100%;
  height: clamp(430px, 48vw, 690px);
}

.home-gallery-track {
  position: relative;
  width: 100%;
  height: 100%;
}

.home-gallery-card {
  position: absolute;
  top: 50%;
  left: 50%;
  width: min(44vw, 650px);
  height: min(45vw, 650px);
  padding: 0;
  overflow: hidden;
  border: 0;
  border-radius: 2px;
  background: #ddd;
  cursor: pointer;
  transform-origin: center;
  transition:
    transform 900ms cubic-bezier(0.22, 1, 0.36, 1),
    opacity 700ms ease,
    filter 700ms ease;
  will-change: transform, opacity;
}

.home-gallery-card img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
}

.home-gallery-card:hover img {
  transform: scale(1.045);
}

.home-gallery-card--active {
  z-index: 5;
  opacity: 1;
  transform:
    translate(-50%, -50%)
    translateX(0)
    scale(1);
}

.home-gallery-card--previous {
  z-index: 3;
  opacity: 0.68;
  transform:
    translate(-50%, -50%)
    translateX(-72%)
    scale(0.78);
}

.home-gallery-card--next {
  z-index: 3;
  opacity: 0.68;
  transform:
    translate(-50%, -50%)
    translateX(72%)
    scale(0.78);
}

.home-gallery-card--far-previous {
  z-index: 1;
  opacity: 0.18;
  transform:
    translate(-50%, -50%)
    translateX(-125%)
    scale(0.62);
}

.home-gallery-card--far-next {
  z-index: 1;
  opacity: 0.18;
  transform:
    translate(-50%, -50%)
    translateX(125%)
    scale(0.62);
}

.home-gallery-card--hidden {
  z-index: 0;
  opacity: 0;
  pointer-events: none;
  transform:
    translate(-50%, -50%)
    scale(0.55);
}

.home-gallery-shade {
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.04) 30%,
      rgba(0, 0, 0, 0.74) 100%
    );
}

.home-gallery-card-number {
  position: absolute;
  z-index: 2;
  top: 28px;
  left: 30px;
  color: #fff;
  font-size: 12px;
  letter-spacing: 0.12em;
}

.home-gallery-card-copy {
  position: absolute;
  z-index: 2;
  left: 30px;
  right: 80px;
  bottom: 30px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
  color: #fff;
}

.home-gallery-card-copy small {
  margin-bottom: 8px;
  color: rgba(255, 255, 255, 0.72);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 10px;
}

.home-gallery-card-copy strong {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: clamp(25px, 2.4vw, 39px);
  font-weight: 400;
}

.home-gallery-card-arrow {
  position: absolute;
  z-index: 2;
  right: 30px;
  bottom: 30px;
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  border: 1px solid rgba(255,255,255,.5);
  border-radius: 50%;
  color: #fff;
  font-size: 19px;
}

.home-gallery-nav {
  position: absolute;
  z-index: 10;
  top: 50%;
  display: grid;
  place-items: center;
  width: 62px;
  height: 62px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: var(--gallery-gold);
  color: var(--gallery-teal);
  font-size: 22px;
  cursor: pointer;
  transform: translateY(-50%);
  transition:
    transform 250ms ease,
    background 250ms ease;
}

.home-gallery-nav:hover {
  transform: translateY(-50%) scale(1.08);
}

.home-gallery-nav--previous {
  left: clamp(18px, 4vw, 70px);
}

.home-gallery-nav--next {
  right: clamp(18px, 4vw, 70px);
}

.home-gallery-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18px;
  margin-top: 30px;
  font-size: 11px;
  letter-spacing: 0.12em;
}

.home-gallery-progress {
  display: flex;
  align-items: center;
  gap: 7px;
}

.home-gallery-dot {
  width: 22px;
  height: 3px;
  padding: 0;
  border: 0;
  background: #cfcac2;
  cursor: pointer;
  transition: width 350ms ease, background 350ms ease;
}

.home-gallery-dot--active {
  width: 48px;
  background: var(--gallery-gold);
}

@media (max-width: 900px) {
  .home-gallery {
    padding: 80px 0 70px;
  }

  .home-gallery-heading {
    grid-template-columns: 1fr;
    gap: 30px;
    margin-bottom: 50px;
  }

  .home-gallery-stage {
    height: 570px;
  }

  .home-gallery-card {
    width: min(70vw, 500px);
    height: 540px;
  }

  .home-gallery-card--previous {
    transform:
      translate(-50%, -50%)
      translateX(-68%)
      scale(0.78);
  }

  .home-gallery-card--next {
    transform:
      translate(-50%, -50%)
      translateX(68%)
      scale(0.78);
  }
}

@media (max-width: 600px) {
  .home-gallery {
    padding: 68px 0 58px;
  }

  .home-gallery-heading {
    margin-bottom: 36px;
  }

  .home-gallery-heading h2 {
    font-size: clamp(48px, 15vw, 70px);
  }

  .home-gallery-stage {
    height: 500px;
  }

  .home-gallery-card {
    width: 78vw;
    height: 470px;
  }

  .home-gallery-card--previous {
    opacity: 0.35;
    transform:
      translate(-50%, -50%)
      translateX(-82%)
      scale(0.72);
  }

  .home-gallery-card--next {
    opacity: 0.35;
    transform:
      translate(-50%, -50%)
      translateX(82%)
      scale(0.72);
  }

  .home-gallery-nav {
    width: 48px;
    height: 48px;
  }

  .home-gallery-nav--previous {
    left: 10px;
  }

  .home-gallery-nav--next {
    right: 10px;
  }

  .home-gallery-card-copy {
    left: 22px;
    bottom: 24px;
  }

  .home-gallery-card-number {
    top: 22px;
    left: 22px;
  }

  .home-gallery-card-arrow {
    right: 22px;
    bottom: 22px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .home-gallery-card,
  .home-gallery-card img {
    transition: none;
  }
}
