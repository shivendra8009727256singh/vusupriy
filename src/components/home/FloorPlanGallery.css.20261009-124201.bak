/* VASUPRIY - SLOW HORIZONTAL 3D FLOOR PLAN GALLERY */

.floor-plan-gallery {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #f5f1e9;
  isolation: isolate;
}

.floor-plan-gallery-viewport {
  width: 100%;
  overflow: hidden;
}

.floor-plan-gallery-track {
  display: flex;
  width: max-content;
  animation: floor-plan-marquee 100s linear infinite;
  will-change: transform;
}

.floor-plan-gallery-group {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
}

.floor-plan-gallery-item {
  flex: 0 0 auto;
  box-sizing: border-box;

  width: clamp(420px, 48vw, 760px);
  height: clamp(320px, 39vw, 560px);

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 15px 25px;
}

.floor-plan-gallery-item img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
}



@keyframes floor-plan-marquee {
  from {
    transform: translate3d(0, 0, 0);
  }

  to {
    transform: translate3d(-50%, 0, 0);
  }
}

@media (max-width: 640px) {
  .floor-plan-gallery-item {
    width: 88vw;
    height: 360px;
    padding: 12px;
  }

  .floor-plan-gallery-track {
    animation-duration: 110s;
  }
}

@media (prefers-reduced-motion: reduce) {
  .floor-plan-gallery-track {
    animation: none;
  }

  .floor-plan-gallery-viewport {
    overflow-x: auto;
  }
}