/* VASUPRIY - SLOW HORIZONTAL 3D FLOOR PLAN GALLERY */

.floor-plan-gallery {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: linear-gradient(to bottom, #f5f1e9 0%, #f5f1e9 58%, #241d19 58%, #241d19 100%);
  isolation: isolate;
}

.floor-plan-gallery-viewport {
  width: 100%;
  overflow: hidden;
}

.floor-plan-gallery-track {
  background-color: whitesmoke;
  display: flex;
  width: max-content;
  animation: floor-plan-marquee 100s linear infinite;
  will-change: transform;
}

.floor-plan-gallery-group {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
}

.floor-plan-gallery-item {
  flex: 0 0 auto;
  box-sizing: border-box;

  width: 100vw;;
  height: 100vh;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 0;
}

.floor-plan-gallery-item img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
}



@keyframes floor-plan-marquee {
  from {
    transform: translate3d(0, 0, 0);
  }

  to {
    transform: translate3d(-50%, 0, 0);
  }
}

@media (max-width: 640px) {
  .floor-plan-gallery-item {
    width: 100vw;
    height: 100vh;
    padding: 0;
  }

  .floor-plan-gallery-track {
    animation-duration: 110s;
  }
}

@media (prefers-reduced-motion: reduce) {
  .floor-plan-gallery-track {
    animation: none;
  }

  .floor-plan-gallery-viewport {
    overflow-x: auto;
  }
}