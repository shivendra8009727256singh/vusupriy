/* VASUPRIY - SLOW HORIZONTAL 3D FLOOR PLAN GALLERY */

.floor-plan-gallery {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #f5f1e9;
  isolation: isolate;
}

.floor-plan-gallery-viewport {
  width: 100%;
  overflow: hidden;
}

.floor-plan-gallery-track {
  background-color: whitesmoke;
  display: flex;
  width: max-content;
  animation: floor-plan-marquee 100s linear infinite;
  will-change: transform;
}

.floor-plan-gallery-group {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
}

.floor-plan-gallery-item {
  flex: 0 0 auto;
  box-sizing: border-box;

  width: 100vw;;
  height: 100vh;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 0;
}

.floor-plan-gallery-item img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
}



@keyframes floor-plan-marquee {
  from {
    transform: translate3d(0, 0, 0);
  }

  to {
    transform: translate3d(-50%, 0, 0);
  }
}

@media (max-width: 640px) {
  .floor-plan-gallery-item {
    width: 100vw;
    height: 100vh;
    padding: 0;
  }

  .floor-plan-gallery-track {
    animation-duration: 110s;
  }
}

@media (prefers-reduced-motion: reduce) {
  .floor-plan-gallery-track {
    animation: none;
  }

  .floor-plan-gallery-viewport {
    overflow-x: auto;
  }
}
/* VASUPRIY REAL 3D FLOOR PLAN OVERLAP */

.floor-plan-gallery {
  --floor-overlap: clamp(120px, 22vh, 240px);

  position: relative;
  z-index: 5;

  margin-bottom: calc(-1 * var(--floor-overlap));

  overflow: visible;
  isolation: auto;
}

.floor-plan-gallery-viewport {
  position: relative;
  overflow: hidden;
  z-index: 2;
}

.floor-plan-gallery-track {
  background: transparent;
}

.floor-plan-gallery-item {
  width: 100vw;
  height: 100vh;
}

.floor-plan-gallery + .home-expertise {
  position: relative;
  z-index: 1;

  padding-top: calc(
    var(--floor-overlap, clamp(120px, 22vh, 240px)) + 70px
  );
}

@media (max-width: 640px) {
  .floor-plan-gallery {
    --floor-overlap: 100px;
  }

  .floor-plan-gallery + .home-expertise {
    padding-top: calc(var(--floor-overlap) + 45px);
  }
}
