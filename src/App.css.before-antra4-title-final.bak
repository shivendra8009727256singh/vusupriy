/* =========================================================
   VASUPRIY INTERIOVILLA
   HOME — HEADER / HERO / INTRO
   ========================================================= */

.site {
  width: 100%;
  background: var(--color-ivory);
}

/* =========================================================
   HEADER
   ========================================================= */

.site-header {
  position: absolute;
  z-index: 50;
  top: 0;
  left: 0;

  width: 100%;

  color: var(--color-white);

  border-bottom: 1px solid rgba(255, 255, 255, 0.18);
}

.header-inner {
  display: grid;
  grid-template-columns: minmax(220px, auto) 1fr auto;
  min-height: 96px;
  align-items: center;
  gap: clamp(28px, 4vw, 64px);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 14px;

  width: fit-content;

  color: var(--color-white);
}

.brand-logo {
  display: block;

  width: 80px;
  height: 80px;

  flex: 0 0 80px;

  object-fit: contain;
}

.brand-name {
  display: flex;
  flex-direction: column;
}

.brand-name strong {
  color: var(--color-white);

  font-family: var(--font-display);
  font-size: 1.18rem;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 0.16em;
}

.brand-name small {
  margin-top: 7px;

  color: var(--color-gold-light);

  font-size: 0.55rem;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 0.32em;
}

.desktop-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(22px, 2.6vw, 42px);
}

.desktop-nav a {
  position: relative;

  padding-block: 35px;

  color: rgba(255, 255, 255, 0.9);

  /* Same typography family used by VASUPRIY wordmark */
  font-family: var(--font-display);
  font-size: 1.08rem;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 0.08em;

  transition:
    color var(--transition-base),
    transform var(--transition-base);
}

.desktop-nav a::after {
  position: absolute;
  bottom: -1px;
  left: 0;

  width: 0;
  height: 2px;

  content: "";

  background: var(--color-gold);

  transition: width var(--transition-base);
}

.desktop-nav a:hover,
.desktop-nav a.active {
  color: var(--color-gold-light);
}

.desktop-nav a:hover {
  transform: translateY(-2px);
}

.desktop-nav a:hover::after,
.desktop-nav a.active::after {
  width: 100%;
}

.header-cta {
  border-radius: 14px;
  display: inline-flex;
  min-height: 48px;
  align-items: center;
  justify-content: center;
  gap: 20px;

  padding: 12px 22px;

  color: var(--color-navy-deep);
  background: var(--color-gold);

  font-size: 0.67rem;
  font-weight: 800;
  letter-spacing: 0.09em;
  text-transform: uppercase;

  transition:
    background var(--transition-base),
    transform var(--transition-base);
}

.header-cta:hover {
  background: var(--color-white);
  transform: translateY(-2px);
}

.menu-button {
  display: none;

  width: 46px;
  height: 46px;

  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 7px;

  padding: 0;

  color: var(--color-white);
  background: transparent;

  cursor: pointer;
}

.menu-button span {
  width: 25px;
  height: 1px;

  background: currentColor;
}

/* =========================================================
   HERO
   ========================================================= */

.hero-section {
  position: relative;

  display: flex;
  min-height: 100svh;
  align-items: flex-end;

  overflow: hidden;

  color: var(--color-white);
  background: var(--color-navy-deep);
}

.hero-media {
  position: absolute;
  z-index: 0;
  inset: 0;
}

.hero-image-shade {
  position: absolute;
  z-index: 1;
  inset: 0;

  background:
    linear-gradient(90deg,
      rgba(4, 18, 30, 0.55) 0%,
      rgba(4, 18, 30, 0.14) 54%,
      rgba(4, 18, 30, 0.05) 100%),
    linear-gradient(0deg,
      rgba(3, 15, 25, 0.62) 0%,
      transparent 48%);
}

.hero-navy-panel {
  position: absolute;
  z-index: 2;
  top: 0;
  bottom: 0;
  left: 0;

  width: 57%;

  background:
    linear-gradient(90deg,
      rgba(5, 24, 39, 0.99) 0%,
      rgba(7, 29, 47, 0.97) 58%,
      rgba(7, 29, 47, 0.77) 82%,
      rgba(7, 29, 47, 0) 100%);
}

.hero-container {
  position: relative;
  z-index: 3;

  display: grid;
  grid-template-columns: minmax(0, 1fr) 240px;
  align-items: end;
  gap: clamp(40px, 5vw, 80px);

  padding-top: 175px;
  padding-bottom: clamp(55px, 7vh, 82px);
}

.hero-content {
  width: 100%;
  max-width: 1050px;
}

.hero-eyebrow {
  display: flex;
  align-items: center;
  gap: 16px;

  margin-bottom: clamp(30px, 4.5vh, 48px);

  color: var(--color-gold-light);

  font-size: 0.67rem;
  font-weight: 800;
  line-height: 1.4;
  letter-spacing: 0.19em;
  text-transform: uppercase;
}

.eyebrow-line {
  width: 44px;
  height: 1px;

  flex-shrink: 0;

  background: currentColor;
}

.hero-title {
  max-width: 940px;

  color: var(--color-white);

  font-size: clamp(4rem, 7.6vw, 8rem);
  line-height: 0.84;
  letter-spacing: -0.058em;

  text-wrap: balance;
}

.hero-title-line--gold {
  color: var(--color-gold-light);
  font-style: italic;
}

.hero-title-line--white {
  color: var(--color-white);
}

.hero-bottom {
  display: flex;
  max-width: 950px;
  align-items: flex-end;
  justify-content: space-between;
  gap: 40px;

  margin-top: clamp(40px, 6vh, 65px);
}

.hero-description {
  display: grid;
  grid-template-columns: auto minmax(0, 410px);
  align-items: start;
  gap: 23px;
}

.hero-year {
  padding-top: 4px;

  color: var(--color-gold);

  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  white-space: nowrap;
}

.hero-description p {
  color: rgba(255, 255, 255, 0.75);

  font-size: 0.89rem;
  line-height: 1.75;
}

.hero-actions {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 25px;
}

.hero-primary-btn {
  display: inline-flex;
  min-height: 58px;
  align-items: center;
  justify-content: space-between;
  gap: 24px;

  padding: 12px 12px 12px 24px;

  color: var(--color-navy-deep);
  background: var(--color-gold);

  font-size: 0.66rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;

  transition:
    background var(--transition-base),
    transform var(--transition-base);
}

.hero-primary-btn:hover {
  background: var(--color-white);
  transform: translateY(-2px);
}

.button-arrow {
  display: grid;
  width: 34px;
  height: 34px;
  place-items: center;

  color: var(--color-white);
  background: var(--color-navy-deep);

  border-radius: 50%;

  font-size: 0.9rem;
}

.hero-text-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;

  padding-block: 9px;

  color: rgba(255, 255, 255, 0.94);

  border-bottom: 1px solid rgba(255, 255, 255, 0.45);

  font-size: 0.66rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;

  white-space: nowrap;
}

.hero-feature {
  position: relative;

  display: flex;
  min-height: 245px;
  flex-direction: column;
  justify-content: space-between;

  margin-bottom: 5px;
  padding: 25px;

  border: 1px solid rgba(223, 197, 150, 0.5);

  background: rgba(7, 29, 47, 0.79);
  backdrop-filter: blur(12px);

  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
}

.feature-top {
  display: flex;
  align-items: center;
  gap: 12px;
}

.feature-number,
.feature-label {
  color: var(--color-gold);

  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.feature-line {
  width: 35px;
  height: 1px;

  background: rgba(201, 166, 107, 0.6);
}

.feature-content {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.hero-feature strong {
  color: var(--color-white);

  font-family: var(--font-display);
  font-size: 1.55rem;
  font-weight: 400;
  line-height: 1.12;
}

.hero-scroll {
  position: absolute;
  right: -48px;
  bottom: 120px;

  display: flex;
  align-items: center;
  gap: 14px;

  color: rgba(255, 255, 255, 0.68);

  font-size: 0.56rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;

  transform: rotate(-90deg);
  transform-origin: center;
}

.scroll-line {
  width: 40px;
  height: 1px;

  background: var(--color-gold);
}

/* =========================================================
   EXPERTISE STRIP
   ========================================================= */

.brand-strip {
  position: relative;
  z-index: 5;

  width: 100%;

  overflow: hidden;

  color: var(--color-navy-deep);
  background: var(--color-gold);
}

/* =========================================================
   ABOUT INTRO
   ========================================================= */

.intro-section {
  position: relative;

  background: var(--color-ivory);
}

.intro-grid {
  display: grid;
  grid-template-columns: minmax(160px, 0.32fr) minmax(0, 1fr);
  gap: clamp(40px, 7vw, 110px);
}

.intro-label {
  padding-top: 13px;
}

.intro-content {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(260px, 0.42fr);
  align-items: end;
  gap: clamp(40px, 6vw, 90px);
}

.intro-content .section-title {
  color: var(--color-navy-deep);
}

.intro-content .section-title em {
  color: var(--color-gold-dark);
  font-weight: 400;
}

.intro-copy {
  padding-bottom: 9px;
}

.intro-copy p {
  margin-bottom: 30px;

  color: var(--color-text);

  font-size: 0.96rem;
}

.intro-copy a {
  display: inline-flex;
  align-items: center;
  gap: 20px;

  padding-bottom: 8px;

  color: var(--color-navy);

  border-bottom: 1px solid rgba(16, 43, 70, 0.4);

  font-size: 0.69rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 1180px) {
  .header-inner {
    gap: 24px;
  }

  .brand-name {
    display: none;
  }

  .header-inner {
    grid-template-columns: auto 1fr auto;
  }

  .desktop-nav {
    gap: 20px;
  }

  .hero-container {
    grid-template-columns: minmax(0, 1fr) 210px;
  }

  .hero-bottom {
    align-items: flex-start;
    flex-direction: column;
    gap: 28px;
  }

  .intro-content {
    grid-template-columns: 1fr;
  }

  .intro-copy {
    max-width: 560px;
  }
}

/* =========================================================
   MOBILE NAV / TABLET HERO
   ========================================================= */

@media (max-width: 960px) {
  .header-inner {
    display: flex;
    min-height: 82px;
    justify-content: space-between;
  }

  .brand-name {
    display: flex;
  }

  .desktop-nav,
  .header-cta {
    display: none;
  }

  .menu-button {
    display: flex;
  }

  .hero-section {
    min-height: 900px;
  }

  .hero-navy-panel {
    width: 82%;
  }

  .hero-container {
    display: block;

    padding-top: 150px;
    padding-bottom: 55px;
  }

  .hero-content {
    max-width: 820px;
  }

  .hero-feature {
    max-width: 290px;
    min-height: 190px;

    margin-top: 50px;
  }

  .hero-scroll {
    display: none;
  }

  .intro-grid {
    grid-template-columns: 1fr;
    gap: 35px;
  }

  .intro-label {
    padding-top: 0;
  }
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 640px) {
  .brand-logo {
    width: 47px;
    height: 47px;

    flex-basis: 47px;
  }

  .brand-name strong {
    font-size: 0.93rem;
  }

  .brand-name small {
    font-size: 0.46rem;
  }

  .hero-section {
    min-height: 940px;
  }

  .hero-image-shade {
    background:
      linear-gradient(90deg,
        rgba(4, 18, 30, 0.66),
        rgba(4, 18, 30, 0.28)),
      linear-gradient(0deg,
        rgba(3, 15, 25, 0.78) 0%,
        rgba(3, 15, 25, 0.3) 70%,
        rgba(3, 15, 25, 0.55) 100%);
  }

  .hero-navy-panel {
    width: 100%;

    background:
      linear-gradient(90deg,
        rgba(5, 24, 39, 0.95) 0%,
        rgba(5, 24, 39, 0.77) 65%,
        rgba(5, 24, 39, 0.4) 100%);
  }

  .hero-container {
    padding-top: 140px;
    padding-bottom: 45px;
  }

  .hero-eyebrow {
    align-items: flex-start;

    margin-bottom: 30px;

    font-size: 0.57rem;
    line-height: 1.55;
  }

  .eyebrow-line {
    width: 28px;

    margin-top: 7px;
  }

  .hero-title {
    font-size: clamp(3.45rem, 17vw, 5.5rem);
  }

  .hero-bottom {
    margin-top: 40px;
  }

  .hero-description {
    grid-template-columns: 1fr;
    gap: 9px;
  }

  .hero-description p {
    max-width: 390px;
  }

  .hero-actions {
    width: 100%;
    align-items: flex-start;
    flex-direction: column;
  }

  .hero-primary-btn {
    width: 100%;
  }

  .hero-feature {
    max-width: 100%;

    margin-top: 38px;
  }

  .intro-content {
    gap: 35px;
  }
}

/* =========================================================
   VASUPRIY PRELOADER
   Inspired by Antra's multi-gutter opening concept
   ========================================================= */

body.is-loading {
  overflow: hidden;
}

.preloader {
  position: fixed;
  z-index: 9999;
  inset: 0;

  display: grid;
  place-items: center;

  overflow: hidden;

  color: #ffffff;
  background: #071d2f;
}

.preloader-panels {
  position: absolute;
  z-index: 1;
  inset: 0;

  display: grid;
  grid-template-columns: repeat(5, 1fr);
}

.preloader-panel {
  position: relative;

  display: block;

  height: 100%;

  background: #071d2f;

  border-right: 1px solid rgba(215, 183, 125, 0.12);

  transform: scaleY(1);
  transform-origin: top;

  transition:
    transform 0.9s cubic-bezier(0.76, 0, 0.24, 1),
    opacity 0.7s ease;
}

.preloader-panel:nth-child(2) {
  transition-delay: 0.06s;
}

.preloader-panel:nth-child(3) {
  transition-delay: 0.12s;
}

.preloader-panel:nth-child(4) {
  transition-delay: 0.18s;
}

.preloader-panel:nth-child(5) {
  transition-delay: 0.24s;
}

/* ---------------------------------------------------------
   BRAND
   --------------------------------------------------------- */

.preloader-brand {
  position: relative;
  z-index: 3;

  display: flex;
  align-items: center;
  flex-direction: column;

  text-align: center;
}

.preloader-logo-wrap {
  display: grid;

  width: 300px;
  height: 300px;

  place-items: center;

  margin-bottom: 24px;

  opacity: 0;

  transform: scale(0.72) rotate(-8deg);

  animation:
    loaderLogoIn 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
}

.preloader-logo {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: contain;
}

.preloader-wordmark {
  display: flex;
  align-items: center;
  flex-direction: column;

  overflow: hidden;
}

.preloader-wordmark span {
  display: block;

  color: #ffffff;

  font-family: var(--font-display);
  font-size: clamp(2.1rem, 5vw, 4.8rem);
  font-weight: 400;
  line-height: 0.95;
  letter-spacing: 0.16em;

  opacity: 0;

  transform: translateY(110%);

  animation:
    loaderTextIn 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.4s forwards;
}

.preloader-wordmark small {
  display: block;

  margin-top: 13px;

  color: var(--color-gold);

  font-size: clamp(0.58rem, 1vw, 0.76rem);
  font-weight: 800;
  letter-spacing: 0.48em;

  opacity: 0;

  transform: translateY(18px);

  animation:
    loaderFadeUp 0.7s ease 0.75s forwards;
}

.preloader-progress {
  position: relative;

  width: min(290px, 60vw);
  height: 1px;

  margin-top: 35px;

  overflow: hidden;

  background: rgba(255, 255, 255, 0.17);

  opacity: 0;

  animation: loaderOpacity 0.3s ease 0.85s forwards;
}

.preloader-progress span {
  position: absolute;
  inset: 0 auto 0 0;

  width: 100%;

  background: var(--color-gold);

  transform: scaleX(0);
  transform-origin: left;

  animation:
    loaderProgress 1.15s cubic-bezier(0.65, 0, 0.35, 1) 0.9s forwards;
}

.preloader-brand p {
  margin-top: 17px;

  color: rgba(255, 255, 255, 0.46);

  font-size: 0.58rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;

  opacity: 0;

  animation: loaderFadeUp 0.65s ease 1s forwards;
}

/* ---------------------------------------------------------
   CORNER DETAILS
   --------------------------------------------------------- */

.preloader-index {
  position: absolute;
  z-index: 3;
  bottom: 35px;

  color: rgba(215, 183, 125, 0.66);

  font-size: 0.54rem;
  font-weight: 800;
  letter-spacing: 0.18em;

  opacity: 0;

  animation: loaderOpacity 0.6s ease 1.15s forwards;
}

.preloader-index--left {
  left: clamp(24px, 4vw, 70px);
}

.preloader-index--right {
  right: clamp(24px, 4vw, 70px);
}

/* ---------------------------------------------------------
   PRELOADER EXIT
   --------------------------------------------------------- */

.preloader--leaving {
  pointer-events: none;
}

.preloader--leaving .preloader-brand {
  opacity: 0;

  transform: translateY(-25px);

  transition:
    opacity 0.35s ease,
    transform 0.5s cubic-bezier(0.76, 0, 0.24, 1);
}

.preloader--leaving .preloader-index {
  opacity: 0;

  transition: opacity 0.25s ease;
}

.preloader--leaving .preloader-panel {
  transform: scaleY(0);
}

.preloader--leaving .preloader-panel:nth-child(even) {
  transform-origin: bottom;
}

/* =========================================================
   KEYFRAMES
   ========================================================= */

@keyframes loaderLogoIn {
  from {
    opacity: 0;
    transform: scale(0.72) rotate(-8deg);
  }

  to {
    opacity: 1;
    transform: scale(1) rotate(0);
  }
}

@keyframes loaderTextIn {
  from {
    opacity: 0;
    transform: translateY(110%);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes loaderFadeUp {
  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes loaderOpacity {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes loaderProgress {
  from {
    transform: scaleX(0);
  }

  to {
    transform: scaleX(1);
  }
}

@keyframes headerReveal {
  from {
    opacity: 0;
    transform: translateY(-30px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* =========================================================
   MOBILE PRELOADER
   ========================================================= */

@media (max-width: 640px) {
  .preloader-panels {
    grid-template-columns: repeat(3, 1fr);
  }

  .preloader-panel:nth-child(4),
  .preloader-panel:nth-child(5) {
    display: none;
  }

  .preloader-logo-wrap {
    width: 76px;
    height: 76px;

    margin-bottom: 20px;
  }

  .preloader-wordmark span {
    font-size: clamp(2rem, 12vw, 3.2rem);
    letter-spacing: 0.1em;
  }

  .preloader-wordmark small {
    letter-spacing: 0.35em;
  }

  .preloader-index--right {
    display: none;
  }
}

/* =========================================================
   ACCESSIBILITY — REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  .preloader-logo-wrap,
  .preloader-wordmark span,
  .preloader-wordmark small,
  .preloader-progress,
  .preloader-progress span,
  .preloader-brand p,
  .preloader-index,
  .site-header .header-inner,
  .hero-media img,
  .hero-eyebrow,
  .hero-title-line,
  .hero-bottom,
  .hero-feature {
    animation-duration: 0.01ms !important;
    animation-delay: 0ms !important;
  }

  .preloader-panel {
    transition-duration: 0.01ms !important;
  }
}

/* =========================================================
   VASUPRIY FOOTER
   ========================================================= */

.site-footer {
  position: relative;

  overflow: hidden;

  color: rgba(255, 255, 255, 0.72);
  background: var(--color-navy-deep);
}

/* =========================================================
   LARGE CTA
   ========================================================= */

.footer-top {
  position: relative;

  padding-block: clamp(80px, 10vw, 145px);

  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
}

.footer-top::before {
  position: absolute;
  top: -220px;
  right: -100px;

  width: 550px;
  height: 550px;

  content: "";

  border: 1px solid rgba(201, 166, 107, 0.12);
  border-radius: 50%;
}

.footer-top::after {
  position: absolute;
  right: 120px;
  bottom: -310px;

  width: 500px;
  height: 500px;

  content: "";

  border: 1px solid rgba(201, 166, 107, 0.08);
  border-radius: 50%;
}

.footer-cta {
  position: relative;
  z-index: 2;
}

.footer-cta-label {
  display: flex;
  align-items: center;
  gap: 15px;

  margin-bottom: clamp(28px, 4vw, 48px);

  color: var(--color-gold);

  font-size: 0.65rem;
  font-weight: 800;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.footer-label-line {
  display: block;

  width: 42px;
  height: 1px;

  background: currentColor;
}

.footer-big-link {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 40px;

  color: var(--color-white);
}

.footer-big-link > span:first-child {
  font-family: var(--font-display);
  font-size: clamp(3.5rem, 7.2vw, 7.8rem);
  font-weight: 400;
  line-height: 0.91;
  letter-spacing: -0.055em;
}

.footer-big-link em {
  color: var(--color-gold-light);

  font-weight: 400;
}

.footer-circle-arrow {
  display: grid;

  width: clamp(85px, 10vw, 140px);
  height: clamp(85px, 10vw, 140px);

  flex: 0 0 auto;
  place-items: center;

  color: var(--color-navy-deep);
  background: var(--color-gold);

  border-radius: 50%;

  font-family: var(--font-display);
  font-size: clamp(1.8rem, 3vw, 3rem);

  transform: rotate(0deg);

  transition:
    color 0.5s cubic-bezier(0.16, 1, 0.3, 1),
    background 0.5s cubic-bezier(0.16, 1, 0.3, 1),
    transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.footer-big-link:hover .footer-circle-arrow {
  color: var(--color-navy-deep);
  background: var(--color-white);

  transform: rotate(45deg);
}

/* =========================================================
   MAIN FOOTER
   ========================================================= */

.footer-main {
  padding-block: clamp(65px, 8vw, 105px);
}

.footer-grid {
  display: grid;
  grid-template-columns:
    minmax(280px, 1.4fr)
    minmax(150px, 0.7fr)
    minmax(210px, 0.9fr)
    minmax(240px, 0.9fr);

  gap: clamp(40px, 6vw, 90px);
}

.footer-brand {
  max-width: 350px;
}

.footer-logo-link {
  display: inline-flex;
  align-items: center;
  gap: 15px;

  margin-bottom: 30px;
}

.footer-logo {
  width: 64px;
  height: 64px;

  object-fit: contain;
}

.footer-wordmark {
  display: flex;
  flex-direction: column;
}

.footer-wordmark strong {
  color: var(--color-white);

  font-family: var(--font-display);
  font-size: 1.28rem;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 0.16em;
}

.footer-wordmark small {
  margin-top: 8px;

  color: var(--color-gold);

  font-size: 0.55rem;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 0.34em;
}

.footer-brand p {
  max-width: 320px;

  margin-bottom: 25px;

  color: rgba(255, 255, 255, 0.56);

  font-size: 0.88rem;
  line-height: 1.85;
}

.footer-since {
  color: var(--color-gold);

  font-size: 0.57rem;
  font-weight: 800;
  letter-spacing: 0.18em;
}

.footer-heading {
  display: block;

  margin-bottom: 30px;

  color: var(--color-gold);

  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.19em;
  text-transform: uppercase;
}

/* =========================================================
   LINKS
   ========================================================= */

.footer-links {
  display: flex;
  flex-direction: column;
}

.footer-links a {
  display: flex;
  align-items: center;
  gap: 13px;

  width: fit-content;

  padding-block: 7px;

  color: rgba(255, 255, 255, 0.78);

  font-family: var(--font-display);
  font-size: 1.05rem;

  transition:
    color var(--transition-base),
    transform var(--transition-base);
}

.footer-links a span {
  color: rgba(201, 166, 107, 0.55);

  font-family: var(--font-body);
  font-size: 0.48rem;
  font-weight: 700;
}

.footer-links a:hover {
  color: var(--color-gold-light);

  transform: translateX(6px);
}

/* =========================================================
   SERVICES
   ========================================================= */

.footer-service-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.footer-service-list span {
  color: rgba(255, 255, 255, 0.62);

  font-size: 0.8rem;
  line-height: 1.55;
}

/* =========================================================
   CONNECT
   ========================================================= */

.footer-connect p {
  max-width: 280px;

  margin-bottom: 27px;

  color: rgba(255, 255, 255, 0.57);

  font-size: 0.84rem;
  line-height: 1.75;
}

.footer-consultation {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  gap: 20px;

  padding-block: 14px;

  color: var(--color-white);

  border-top: 1px solid rgba(255, 255, 255, 0.17);
  border-bottom: 1px solid rgba(255, 255, 255, 0.17);

  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.09em;
  text-transform: uppercase;

  transition:
    color var(--transition-base),
    border-color var(--transition-base);
}

.footer-consultation:hover {
  color: var(--color-gold);

  border-color: rgba(201, 166, 107, 0.65);
}

.footer-socials {
  display: flex;
  gap: 10px;

  margin-top: 28px;
}

.footer-socials a {
  display: grid;

  width: 40px;
  height: 40px;

  place-items: center;

  color: rgba(255, 255, 255, 0.72);

  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 50%;

  font-size: 0.57rem;
  font-weight: 800;
  letter-spacing: 0.06em;

  transition:
    color var(--transition-base),
    background var(--transition-base),
    border-color var(--transition-base),
    transform var(--transition-base);
}

.footer-socials a:hover {
  color: var(--color-navy-deep);
  background: var(--color-gold);
  border-color: var(--color-gold);

  transform: translateY(-4px);
}

/* =========================================================
   BOTTOM BAR
   ========================================================= */

.footer-bottom {
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.footer-bottom-inner {
  display: flex;
  min-height: 76px;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
}

.footer-bottom p {
  color: rgba(255, 255, 255, 0.38);

  font-size: 0.68rem;
  letter-spacing: 0.04em;
}

.back-to-top {
  display: inline-flex;
  align-items: center;
  gap: 14px;

  padding: 10px 0;

  color: rgba(255, 255, 255, 0.7);
  background: transparent;

  font-size: 0.61rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;

  cursor: pointer;

  transition: color var(--transition-base);
}

.back-to-top span:last-child {
  color: var(--color-gold);

  font-size: 1rem;

  transition: transform var(--transition-base);
}

.back-to-top:hover {
  color: var(--color-white);
}

.back-to-top:hover span:last-child {
  transform: translateY(-4px);
}

/* =========================================================
   FOOTER RESPONSIVE
   ========================================================= */

@media (max-width: 1050px) {
  .footer-grid {
    grid-template-columns: 1.2fr 0.8fr 1fr;
  }

  .footer-connect {
    grid-column: 1 / -1;

    max-width: 500px;
  }
}

@media (max-width: 720px) {
  .footer-big-link {
    align-items: flex-start;
    flex-direction: column;
  }

  .footer-circle-arrow {
    width: 82px;
    height: 82px;
  }

  .footer-grid {
    grid-template-columns: 1fr 1fr;
  }

  .footer-brand,
  .footer-connect {
    grid-column: 1 / -1;
  }
}

@media (max-width: 480px) {
  .footer-top {
    padding-block: 75px;
  }

  .footer-big-link > span:first-child {
    font-size: clamp(3rem, 15vw, 4.4rem);
  }

  .footer-grid {
    grid-template-columns: 1fr;
  }

  .footer-brand,
  .footer-connect {
    grid-column: auto;
  }

  .footer-main {
    padding-block: 60px;
  }

  .footer-bottom-inner {
    min-height: 100px;
    align-items: flex-start;
    justify-content: center;
    flex-direction: column;

    padding-block: 22px;
  }
}

/* =========================================================
   PREMIUM FLOATING GLASS HEADER
   ========================================================= */

.site-header {
  position: fixed;
  z-index: 1000;
  top: 16px;
  left: 0;

  width: 100%;

  border: 0;

  pointer-events: none;

  transition:
    top 0.55s cubic-bezier(0.16, 1, 0.3, 1),
    padding 0.55s cubic-bezier(0.16, 1, 0.3, 1);
}

.site-header .header-inner {
  position: relative;

  min-height: 86px;

  padding: 0 18px 0 20px;

  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 3px;

  background:
    linear-gradient(
      105deg,
      rgba(5, 25, 41, 0.92) 0%,
      rgba(7, 29, 47, 0.78) 48%,
      rgba(7, 29, 47, 0.62) 100%
    );

  box-shadow:
    0 16px 50px rgba(0, 0, 0, 0.13),
    inset 0 1px 0 rgba(255, 255, 255, 0.06);

  backdrop-filter: blur(18px) saturate(130%);
  -webkit-backdrop-filter: blur(18px) saturate(130%);

  pointer-events: auto;

  transition:
    min-height 0.55s cubic-bezier(0.16, 1, 0.3, 1),
    max-width 0.55s cubic-bezier(0.16, 1, 0.3, 1),
    padding 0.55s cubic-bezier(0.16, 1, 0.3, 1),
    border-radius 0.55s cubic-bezier(0.16, 1, 0.3, 1),
    background 0.4s ease,
    box-shadow 0.4s ease;
}

/* Fine gold architectural line */

.site-header .header-inner::before {
  position: absolute;
  top: -1px;
  left: 20px;

  width: 92px;
  height: 1px;

  content: "";

  background:
    linear-gradient(
      90deg,
      transparent,
      var(--color-gold),
      transparent
    );

  opacity: 0.9;
}

/* =========================================================
   LOGO AREA
   ========================================================= */

.site-header .brand {
  position: relative;

  gap: 14px;

  padding-right: 24px;
}

.site-header .brand::after {
  position: absolute;
  top: 50%;
  right: 0;

  width: 1px;
  height: 35px;

  content: "";

  background:
    linear-gradient(
      to bottom,
      transparent,
      rgba(215, 183, 125, 0.55),
      transparent
    );

  transform: translateY(-50%);
}

.site-header .brand-logo {
  transition:
    width 0.55s cubic-bezier(0.16, 1, 0.3, 1),
    height 0.55s cubic-bezier(0.16, 1, 0.3, 1),
    transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
}

.site-header .brand:hover .brand-logo {
  transform: scale(1.06);
}

.site-header .brand-name strong {
  font-family: var(--font-display);
  letter-spacing: 0.16em;
}

.site-header .brand-name small {
  color: var(--color-gold);
}

/* =========================================================
   NAVIGATION
   ========================================================= */

.site-header .desktop-nav {
  gap: clamp(20px, 2.25vw, 38px);
}

.site-header .desktop-nav a {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 34px 0;

  color: rgba(255, 255, 255, 0.83);

  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 0.055em;

  transition:
    color 0.35s ease,
    transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
    padding 0.55s cubic-bezier(0.16, 1, 0.3, 1);
}

/*
  Remove previous conventional underline.
*/

.site-header .desktop-nav a::after {
  bottom: 19px;
  left: 50%;

  width: 0;
  height: 1px;

  background: var(--color-gold);

  transform: translateX(-50%);

  transition:
    width 0.4s cubic-bezier(0.16, 1, 0.3, 1),
    bottom 0.55s cubic-bezier(0.16, 1, 0.3, 1);
}

/*
  Gold navigation dot.
*/

.site-header .desktop-nav a::before {
  position: absolute;
  bottom: 15px;
  left: 50%;

  width: 4px;
  height: 4px;

  content: "";

  background: var(--color-gold);
  border-radius: 50%;

  opacity: 0;

  transform:
    translateX(-50%)
    translateY(6px)
    scale(0);

  transition:
    opacity 0.3s ease,
    transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
    bottom 0.55s cubic-bezier(0.16, 1, 0.3, 1);
}

.site-header .desktop-nav a:hover,
.site-header .desktop-nav a.active {
  color: var(--color-gold-light);

  transform: translateY(-2px);
}

.site-header .desktop-nav a:hover::after {
  width: 100%;
}

.site-header .desktop-nav a.active::after {
  width: 28px;
}

.site-header .desktop-nav a:hover::before,
.site-header .desktop-nav a.active::before {
  opacity: 1;

  transform:
    translateX(-50%)
    translateY(0)
    scale(1);
}

/* =========================================================
   CONSULTATION CTA
   ========================================================= */

.site-header .header-cta {
  position: relative;

  min-height: 50px;

  gap: 22px;

  overflow: hidden;

  padding: 10px 13px 10px 23px;

  border: 1px solid var(--color-gold);

  background: var(--color-gold);

  transition:
    color 0.4s ease,
    background 0.4s ease,
    transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
    box-shadow 0.4s ease;
}

.site-header .header-cta::before {
  position: absolute;
  inset: 0;

  content: "";

  background: var(--color-navy-deep);

  transform: translateX(-102%);

  transition:
    transform 0.55s cubic-bezier(0.76, 0, 0.24, 1);
}

.site-header .header-cta span {
  position: relative;
  z-index: 2;
}

.site-header .header-cta span:last-child {
  display: grid;

  width: 30px;
  height: 30px;

  place-items: center;

  color: var(--color-white);
  background: var(--color-navy-deep);

  border-radius: 50%;

  transition:
    color 0.4s ease,
    background 0.4s ease,
    transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
}

.site-header .header-cta:hover {
  color: var(--color-white);
  background: var(--color-gold);

  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.16);

  transform: translateY(-2px);
}

.site-header .header-cta:hover::before {
  transform: translateX(0);
}

.site-header .header-cta:hover span:last-child {
  color: var(--color-navy-deep);
  background: var(--color-gold);

  transform: rotate(45deg);
}

/* =========================================================
   SCROLLED — COMPACT STICKY MODE
   ========================================================= */

.site-header--scrolled {
  top: 8px;
}

.site-header--scrolled .header-inner {
  min-height: 68px;

  padding-right: 10px;
  padding-left: 15px;

  border-color: rgba(215, 183, 125, 0.22);
  border-radius: 4px;

  background: rgba(5, 24, 39, 0.93);

  box-shadow:
    0 15px 45px rgba(0, 0, 0, 0.2),
    inset 0 1px 0 rgba(255, 255, 255, 0.06);

  backdrop-filter: blur(24px) saturate(145%);
  -webkit-backdrop-filter: blur(24px) saturate(145%);
}

.site-header--scrolled .brand-logo {
  width: 47px;
  height: 47px;

  flex-basis: 47px;
}

.site-header--scrolled .brand-name strong {
  font-size: 1rem;
}

.site-header--scrolled .brand-name small {
  margin-top: 5px;

  font-size: 0.48rem;
}

.site-header--scrolled .desktop-nav a {
  padding-block: 25px;

  font-size: 0.94rem;
}

.site-header--scrolled .desktop-nav a::after {
  bottom: 12px;
}

.site-header--scrolled .desktop-nav a::before {
  bottom: 8px;
}

.site-header--scrolled .header-cta {
  min-height: 44px;
}

.site-header--scrolled .header-cta span:last-child {
  width: 27px;
  height: 27px;
}

/* =========================================================
   HEADER LOAD ANIMATION — INDIVIDUAL ELEMENTS
   ========================================================= */

.site--ready .desktop-nav a {
  animation:
    premiumNavReveal 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.site--ready .desktop-nav a:nth-child(1) {
  animation-delay: 0.42s;
}

.site--ready .desktop-nav a:nth-child(2) {
  animation-delay: 0.49s;
}

.site--ready .desktop-nav a:nth-child(3) {
  animation-delay: 0.56s;
}

.site--ready .desktop-nav a:nth-child(4) {
  animation-delay: 0.63s;
}

.site--ready .desktop-nav a:nth-child(5) {
  animation-delay: 0.7s;
}

.site--ready .desktop-nav a:nth-child(6) {
  animation-delay: 0.77s;
}

@keyframes premiumNavReveal {
  from {
    opacity: 0;

    transform: translateY(-15px);
  }

  to {
    opacity: 1;

    transform: translateY(0);
  }
}

/* =========================================================
   HEADER RESPONSIVE
   ========================================================= */

@media (max-width: 1180px) {
  .site-header .header-inner {
    min-height: 78px;
  }

  .site-header .brand {
    padding-right: 16px;
  }

  .site-header .brand::after {
    display: none;
  }

  .site-header .desktop-nav {
    gap: 19px;
  }

  .site-header .desktop-nav a {
    padding-block: 29px;

    font-size: 0.92rem;
  }

  .site-header .header-cta {
    padding-left: 17px;
  }
}

@media (max-width: 960px) {
  .site-header {
    top: 10px;
  }

  .site-header .header-inner {
    min-height: 70px;

    padding: 8px 12px 8px 14px;

    border-radius: 3px;
  }

  .site-header--scrolled {
    top: 6px;
  }

  .site-header--scrolled .header-inner {
    min-height: 62px;
  }

  .site-header .brand {
    padding-right: 0;
  }

  .site-header .menu-button {
    display: flex;

    border: 1px solid rgba(215, 183, 125, 0.4);
    border-radius: 50%;

    transition:
      background 0.3s ease,
      border-color 0.3s ease;
  }

  .site-header .menu-button:hover {
    background: rgba(215, 183, 125, 0.12);
    border-color: var(--color-gold);
  }
}

@media (max-width: 640px) {
  .site-header {
    top: 7px;
  }

  .site-header .header-inner {
    min-height: 64px;

    padding: 7px 10px;
  }

  .site-header .brand-logo {
    width: 43px;
    height: 43px;

    flex-basis: 43px;
  }

  .site-header .brand-name strong {
    font-size: 0.85rem;

    letter-spacing: 0.13em;
  }

  .site-header .brand-name small {
    margin-top: 5px;

    font-size: 0.42rem;
    letter-spacing: 0.27em;
  }

  .site-header .menu-button {
    width: 42px;
    height: 42px;
  }
}

/* =========================================================
   EXTENDED HEADER NAVIGATION
   ========================================================= */

.site-header .desktop-nav {
  gap: clamp(15px, 1.55vw, 27px);
}

.site-header .desktop-nav a {
  font-size: 0.92rem;
  letter-spacing: 0.035em;
  white-space: nowrap;
}

@media (max-width: 1240px) {
  .site-header .desktop-nav {
    gap: 15px;
  }

  .site-header .desktop-nav a {
    font-size: 0.84rem;
  }

  .site-header .brand-name {
    display: none;
  }
}
/* =========================================================
   SHARED RESPONSIVE MOBILE NAVIGATION
   ========================================================= */

body.menu-open {
  overflow: hidden;
}

.mobile-menu {
  position: fixed;
  inset: 0;
  z-index: 9000;
  visibility: hidden;
  pointer-events: none;
}

.mobile-menu-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(2, 15, 25, 0.66);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  opacity: 0;
  transition: opacity 0.45s ease;
}

.mobile-menu-panel {
  position: absolute;
  top: 0;
  right: 0;

  display: flex;
  flex-direction: column;

  width: min(100%, 520px);
  height: 100%;
  min-height: 100dvh;

  padding:
    clamp(100px, 13vh, 130px)
    clamp(28px, 6vw, 54px)
    34px;

  overflow-y: auto;
  overflow-x: hidden;

  color: var(--color-white);

  background:
    radial-gradient(
      circle at 85% 12%,
      rgba(215, 183, 125, 0.12),
      transparent 30%
    ),
    var(--color-navy-deep);

  transform: translateX(105%);

  transition:
    transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
}

.mobile-menu--open {
  visibility: visible;
  pointer-events: auto;
}

.mobile-menu--open .mobile-menu-backdrop {
  opacity: 1;
}

.mobile-menu--open .mobile-menu-panel {
  transform: translateX(0);
}

.mobile-menu-decoration {
  position: absolute;
  top: 16%;
  right: -20px;

  pointer-events: none;
  opacity: 0.035;
}

.mobile-menu-decoration span {
  font-family: var(--font-display);
  font-size: clamp(5rem, 20vw, 10rem);
  line-height: 0.8;
  letter-spacing: -0.06em;
  white-space: nowrap;
}

.mobile-menu-top {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding-bottom: 20px;

  border-bottom: 1px solid rgba(215, 183, 125, 0.2);
}

.mobile-menu-label,
.mobile-menu-index {
  color: var(--color-gold-light);

  font-size: 0.7rem;
  font-weight: 600;

  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.mobile-navigation {
  display: flex;
  flex-direction: column;
  margin-top: 12px;
}

.mobile-navigation a {
  position: relative;

  display: grid;
  grid-template-columns: 36px 1fr auto;
  gap: 12px;
  align-items: center;

  min-height: 65px;

  color: rgba(255, 255, 255, 0.76);

  border-bottom: 1px solid rgba(255, 255, 255, 0.08);

  text-decoration: none;

  opacity: 0;
  transform: translateX(30px);

  transition:
    color 0.3s ease,
    border-color 0.3s ease,
    padding-left 0.35s ease;
}

.mobile-menu--open .mobile-navigation a {
  animation:
    mobileNavReveal
    0.65s
    cubic-bezier(0.16, 1, 0.3, 1)
    forwards;
}

.mobile-menu--open .mobile-navigation a:nth-child(1) {
  animation-delay: 0.08s;
}

.mobile-menu--open .mobile-navigation a:nth-child(2) {
  animation-delay: 0.12s;
}

.mobile-menu--open .mobile-navigation a:nth-child(3) {
  animation-delay: 0.16s;
}

.mobile-menu--open .mobile-navigation a:nth-child(4) {
  animation-delay: 0.20s;
}

.mobile-menu--open .mobile-navigation a:nth-child(5) {
  animation-delay: 0.24s;
}

.mobile-menu--open .mobile-navigation a:nth-child(6) {
  animation-delay: 0.28s;
}

.mobile-menu--open .mobile-navigation a:nth-child(7) {
  animation-delay: 0.32s;
}

.mobile-menu--open .mobile-navigation a:nth-child(8) {
  animation-delay: 0.36s;
}

.mobile-navigation a:hover,
.mobile-navigation a.active {
  color: var(--color-gold-light);
  border-color: rgba(215, 183, 125, 0.35);
  padding-left: 8px;
}

.mobile-nav-number {
  color: rgba(215, 183, 125, 0.58);

  font-size: 0.66rem;
  letter-spacing: 0.12em;
}

.mobile-nav-label {
  font-family: var(--font-display);
  font-size: clamp(1.3rem, 5vw, 1.8rem);
  line-height: 1;
}

.mobile-nav-arrow {
  color: var(--color-gold);
  font-size: 1rem;

  opacity: 0;
  transform: translate(-8px, 8px);

  transition:
    opacity 0.3s ease,
    transform 0.3s ease;
}

.mobile-navigation a:hover .mobile-nav-arrow,
.mobile-navigation a.active .mobile-nav-arrow {
  opacity: 1;
  transform: translate(0, 0);
}

.mobile-menu-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;

  margin-top: auto;
  padding-top: 28px;
}

.mobile-menu-bottom p {
  margin: 0;

  color: rgba(255, 255, 255, 0.48);

  font-size: 0.75rem;
  line-height: 1.7;

  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.mobile-consultation {
  display: inline-flex;
  align-items: center;
  gap: 12px;

  color: var(--color-gold-light);

  font-size: 0.75rem;
  font-weight: 600;

  letter-spacing: 0.1em;
  text-decoration: none;
  text-transform: uppercase;
}

.mobile-consultation span {
  transition: transform 0.3s ease;
}

.mobile-consultation:hover span {
  transform: translate(3px, -3px);
}

/* Hamburger animation */

.menu-button {
  position: relative;
  z-index: 9100;
}

.menu-button span {
  transform-origin: center;

  transition:
    transform 0.35s ease,
    width 0.35s ease;
}

.menu-button--active span:first-child {
  transform: translateY(3px) rotate(45deg);
}

.menu-button--active span:last-child {
  transform: translateY(-3px) rotate(-45deg);
}

/* =========================================================
   RESPONSIVE HEADER
   ========================================================= */

@media (min-width: 1101px) {
  .mobile-menu {
    display: none;
  }
}

@media (max-width: 1100px) {
  .desktop-nav,
  .header-cta {
    display: none !important;
  }

  .menu-button {
    display: flex !important;
  }
}

@media (max-width: 640px) {
  .mobile-menu-panel {
    width: 100%;

    padding:
      92px
      22px
      24px;
  }

  .mobile-navigation a {
    grid-template-columns: 30px 1fr auto;
    min-height: 58px;
  }

  .mobile-nav-label {
    font-size: clamp(1.2rem, 6vw, 1.55rem);
  }

  .mobile-menu-bottom {
    align-items: flex-start;
    flex-direction: column;
    gap: 16px;
  }

  .mobile-menu-bottom p {
    display: none;
  }
}

@media (max-height: 700px) and (max-width: 1100px) {
  .mobile-menu-panel {
    padding-top: 82px;
  }

  .mobile-navigation a {
    min-height: 50px;
  }

  .mobile-menu-bottom {
    padding-top: 18px;
  }
}

@keyframes mobileNavReveal {
  from {
    opacity: 0;
    transform: translateX(30px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .mobile-menu-panel,
  .mobile-menu-backdrop,
  .mobile-navigation a,
  .mobile-nav-arrow,
  .menu-button span {
    animation: none !important;
    transition-duration: 0.01ms !important;
  }

  .mobile-menu--open .mobile-navigation a {
    opacity: 1;
    transform: none;
  }
}

/* =========================================================
   MOBILE NAVIGATION - SMALL SCREEN FIT FIX
   ========================================================= */

@media (max-width: 640px) {
  .mobile-menu-panel {
    padding: 84px 20px 20px;
  }

  .mobile-menu-top {
    padding-bottom: 12px;
  }

  .mobile-navigation {
    margin-top: 4px;
  }

  .mobile-navigation a {
    min-height: 45px;
    grid-template-columns: 28px 1fr auto;
    gap: 10px;
  }

  .mobile-nav-number {
    font-size: 0.58rem;
  }

  .mobile-nav-label {
    font-size: clamp(1.05rem, 5.2vw, 1.35rem);
  }

  .mobile-menu-bottom {
    margin-top: 14px;
    padding-top: 12px;
  }

  .mobile-consultation {
    font-size: 0.67rem;
    line-height: 1.4;
  }
}

@media (max-width: 640px) and (max-height: 720px) {
  .mobile-menu-panel {
    padding-top: 72px;
    padding-bottom: 14px;
  }

  .mobile-menu-top {
    padding-bottom: 8px;
  }

  .mobile-menu-label,
  .mobile-menu-index {
    font-size: 0.58rem;
  }

  .mobile-navigation {
    margin-top: 2px;
  }

  .mobile-navigation a {
    min-height: 40px;
  }

  .mobile-nav-label {
    font-size: 1.05rem;
  }

  .mobile-menu-bottom {
    margin-top: 8px;
    padding-top: 8px;
  }
}

/* Keep hamburger/close control visible above mobile drawer */

@media (max-width: 1100px) {
  .site-header {
    z-index: 9200;
  }

  .menu-button {
    position: relative;
    z-index: 9300;
  }
}

/* =========================================================
   SHARED SITE LAYOUT - HEADER REVEAL
   Header now lives outside Home's .site--ready wrapper.
   ========================================================= */

.site-header .header-inner {
  animation:
    headerReveal 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.35s forwards;
}


/* =========================================================
   FEATURED PROJECTS
   Antra-inspired editorial showcase / Vasupriy theme
   ========================================================= */

.featured-projects {
  position: relative;
  overflow: clip;
  background:
    radial-gradient(circle at 92% 8%, rgba(215, 183, 125, 0.12), transparent 28%),
    var(--color-ivory);
  color: var(--color-navy);
}

.featured-projects::before {
  content: "";
  position: absolute;
  top: 0;
  left: var(--page-padding);
  right: var(--page-padding);
  height: 1px;
  background: rgba(14, 41, 67, 0.14);
}

.projects-heading-row {
  display: grid;
  grid-template-columns: minmax(180px, 0.72fr) minmax(0, 2fr);
  gap: clamp(40px, 7vw, 120px);
  align-items: start;
  margin-bottom: clamp(54px, 7vw, 100px);
}

.projects-heading-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 24px;
}

.projects-heading-meta .section-label {
  color: var(--color-gold-dark);
}

.projects-count {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: rgba(14, 41, 67, 0.48);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.projects-heading-copy {
  max-width: 940px;
}

.projects-title {
  margin: 0;
  color: var(--color-navy);
  font-size: clamp(3rem, 5.4vw, 6.5rem);
  font-weight: 400;
  line-height: 0.91;
  letter-spacing: -0.055em;
}

.projects-title em {
  color: var(--color-gold-dark);
  font-weight: 400;
}

.projects-heading-copy > p {
  max-width: 630px;
  margin: clamp(28px, 3vw, 42px) 0 0;
  color: rgba(41, 41, 41, 0.68);
  font-size: clamp(0.95rem, 1.15vw, 1.08rem);
  line-height: 1.8;
}

/* Main editorial layout */

.projects-showcase {
  display: grid;
  grid-template-columns: minmax(0, 1.38fr) minmax(330px, 0.62fr);
  gap: clamp(36px, 5vw, 80px);
  align-items: start;
}

.projects-visual {
  position: sticky;
  top: 118px;
  min-width: 0;
}

.projects-visual-frame {
  position: relative;
  overflow: hidden;
  min-height: clamp(500px, 62vw, 780px);
  background: var(--color-navy-deep);
  isolation: isolate;
}

.projects-visual-frame::before {
  content: "";
  position: absolute;
  inset: 18px;
  z-index: 3;
  border: 1px solid rgba(255, 255, 255, 0.22);
  pointer-events: none;
}

.projects-visual-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    linear-gradient(
      180deg,
      rgba(5, 18, 30, 0.02) 35%,
      rgba(5, 18, 30, 0.66) 100%
    );
  pointer-events: none;
}

.projects-visual-caption {
  position: absolute;
  z-index: 4;
  left: clamp(30px, 4vw, 58px);
  right: clamp(30px, 4vw, 58px);
  bottom: clamp(30px, 4vw, 50px);
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  color: var(--color-white);
  pointer-events: none;
}

.projects-visual-caption span:first-child {
  font-family: var(--font-display);
  font-size: clamp(1.1rem, 1.7vw, 1.65rem);
}

.projects-visual-caption span:last-child {
  color: rgba(255, 255, 255, 0.68);
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-align: right;
  text-transform: uppercase;
}

/* Project rows */

.projects-list {
  min-width: 0;
}

.project-row {
  position: relative;
  display: grid;
  grid-template-columns: 52px minmax(0, 1fr) 38px;
  gap: clamp(18px, 2vw, 28px);
  align-items: start;
  min-height: clamp(235px, 24vw, 310px);
  padding: clamp(34px, 4vw, 52px) 0;
  border-top: 1px solid rgba(14, 41, 67, 0.16);
  transition:
    padding-left 0.45s cubic-bezier(0.16, 1, 0.3, 1),
    border-color 0.35s ease;
}

.project-row:last-child {
  border-bottom: 1px solid rgba(14, 41, 67, 0.16);
}

.project-row::before {
  content: "";
  position: absolute;
  top: -1px;
  left: 0;
  width: 100%;
  height: 1px;
  background: var(--color-gold);
  transition: transform 700ms var(--motion-ease);
  transform: scaleX(0);
  transform-origin: left;
  z-index: 1;
}

.project-row:hover {
  padding-left: 12px;
}

.project-row:hover::before {
  transform: scaleX(1);
}

.project-number {
  padding-top: 6px;
  color: var(--color-gold-dark);
  font-family: var(--font-display);
  font-size: 0.82rem;
  letter-spacing: 0.08em;
}

.project-row-content {
  min-width: 0;
}

.project-kicker {
  display: block;
  margin-bottom: 16px;
  color: rgba(14, 41, 67, 0.48);
  font-size: 0.61rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.project-row h3 {
  margin: 0;
  color: var(--color-navy);
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 2.65vw, 3rem);
  font-weight: 400;
  line-height: 1;
  letter-spacing: -0.035em;
}

.project-row p {
  max-width: 390px;
  margin: 18px 0 0;
  color: rgba(41, 41, 41, 0.62);
  font-size: 0.86rem;
  line-height: 1.75;
}

.project-row-arrow {
  display: grid;
  width: 34px;
  height: 34px;
  place-items: center;
  margin-top: 2px;
  border: 1px solid rgba(14, 41, 67, 0.18);
  border-radius: 50%;
  color: var(--color-navy);
  font-size: 0.88rem;
  transition:
    color 0.35s ease,
    background 0.35s ease,
    border-color 0.35s ease,
    transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
}

.project-row:hover .project-row-arrow {
  transform: rotate(45deg);
  border-color: var(--color-navy);
  background: var(--color-navy);
  color: var(--color-white);
}

/* Footer CTA */

.projects-footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 40px;
  margin-top: clamp(52px, 6vw, 90px);
  padding-top: 28px;
  border-top: 1px solid rgba(14, 41, 67, 0.14);
}

.projects-footer > p {
  max-width: 450px;
  margin: 0;
  color: rgba(41, 41, 41, 0.5);
  font-size: 0.72rem;
  line-height: 1.7;
}

.projects-view-all {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 28px;
  padding: 0 0 12px;
  color: var(--color-navy);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.13em;
  text-decoration: none;
  text-transform: uppercase;
}

.projects-view-all::after {
  content: "";
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 1px;
  background:
    linear-gradient(
      90deg,
      var(--color-gold) 0 50%,
      rgba(14, 41, 67, 0.2) 50% 100%
    );
  background-size: 200% 100%;
  background-position: 100% 0;
  transition: background-position 0.5s ease;
}

.projects-view-all:hover::after {
  background-position: 0 0;
}

.projects-view-all > span:last-child {
  font-size: 1rem;
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.projects-view-all:hover > span:last-child {
  transform: translate(4px, -4px);
}

/* =========================================================
   FEATURED PROJECTS - TABLET
   ========================================================= */

@media (max-width: 1100px) {
  .projects-heading-row {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .projects-heading-meta {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .projects-showcase {
    grid-template-columns: 1fr;
    gap: 34px;
  }

  .projects-visual {
    position: relative;
    top: auto;
  }

  .projects-visual-frame {
    min-height: clamp(430px, 67vw, 680px);
  }

  .projects-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid rgba(14, 41, 67, 0.16);
  }

  .project-row {
    grid-template-columns: 34px minmax(0, 1fr);
    min-height: 300px;
    padding: 32px 24px;
    border-right: 1px solid rgba(14, 41, 67, 0.16);
  }

  .project-row:last-child {
    border-right: 0;
    border-bottom: 0;
  }

  .project-row-arrow {
    position: absolute;
    right: 22px;
    bottom: 26px;
  }

  .project-row:hover {
    padding-left: 24px;
  }

  .project-row h3 {
    font-size: clamp(1.55rem, 3vw, 2.2rem);
  }
}

/* =========================================================
   FEATURED PROJECTS - MOBILE
   ========================================================= */

@media (max-width: 720px) {
  .featured-projects::before {
    left: 20px;
    right: 20px;
  }

  .projects-heading-row {
    margin-bottom: 38px;
  }

  .projects-heading-meta {
    gap: 18px;
  }

  .projects-count {
    font-size: 0.58rem;
  }

  .projects-title {
    font-size: clamp(2.65rem, 12vw, 4.4rem);
    line-height: 0.94;
  }

  .projects-heading-copy > p {
    margin-top: 24px;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .projects-showcase {
    gap: 20px;
  }

  .projects-visual-frame {
    min-height: 0;
    aspect-ratio: 1 / 1.18;
  }

  .projects-visual-frame::before {
    inset: 10px;
  }

  .projects-visual-caption {
    left: 22px;
    right: 22px;
    bottom: 22px;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .projects-visual-caption span:last-child {
    text-align: left;
  }

  .projects-list {
    display: block;
    border-bottom: 0;
  }

  .project-row {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) 32px;
    min-height: 0;
    gap: 14px;
    padding: 30px 0;
    border-right: 0;
  }

  .project-row:last-child {
    border-bottom: 1px solid rgba(14, 41, 67, 0.16);
  }

  .project-row:hover {
    padding-left: 0;
  }

  .project-kicker {
    margin-bottom: 10px;
    font-size: 0.56rem;
  }

  .project-row h3 {
    font-size: clamp(1.75rem, 8vw, 2.35rem);
  }

  .project-row p {
    margin-top: 14px;
    font-size: 0.8rem;
  }

  .project-row-arrow {
    position: static;
    right: auto;
    bottom: auto;
    width: 30px;
    height: 30px;
  }

  .projects-footer {
    display: block;
    margin-top: 44px;
  }

  .projects-footer > p {
    margin-bottom: 30px;
  }

  .projects-view-all {
    width: 100%;
    justify-content: space-between;
  }
}

/* =========================================================
   FEATURED PROJECTS - REDUCED MOTION
   ========================================================= */


/* =========================================================
   FEATURED PROJECTS - INTERACTIVE VISUAL STATES
   ========================================================= */

.projects-image-stack {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
}

/* Prevent old generic image hover rule from scaling every layer */

/* Image counter */

.projects-visual-index {
  position: absolute;
  z-index: 4;
  top: clamp(30px, 3.5vw, 48px);
  right: clamp(30px, 3.5vw, 48px);

  display: flex;
  align-items: center;
  gap: 13px;

  color: var(--color-white);
  font-size: 0.64rem;
  font-weight: 700;
  letter-spacing: 0.16em;
}

.projects-visual-index::before {
  content: "";
  width: 34px;
  height: 1px;
  background: rgba(255, 255, 255, 0.55);
}

.projects-visual-index span:first-child {
  color: var(--color-gold-light);
  font-family: var(--font-display);
  font-size: 1rem;
}

.projects-visual-index span:last-child {
  color: rgba(255, 255, 255, 0.58);
}

/* Active project row */

.project-row {
  outline: none;
}

.project-row--active {
  border-color: rgba(215, 183, 125, 0.52);
}

.project-row--active::before {
  transform: scaleX(1);
}

.project-row--active .project-number {
  color: var(--color-gold-dark);
}

.project-row--active .project-kicker {
  color: var(--color-gold-dark);
}

.project-row--active h3 {
  color: var(--color-navy-deep);
}

.project-row--active .project-row-arrow {
  transform: rotate(45deg);
  border-color: var(--color-navy);
  background: var(--color-navy);
  color: var(--color-white);
}

.project-row:focus-visible {
  outline: 1px solid var(--color-gold);
  outline-offset: 6px;
}

/* Caption transition */

.projects-visual-caption span:first-child {
}

/* =========================================================
   PROJECT VISUAL - TABLET / MOBILE
   ========================================================= */

@media (max-width: 1100px) {

  .projects-visual-index {
    top: 30px;
    right: 30px;
  }
}

@media (max-width: 720px) {
  .projects-visual-index {
    top: 22px;
    right: 22px;
    gap: 9px;
    font-size: 0.55rem;
  }

  .projects-visual-index::before {
    width: 22px;
  }

  .projects-visual-index span:first-child {
    font-size: 0.82rem;
  }

  .project-row--active {
    padding-left: 0;
  }
}

/* =========================================================
   PROJECT VISUAL - REDUCED MOTION
   ========================================================= */


/* =========================================================
   FEATURED PROJECTS - DESKTOP SCROLL STORY
   Gives each project enough vertical travel while the
   visual remains pinned beside the active project.
   ========================================================= */

@media (min-width: 1101px) {
  .featured-projects .projects-showcase {
    align-items: stretch;
  }

  .featured-projects .projects-visual {
    position: sticky;
    top: clamp(96px, 10vh, 118px);
    align-self: start;
    height: calc(100vh - clamp(150px, 17vh, 190px));
    min-height: 520px;
    max-height: 720px;
  }

  .featured-projects .projects-visual-frame {
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .featured-projects .projects-list {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .featured-projects .project-row {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) 38px;
    align-content: center;

    min-height: clamp(440px, 63vh, 620px);
    padding-top: clamp(58px, 7vh, 90px);
    padding-bottom: clamp(58px, 7vh, 90px);
  }

  .featured-projects .project-row-content {
    align-self: center;
  }

  .featured-projects .project-number,
  .featured-projects .project-row-arrow {
    align-self: center;
  }

  .featured-projects .project-row:hover {
    padding-left: 12px;
  }
}

/* Large desktop: keep the storytelling spacious without
   making each step excessively tall. */
@media (min-width: 1600px) {
  .featured-projects .project-row {
    min-height: clamp(500px, 61vh, 680px);
  }

  .featured-projects .projects-visual {
    max-height: 760px;
  }
}


/* =========================================================
   FEATURED PROJECTS - RESPONSIVE SCROLL STORY
   Tablet: pinned visual + vertical project chapters
   Mobile: compact pinned visual + touch-friendly chapters
   ========================================================= */

/* ---------------- TABLET ---------------- */

@media (min-width: 721px) and (max-width: 1100px) {
  .featured-projects .projects-showcase {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.72fr);
    gap: clamp(28px, 4vw, 48px);
    align-items: stretch;
  }

  .featured-projects .projects-visual {
    position: sticky;
    top: 96px;
    align-self: start;
    height: min(64vh, 620px);
    min-height: 430px;
  }

  .featured-projects .projects-visual-frame {
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .featured-projects .projects-list {
    display: flex;
    flex-direction: column;
    border-bottom: 0;
  }

  .featured-projects .project-row {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    min-height: clamp(360px, 52vh, 500px);
    padding: 46px 20px;
    border-right: 0;
    border-bottom: 0;
  }

  .featured-projects .project-row:last-child {
    border-right: 0;
    border-bottom: 1px solid rgba(14, 41, 67, 0.16);
  }

  .featured-projects .project-row:hover {
    padding-left: 20px;
  }

  .featured-projects .project-row-arrow {
    position: absolute;
    right: 20px;
    bottom: 28px;
  }

  .featured-projects .project-row h3 {
    font-size: clamp(1.65rem, 3.2vw, 2.45rem);
  }
}


/* ---------------- MOBILE ---------------- */

@media (max-width: 720px) {
  .featured-projects .projects-showcase {
    display: block;
  }

  .featured-projects .projects-visual {
    position: sticky;
    top: 76px;
    z-index: 8;

    width: 100%;
    margin-bottom: 18px;

    background: var(--color-ivory);
  }

  .featured-projects .projects-visual-frame {
    width: 100%;
    height: clamp(235px, 61vw, 330px);
    min-height: 0;
    aspect-ratio: auto;
  }

  .featured-projects .projects-list {
    position: relative;
    z-index: 2;

    display: block;
    border-bottom: 0;

    background: var(--color-ivory);
  }

  .featured-projects .project-row {
    min-height: clamp(250px, 52vh, 340px);
    padding-top: 38px;
    padding-bottom: 38px;
  }

  .featured-projects .project-row:first-child {
    border-top-color: rgba(14, 41, 67, 0.16);
  }

  .featured-projects .projects-visual-caption {
    left: 20px;
    right: 20px;
    bottom: 16px;
  }

  .featured-projects .projects-visual-index {
    top: 20px;
    right: 20px;
  }
}


/* Very small phones */

@media (max-width: 430px) {
  .featured-projects .projects-visual {
    top: 70px;
  }

  .featured-projects .projects-visual-frame {
    height: clamp(225px, 60vw, 285px);
  }

  .featured-projects .project-row {
    min-height: 280px;
  }
}


/* =========================================================
   HOME SERVICES
   Vasupriy navy / champagne interpretation
   ========================================================= */

.home-services {
  position: relative;
  overflow: hidden;
  background:
    linear-gradient(
      135deg,
      #081d30 0%,
      var(--color-navy) 48%,
      #102f4b 100%
    );
  color: var(--color-ivory);
  isolation: isolate;
}

.home-services::before {
  content: "";
  position: absolute;
  top: 0;
  left: var(--page-padding);
  right: var(--page-padding);
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(215, 183, 125, 0.5),
    transparent
  );
}

.home-services-atmosphere,
.home-services-grid,
.home-services-glow {
  position: absolute;
  pointer-events: none;
}

.home-services-atmosphere {
  inset: 0;
  overflow: hidden;
  z-index: -1;
}

.home-services-grid {
  inset: 0;
  opacity: 0.055;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.12) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.12) 1px, transparent 1px);
  background-size: 80px 80px;
  mask-image: linear-gradient(to bottom, black, transparent 90%);
}

.home-services-glow {
  border-radius: 50%;
  filter: blur(1px);
}

.home-services-glow--one {
  width: 540px;
  height: 540px;
  top: -260px;
  right: -140px;
  background: radial-gradient(
    circle,
    rgba(215, 183, 125, 0.14),
    transparent 68%
  );
}

.home-services-glow--two {
  width: 500px;
  height: 500px;
  bottom: -300px;
  left: -160px;
  background: radial-gradient(
    circle,
    rgba(215, 183, 125, 0.09),
    transparent 70%
  );
}

.home-services-container {
  position: relative;
  z-index: 2;
}


/* ---------------- HEADING ---------------- */

.home-services-heading {
  display: grid;
  grid-template-columns: minmax(190px, 0.58fr) minmax(0, 1.42fr);
  gap: clamp(40px, 7vw, 110px);
  align-items: start;
  margin-bottom: clamp(64px, 8vw, 110px);
}

.home-services-heading-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 26px;
  padding-top: 9px;
}

.home-services-label {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 9px 15px;
  border: 1px solid rgba(215, 183, 125, 0.38);
  border-radius: 999px;

  color: var(--color-gold);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.home-services-label > span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--color-gold);
  box-shadow: 0 0 0 5px rgba(215, 183, 125, 0.1);
}

.home-services-count {
  color: rgba(245, 240, 234, 0.44);
  font-size: 0.68rem;
  letter-spacing: 0.18em;
}

.home-services-heading-copy h2 {
  margin: 0;
  max-width: 920px;

  color: var(--color-ivory);
  font-family: var(--font-heading);
  font-size: clamp(3.1rem, 5.7vw, 6.5rem);
  font-weight: 400;
  line-height: 0.94;
  letter-spacing: -0.055em;
}

.home-services-heading-copy h2 em {
  color: var(--color-gold);
  font-style: italic;
}

.home-services-heading-copy > p {
  max-width: 630px;
  margin: 34px 0 0;

  color: rgba(245, 240, 234, 0.68);
  font-size: clamp(0.92rem, 1.1vw, 1.05rem);
  line-height: 1.8;
}


/* ---------------- MAIN STAGE ---------------- */

.home-services-stage {
  display: grid;
  grid-template-columns: minmax(0, 0.92fr) minmax(420px, 1.08fr);
  gap: clamp(48px, 7vw, 110px);
  align-items: stretch;
}

.home-services-content {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.home-services-list {
  border-top: 1px solid rgba(245, 240, 234, 0.17);
}

.home-service-item {
  position: relative;
  display: grid;
  grid-template-columns: 52px minmax(0, 1fr) 34px;
  gap: 18px;
  align-items: center;

  width: 100%;
  min-height: 92px;
  padding: 22px 0;

  border: 0;
  border-bottom: 1px solid rgba(245, 240, 234, 0.17);
  background: transparent;

  color: rgba(245, 240, 234, 0.56);
  text-align: left;
  cursor: pointer;

  transition:
    color 0.4s ease,
    padding-left 0.45s cubic-bezier(0.16, 1, 0.3, 1),
    border-color 0.4s ease;
}

.home-service-item::before {
  content: "";
  position: absolute;
  left: 0;
  bottom: -1px;

  width: 100%;
  height: 1px;

  background: var(--color-gold);

  transition: transform 700ms var(--motion-ease);

  transform: scaleX(0);

  transform-origin: left;

  z-index: 1;
}

.home-service-number {
  color: rgba(215, 183, 125, 0.56);
  font-size: 0.66rem;
  letter-spacing: 0.16em;
  transition: color 0.35s ease;
}

.home-service-title {
  font-family: var(--font-heading);
  font-size: clamp(1.55rem, 2.25vw, 2.55rem);
  font-weight: 400;
  line-height: 1.08;
  letter-spacing: -0.025em;
}

.home-service-arrow {
  display: grid;
  place-items: center;

  width: 32px;
  height: 32px;

  border: 1px solid rgba(245, 240, 234, 0.22);
  border-radius: 50%;

  font-size: 0.9rem;

  opacity: 0.42;
  transform: rotate(0deg);

  transition:
    opacity 0.35s ease,
    color 0.35s ease,
    border-color 0.35s ease,
    transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
}

.home-service-item:hover,
.home-service-item:focus-visible,
.home-service-item--active {
  color: var(--color-gold);
  padding-left: 12px;
  outline: none;
}

.home-service-item--active {
  border-bottom-color: rgba(215, 183, 125, 0.48);
}

.home-service-item--active::before {
  transform: scaleX(1);
}

.home-service-item:hover .home-service-number,
.home-service-item:focus-visible .home-service-number,
.home-service-item--active .home-service-number {
  color: var(--color-gold);
}

.home-service-item:hover .home-service-arrow,
.home-service-item:focus-visible .home-service-arrow,
.home-service-item--active .home-service-arrow {
  color: var(--color-navy-deep);
  border-color: var(--color-gold);
  background: var(--color-gold);
  opacity: 1;
  transform: rotate(45deg);
}


/* ---------------- DESCRIPTION / CTA ---------------- */

.home-services-description {
  min-height: 104px;
  margin-top: 38px;
}

.home-services-description p {
  max-width: 540px;
  margin: 0;

  color: rgba(245, 240, 234, 0.7);
  font-size: 0.94rem;
  line-height: 1.8;
}

.home-services-cta {
  position: relative;

  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: 34px;

  width: fit-content;
  min-width: 245px;
  margin-top: 28px;
  padding: 17px 20px 17px 22px;

  border: 1px solid rgba(215, 183, 125, 0.55);
  border-radius: 999px;

  color: var(--color-ivory);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-decoration: none;
  text-transform: uppercase;

  overflow: hidden;
  isolation: isolate;

  transition:
    color 0.4s ease,
    border-color 0.4s ease;
}

.home-services-cta::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;

  background: var(--color-gold);
  transform: translateX(-102%);

  transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
}

.home-services-cta:hover {
  color: var(--color-navy-deep);
  border-color: var(--color-gold);
}

.home-services-cta:hover::before {
  transform: translateX(0);
}

.home-services-cta-arrow {
  font-size: 1rem;
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.home-services-cta:hover .home-services-cta-arrow {
  transform: translate(3px, -3px);
}


/* ---------------- VISUAL ---------------- */

.home-services-visual {
  min-width: 0;
}

.home-services-image-frame {
  position: relative;
  overflow: hidden;

  width: 100%;
  height: 100%;
  min-height: 590px;

  border-radius: 2px 42px 2px 42px;
  background: #081b2c;

  box-shadow:
    0 28px 80px rgba(0, 0, 0, 0.22),
    inset 0 0 0 1px rgba(215, 183, 125, 0.1);

  isolation: isolate;
}

.home-services-image-frame::before {
  content: "";
  position: absolute;
  inset: 16px;
  z-index: 4;

  border: 1px solid rgba(215, 183, 125, 0.26);
  border-radius: 1px 30px 1px 30px;

  pointer-events: none;
}

.home-services-image-shade {
  position: absolute;
  inset: 0;
  z-index: 2;

  background:
    linear-gradient(
      180deg,
      rgba(5, 20, 33, 0.08) 25%,
      rgba(5, 20, 33, 0.28) 58%,
      rgba(5, 20, 33, 0.82) 100%
    ),
    linear-gradient(
      90deg,
      rgba(5, 20, 33, 0.18),
      transparent 52%
    );

  pointer-events: none;
}

.home-services-visual-index {
  position: absolute;
  top: 36px;
  right: 38px;
  z-index: 5;

  display: flex;
  align-items: baseline;
  gap: 7px;

  color: var(--color-ivory);
}

.home-services-visual-index span:first-child {
  color: var(--color-gold);
  font-family: var(--font-heading);
  font-size: clamp(2.5rem, 4vw, 4.5rem);
  line-height: 1;
}

.home-services-visual-index span:last-child {
  color: rgba(245, 240, 234, 0.5);
  font-size: 0.7rem;
  letter-spacing: 0.12em;
}

.home-services-visual-caption {
  position: absolute;
  left: 42px;
  right: 42px;
  bottom: 38px;
  z-index: 5;

  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 30px;

  color: var(--color-ivory);
}

.home-services-visual-caption > span {
  max-width: 390px;

  font-family: var(--font-heading);
  font-size: clamp(1.7rem, 2.8vw, 3rem);
  line-height: 1.02;
  letter-spacing: -0.025em;
}

.home-services-visual-caption small {
  max-width: 190px;

  color: rgba(245, 240, 234, 0.6);
  font-size: 0.58rem;
  line-height: 1.6;
  letter-spacing: 0.14em;
  text-align: right;
  text-transform: uppercase;
}


/* ---------------- ANIMATION ---------------- */


/* =========================================================
   HOME SERVICES - TABLET
   ========================================================= */

@media (max-width: 1100px) {
  .home-services-heading {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .home-services-heading-meta {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .home-services-stage {
    grid-template-columns: minmax(0, 0.95fr) minmax(340px, 1.05fr);
    gap: 36px;
  }

  .home-service-item {
    grid-template-columns: 40px minmax(0, 1fr) 32px;
  }

  .home-service-title {
    font-size: clamp(1.4rem, 2.8vw, 2rem);
  }

  .home-services-image-frame {
    min-height: 520px;
  }
}


/* =========================================================
   HOME SERVICES - MOBILE
   ========================================================= */

@media (max-width: 760px) {
  .home-services-heading {
    margin-bottom: 48px;
  }

  .home-services-heading-meta {
    gap: 18px;
  }

  .home-services-heading-copy h2 {
    font-size: clamp(2.65rem, 11.5vw, 4.3rem);
  }

  .home-services-heading-copy > p {
    margin-top: 24px;
    font-size: 0.88rem;
  }

  .home-services-stage {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .home-services-content {
    order: 2;
  }

  .home-services-visual {
    order: 1;
  }

  .home-services-image-frame {
    min-height: 0;
    height: clamp(330px, 105vw, 480px);
    border-radius: 2px 28px 2px 28px;
  }

  .home-services-image-frame::before {
    inset: 10px;
    border-radius: 1px 20px 1px 20px;
  }

  .home-services-visual-index {
    top: 24px;
    right: 24px;
  }

  .home-services-visual-caption {
    left: 24px;
    right: 24px;
    bottom: 24px;

    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .home-services-visual-caption small {
    text-align: left;
  }

  .home-service-item {
    grid-template-columns: 36px minmax(0, 1fr) 30px;
    min-height: 82px;
    gap: 12px;
    padding: 20px 0;
  }

  .home-service-item:hover,
  .home-service-item:focus-visible,
  .home-service-item--active {
    padding-left: 6px;
  }

  .home-service-title {
    font-size: clamp(1.35rem, 6vw, 1.85rem);
  }

  .home-services-description {
    min-height: 0;
    margin-top: 30px;
  }

  .home-services-cta {
    width: 100%;
    margin-top: 26px;
  }
}


/* =========================================================
   HOME SERVICES - SMALL MOBILE
   ========================================================= */

@media (max-width: 430px) {
  .home-services-count {
    display: none;
  }

  .home-services-image-frame {
    height: 320px;
  }

  .home-services-visual-caption > span {
    font-size: 1.6rem;
  }

  .home-services-visual-caption small {
    font-size: 0.52rem;
  }
}


/* ---------------- REDUCED MOTION ---------------- */


/* =========================================================
   GLOBAL HORIZONTAL OVERFLOW SAFETY
   Off-canvas mobile navigation must not widen the document
   ========================================================= */

html,
body,
#root {
  width: 100%;
  max-width: 100%;
}

html,
body {
  overflow-x: clip;
}

/*
  The mobile navigation is intentionally positioned off-canvas
  when closed. Keep that visual behaviour without allowing it
  to create document-level horizontal scrolling.
*/
.site-header {
  max-width: 100vw;
}

/* Animated/ticker content stays clipped by its own section. */
.brand-strip {
  overflow: hidden;
  max-width: 100%;
}

/* Decorative service glows must never affect page width. */
.home-services {
  overflow-x: clip;
}

@supports not (overflow: clip) {
  html,
  body {
    overflow-x: hidden;
  }

  .home-services {
    overflow-x: hidden;
  }
}
/* =========================================================
   HOME MOTION SYSTEM
   Shared easing and masks; entrances belong to the observed
   heading / frame / chapter, never to the sticky container.
   Layout and selection are independent of animation.
   ========================================================= */

.site {
  --motion-ease: cubic-bezier(0.16, 1, 0.3, 1);
  --motion-duration: 1100ms;
}

.preloader--leaving {
  background: transparent;
}

.hero-title-mask,
.motion-title-mask,
.intro-title-mask {
  display: block;
  overflow: hidden;
  padding: 0.14em 0.03em;
  margin: -0.14em -0.03em;
}

.hero-title-line,
.motion-title-line,
.intro-title-line {
  display: block;
  transform-origin: left bottom;
}

/* Hero: image first, type next, then copy, actions, card and indicator. */

.hero-media {
  overflow: hidden;
}

.hero-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: scale(1.01);
}

.site:not(.site--ready) .hero-media img {
  transform: scale(1.12);
}

.site--ready .hero-motion-media img {
  animation: homeHeroImage 2400ms var(--motion-ease) both;
}

.site:not(.site--ready) .hero-motion-media {
  clip-path: inset(0 0 100% 0);
}

.site--ready .hero-motion-media {
  animation: homeCurtain 1500ms var(--motion-ease) both;
}

.site:not(.site--ready) :is(.hero-motion-eyebrow, .hero-title-line, .hero-description, .hero-actions, .hero-motion-feature, .hero-motion-scroll) {
  opacity: 0;
}

.site--ready .hero-motion-eyebrow {
  animation: homeCopy 850ms var(--motion-ease) 350ms both;
}

.site--ready .hero-title-mask:nth-child(1) .hero-title-line {
  animation: homeType 1150ms var(--motion-ease) 500ms both;
}

.site--ready .hero-title-mask:nth-child(2) .hero-title-line {
  animation: homeType 1200ms var(--motion-ease) 680ms both;
}

.site--ready .hero-title-mask:nth-child(3) .hero-title-line {
  animation: homeType 1200ms var(--motion-ease) 850ms both;
}

.site--ready .hero-description {
  animation: homeCopy 950ms var(--motion-ease) 1100ms both;
}

.site--ready .hero-actions {
  animation: homeCopy 950ms var(--motion-ease) 1280ms both;
}

.site--ready .hero-motion-feature {
  animation: homeCard 1100ms var(--motion-ease) 1450ms both;
}

.site--ready .hero-motion-scroll {
  animation: homeIndicator 850ms var(--motion-ease) 1800ms both;
}

.eyebrow-line, .feature-line {
  transform-origin: left;
}

.site--ready .eyebrow-line {
  animation: homeDraw 1000ms var(--motion-ease) 450ms both;
}

.site--ready .feature-line {
  animation: homeDraw 1000ms var(--motion-ease) 1850ms both;
}

.hero-motion-scroll .scroll-line {
  overflow: hidden;
}

.hero-motion-scroll .scroll-line::after {
  content: '';
  display: block;
  width: 100%;
  height: 100%;
  background: var(--color-white);
  animation: homeScrollLine 2500ms var(--motion-ease) 2600ms infinite;
}

.hero-motion-media {
  transform: translate3d(0, var(--hero-media-y, 0px), 0) scale(var(--hero-media-scale, 1));
}

.hero-content {
  transform: translate3d(0, var(--hero-content-y, 0px), 0);
  opacity: var(--hero-content-opacity, 1);
}

.hero-motion-feature {
  translate: 0 var(--hero-feature-y, 0px);
}

.hero-motion-scroll {
  opacity: var(--hero-scroll-opacity, 1);
}

/* Animate the independent opacity channel, so scroll depth remains effective. */

.hero-motion-scroll > span {
  opacity: var(--hero-scroll-opacity, 1);
}

.hero-section--cinematic::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background: linear-gradient(to bottom, transparent 52%, rgba(5, 20, 34, 0.28));
  opacity: calc(var(--hero-scroll-progress, 0) * 0.8);
}

/* Two equal groups, including the trailing separator and space.
   A group is at least a viewport wide even on very large displays. */

.brand-strip-track {
  display: flex;
  width: max-content;
  gap: 0;
  padding: 0;
  font-family: var(--font-display);
  font-size: clamp(0.92rem, 1.3vw, 1.25rem);
  animation: homeMarquee 36s linear infinite;
}

.brand-strip-group {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: space-around;
  min-width: 100vw;
  min-height: 72px;
  gap: clamp(24px, 3vw, 54px);
  padding-inline: clamp(12px, 1.5vw, 27px);
}

.brand-strip-item {
  display: inline-flex;
  align-items: center;
  gap: clamp(24px, 3vw, 54px);
  white-space: nowrap;
}

.brand-strip-item i {
  display: block;
  width: 5px;
  height: 5px;
  flex: 0 0 5px;
  border-radius: 50%;
  background: var(--color-navy);
}

.brand-strip:hover .brand-strip-track {
  animation-play-state: paused;
}

/* About retains its architectural decoration, now on the same timeline. */

/* Below-Hero continuity stays on separate translate layers from entrance transforms. */
.brand-strip {
  translate: 0 calc(var(--motion-depth, 0px) * 0.35);
  opacity: var(--motion-release, 1);
}

:is(.projects-heading-row, .home-services-heading) {
  translate: 0 var(--motion-depth, 0px);
}

.home-services-image-stack {
  translate: 0 var(--motion-depth, 0px);
}

/* Late arrivals keep hierarchy visible without waiting through offscreen delays. */
.motion-enabled :is(.projects-heading-row, .home-services-heading, .home-products-heading, .projects-visual-frame, .home-services-image-frame, .home-products-frame, .project-row, .home-service-item, .home-product-category, .projects-footer, .home-services-description, .home-services-cta, .home-products-footer, .why-vasupriy-intro-content, .why-vasupriy-row).motion-reveal--prompt,
.motion-enabled .motion-reveal--prompt :is(.motion-title-line, .projects-heading-meta, .projects-heading-copy > p, .home-services-heading-meta, .home-services-heading-copy > p, .home-products-heading-meta, .section-label, .why-vasupriy-intro, .why-vasupriy-number, .why-vasupriy-copy) {
  animation-delay: 0ms !important;
  animation-duration: 240ms !important;
}

@keyframes homeEditorialCopy {
  from { opacity: 0; transform: translateY(var(--editorial-travel, 36px)); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 960px) {
  :is(.featured-projects, .home-services, .home-products, .why-vasupriy) { --editorial-travel: 24px; --editorial-duration: 700ms; }
}

@media (max-width: 760px) {
  :is(.featured-projects, .home-services, .home-products, .why-vasupriy) { --editorial-travel: 16px; --editorial-duration: 520ms; --motion-duration: 700ms; }
}

@media (prefers-reduced-motion: reduce) {
  :is(.brand-strip, .projects-heading-row, .home-services-heading, .home-services-image-stack) {
    translate: none;
    opacity: 1;
  }
  .projects-progress-enabled .projects-visual-frame .project-visual-image { transform: none; }
}

.intro-section--cinematic {
  isolation: isolate;
  overflow: hidden;
}

.intro-section--cinematic .site-container {
  position: relative;
  z-index: 2;
}

.intro-motion-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

.intro-motion-orbit {
  position: absolute;
  display: block;
  border: 1px solid rgba(215, 183, 125, 0.14);
  border-radius: 50%;
}

.intro-motion-orbit--one {
  width: clamp(280px, 34vw, 620px);
  aspect-ratio: 1;
  top: -34%;
  right: -9%;
}

.intro-motion-orbit--two {
  width: clamp(180px, 21vw, 390px);
  aspect-ratio: 1;
  right: 8%;
  bottom: -28%;
  border-color: rgba(14, 41, 67, 0.09);
}

.intro-motion-orbit {
  translate: 0 var(--intro-depth-y, 0px);
}

.intro-motion-line {
  position: absolute;
  left: var(--page-padding);
  right: var(--page-padding);
  bottom: 0;
  height: 1px;
  background: linear-gradient(90deg, rgba(215,183,125,0.8), rgba(215,183,125,0.22) 42%, rgba(14,41,67,0.08));
  transform-origin: left;
}

.intro-cinematic-title {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.intro-title-mask--accent {
  position: relative;
}

.intro-title-mask--accent::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0.02em;
  height: 1px;
  background: linear-gradient(90deg, var(--color-gold), transparent);
  transform-origin: left;
}

.intro-story-arrow {
  display: inline-block;
  transition: transform 550ms var(--motion-ease);
}

.intro-story-link:is(:hover, :focus-visible) .intro-story-arrow {
  transform: translate(4px, -4px);
}

/* Scroll-owned assembly layers; interaction/depth transforms remain nested. */
.motion-enabled [data-scroll-reveal] {
  transition: none;
  opacity: var(--reveal-opacity, 0);
  translate: var(--reveal-x, 0px) var(--reveal-y, 70px);
  scale: var(--reveal-scale, 1);
  clip-path: var(--reveal-clip, none);
}

/* Let the visitor see heading travel outside its resting mask; final clip is unchanged. */
.motion-enabled [data-assembly-mask] {
  display: flow-root;
  overflow: visible;
  clip-path: inset(0 calc(0px - var(--assembly-mask-x, 0px)) calc(0px - var(--assembly-mask-y, 0px)) calc(0px - var(--assembly-mask-x, 0px)));
}

.motion-enabled .intro-motion-orbit[data-scroll-reveal] {
  translate: var(--reveal-x, 0px) calc(var(--reveal-y, 0px) + var(--intro-depth-y, 0px));
}

.motion-enabled [data-scroll-reveal="left"] {
  translate: var(--reveal-x, -70px) 0;
  scale: var(--reveal-scale, 1.025);
  clip-path: var(--reveal-clip, inset(0 12% 0 0));
}

.motion-enabled [data-scroll-reveal="right"] {
  translate: var(--reveal-x, 70px) 0;
  scale: var(--reveal-scale, 1.025);
  clip-path: var(--reveal-clip, inset(0 0 0 12%));
}

.motion-enabled [data-scroll-reveal="rule"] {
  translate: none;
  transform: scaleX(var(--reveal-rule, 0));
  transform-origin: left;
}

.motion-enabled :is(.home-service-item, .home-product-category, .why-vasupriy-row)[data-scroll-reveal]::after {
  transform: scaleX(var(--reveal-rule, 0));
}

@media (prefers-reduced-motion: reduce) {
  .motion-enabled [data-scroll-reveal] { opacity: 1; translate: none; scale: none; clip-path: none; }
  .motion-enabled .intro-motion-orbit[data-scroll-reveal] { translate: none; }
  .motion-enabled [data-scroll-reveal="rule"],
  .motion-enabled :is(.home-service-item, .home-product-category, .why-vasupriy-row)[data-scroll-reveal]::after { transform: none; }
}

/* Each project chapter enters separately as the sticky story advances. */

.motion-enabled :is(.project-row, .projects-footer)[data-reveal]:not(.is-revealed) {
  opacity: 0;
}

.motion-enabled :is(.project-row, .projects-footer).is-revealed {
  animation: homeEditorialCopy var(--editorial-duration, 850ms) var(--motion-ease) var(--reveal-delay, 0ms) both;
}

.project-row::after, .home-service-item::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: -1px;
  height: 1px;
  background: rgba(14,41,67,0.16);
  pointer-events: none;
  transform-origin: left;
}

.home-service-item::after {
  top: auto;
  bottom: -1px;
  background: rgba(245,240,234,0.17);
}

.motion-enabled .project-row[data-reveal] {
  border-color: transparent;
}

.motion-enabled .project-row:not(.is-revealed)::after {
  transform: scaleX(0);
}

.motion-enabled .project-row.is-revealed::after {
  animation: homeDraw 1200ms var(--motion-ease) var(--reveal-delay, 100ms) both;
}

.project-row-content {
  transition: transform 600ms var(--motion-ease);
}

.project-row--active .project-row-content {
  transform: translateX(4px);
}

.project-row p {
  transition: color 600ms ease;
}

.project-row--active p {
  color: rgba(41,41,41,0.8);
}

.home-service-title {
  transition: transform 600ms var(--motion-ease);
}

.home-service-item--active .home-service-title {
  transform: translateX(3px);
}

.home-service-item:focus-visible {
  outline: 2px solid var(--color-gold);
  outline-offset: 4px;
}


.motion-enabled .project-row:last-child {
  border-bottom-color: rgba(14, 41, 67, 0.16);
}

/* Atmosphere bridges the project story into the navy Services stage. */

.home-services-atmosphere {
  translate: 0 calc(var(--section-progress, 0) * -18px);
}

.motion-enabled .home-services-atmosphere:not(.is-revealed) {
  opacity: 0;
}

.motion-enabled .home-services-atmosphere.is-revealed {
  animation: homeAtmosphere 1800ms ease both;
}

/* Selection fades are short; scroll-owned project layers have no CSS lag. */
.projects-visual-frame .project-visual-image,
.home-services-image-frame .home-service-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  min-height: 0;
  object-fit: cover;
  object-position: center;
  opacity: 0;
  visibility: hidden;
  z-index: 0;
  transform: scale(1.02);
}

.projects-visual-frame .project-visual-image--active,
.home-services-image-frame .home-service-image--active {
  opacity: 1;
  visibility: visible;
  z-index: 1;
  transform: scale(1);
}

.home-services-image-frame .home-service-image {
  transition: opacity 520ms var(--motion-ease), transform 900ms var(--motion-ease);
}

.home-services-image-frame .motion-image-outgoing {
  visibility: visible;
}

.projects-progress-enabled .projects-visual-frame .project-visual-image {
  opacity: var(--project-opacity, 0);
  visibility: var(--project-visibility, hidden);
  transform: translateY(var(--project-y, 0px)) scale(var(--project-scale, 1));
  transition: none;
}

.projects-progress-enabled.projects-manual-selection .project-visual-image {
  transition: opacity 320ms var(--motion-ease), transform 500ms var(--motion-ease), visibility 0s 320ms;
}

.projects-progress-enabled.projects-manual-selection .project-visual-image--active {
  transition: opacity 320ms var(--motion-ease), transform 500ms var(--motion-ease), visibility 0s;
}

.home-services-image-frame .home-service-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  min-height: 0;
  object-fit: cover;
  object-position: center;
  opacity: 0;
  visibility: hidden;
  z-index: 0;
  transform: scale(1.035);
  transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1), transform 2200ms var(--motion-ease), visibility 0s linear 700ms;
}

.projects-visual-frame .project-visual-image--active,
.home-services-image-frame .home-service-image--active {
  opacity: 1;
  visibility: visible;
  z-index: 1;
  transform: scale(1);
  transition: opacity 950ms cubic-bezier(0.22, 1, 0.36, 1), transform 2200ms var(--motion-ease), visibility 0s;
}

.projects-progress-enabled .project-visual-image.project-layer-dormant {
  opacity: 0;
  visibility: hidden;
  transition: none;
}

.home-services-image-frame .home-service-image {
  filter: saturate(0.96) brightness(0.9);
}

.home-services-image-stack {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
}

.projects-visual-caption, .projects-visual-index, .home-services-visual-caption, .home-services-visual-index {
  overflow: hidden;
}

.projects-visual-caption > span:first-child,
.projects-visual-index > span:first-child,
.home-services-visual-caption > span,
.home-services-visual-index > span:first-child,
.home-services-description > p {
  animation: homeCaption 520ms var(--motion-ease) both;
}

@keyframes homeType {

  from {
    opacity: 0;
    transform: translate3d(0, 110%, 0) rotate(1deg);
  }

  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes homeCopy {

  from {
    opacity: 0;
    transform: translate3d(0, 28px, 0);
  }

  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes homeCaption {

  from {
    opacity: 0;
    transform: translate3d(0, 70%, 0);
  }

  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes homeCurtain {

  from {
    clip-path: inset(0 0 100% 0);
  }

  to {
    clip-path: inset(0);
  }
}

@keyframes homeDraw {

  from {
    transform: scaleX(0);
  }

  to {
    transform: scaleX(1);
  }
}

@keyframes homeSettle {

  from {
    transform: scale(1.045);
  }

  to {
    transform: scale(1);
  }
}

@keyframes homeArchitecture {

  from {
    opacity: 0;
    transform: scale(0.85);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes homeAtmosphere {

  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes homeHeroImage {

  from {
    transform: scale(1.12);
  }

  to {
    transform: scale(1.01);
  }
}

@keyframes homeCard {

  from {
    opacity: 0;
    transform: translate3d(24px, 20px, 0);
  }

  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes homeIndicator {

  from {
    opacity: 0;
    transform: rotate(-90deg) translateX(-12px);
  }

  to {
    opacity: 1;
    transform: rotate(-90deg);
  }
}

@keyframes homeScrollLine {

  from {
    transform: translateX(-110%);
  }

  55% {
    transform: translateX(0);
  }

  to {
    transform: translateX(110%);
  }
}

@keyframes homeMarquee {

  to {
    transform: translate3d(-50%, 0, 0);
  }
}

@media (max-width: 960px) {

  .hero-motion-media, .hero-content {
    transform: none;
  }

  .hero-content {
    opacity: 1;
  }

  .hero-media img {
    object-position: 63% center;
  }

  .hero-motion-feature {
    translate: none;
  }
}

@media (max-width: 720px) {

  .site {
    --motion-duration: 900ms;
  }

  .brand-strip-group {
    min-height: 62px;
    gap: 25px;
    padding-inline: 12.5px;
  }

  .brand-strip-item {
    gap: 25px;
  }

  .brand-strip-track {
    font-size: 0.98rem;
    animation-duration: 30s;
  }

  .intro-motion-orbit--one {
    width: 320px;
    top: -12%;
    right: -170px;
  }

  .intro-motion-orbit--two {
    width: 220px;
    right: -100px;
    bottom: -12%;
  }

  .project-row--active .project-row-content {
    transform: none;
  }

  .intro-motion-orbit, .home-services-atmosphere {
    translate: none;
  }

  .home-services-description {
    min-height: 8.1em;
  }
}

@media (max-width: 640px) {

  .hero-media img {
    object-position: 67% center;
  }
}

.motion-enabled :is(.project-row, .home-service-item, .intro-story-link, .home-services-cta):focus-visible {
  opacity: 1;
  animation: none;
}

/* Keep content reachable when the viewport cannot accommodate a pinned image. */

@media (max-width: 720px) and (max-height: 600px), (min-width: 721px) and (max-height: 620px) {

  .featured-projects .projects-visual {
    position: relative;
    top: auto;
    height: auto;
    min-height: 0;
  }

  .featured-projects .projects-visual-frame {
    height: clamp(225px, 38vh, 330px);
  }
}

@media (prefers-reduced-motion: reduce) {

  .site *, .site *::before, .site *::after {
    animation: none !important;
    transition: none !important;
  }

  .site :is(.hero-motion-eyebrow, .hero-title-line, .hero-description, .hero-actions, .hero-motion-feature, .hero-motion-scroll) {
    opacity: 1;
    transform: none;
    translate: none;
  }

  .site .hero-motion-media {
    clip-path: none;
    transform: none;
  }

  .site .hero-motion-media img, .site .hero-content {
    transform: none;
    opacity: 1;
  }

  .site :is(.intro-motion-orbit, .home-services-atmosphere) {
    translate: none;
  }

  .site :is(.project-row-content, .home-service-title) {
    transform: none;
  }

  .site .hero-motion-scroll {
    transform: rotate(-90deg);
  }

  .site .hero-motion-scroll .scroll-line::after {
    display: none;
  }

  .site .brand-strip-track {
    width: 100%;
    transform: none;
  }

  .site .brand-strip-group {
    min-width: 0;
    width: 100%;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    padding: 20px;
  }

  .site .brand-strip-group[aria-hidden="true"] {
    display: none;
  }

  .site :is(.project-visual-image, .home-service-image) {
    transform: none;
  }
}

/* =========================================================
   HOME — ABOUT VASUPRIY / ANTRA-INSPIRED EDITORIAL
   ========================================================= */

.about-antra {
  position: relative;
  isolation: isolate;
  overflow: clip;
  background: var(--color-ivory);
}

.about-antra-container {
  position: relative;
  z-index: 2;
}

/* ---------- Heading ---------- */

.about-antra-heading {
  display: grid;
  grid-template-columns: minmax(170px, 0.34fr) minmax(0, 1fr);
  gap: clamp(42px, 7vw, 120px);
  align-items: start;
  margin-bottom: clamp(54px, 6.5vw, 100px);
}

.about-antra-heading-label {
  padding-top: clamp(8px, 1vw, 16px);
}

.about-antra-title {
  margin: 0;
  max-width: 1100px;

  color: var(--color-navy-deep);

  font-family: var(--font-heading);
  font-size: clamp(3rem, 5.35vw, 6.25rem);
  font-weight: 400;
  line-height: 0.98;
  letter-spacing: -0.055em;
}

.about-antra-title em {
  color: var(--color-gold-dark);
  font-family: inherit;
  font-style: italic;
  font-weight: 400;
}

/* ---------- Main image ---------- */

.about-antra-visual {
  position: relative;
  width: 100%;
  height: clamp(420px, 54vw, 760px);
  overflow: hidden;

  border-radius: clamp(24px, 3vw, 48px);
  background: rgba(14, 41, 67, 0.08);
}

.about-antra-visual::after {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;

  background:
    linear-gradient(
      180deg,
      rgba(14, 41, 67, 0.02) 30%,
      rgba(14, 41, 67, 0.16) 100%
    );
}

.about-antra-visual img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center;
}

/* ---------- Large statement ---------- */

.about-antra-statement {
  display: grid;
  grid-template-columns: minmax(170px, 0.34fr) minmax(0, 1fr);
  gap: clamp(42px, 7vw, 120px);

  padding-top: clamp(54px, 7vw, 110px);
}

.about-antra-statement::before {
  content: '';
  display: block;
}

.about-antra-statement p {
  margin: 0;
  max-width: 1120px;

  color: var(--color-navy-deep);

  font-family: var(--font-heading);
  font-size: clamp(2rem, 3.6vw, 4.45rem);
  font-weight: 400;
  line-height: 1.08;
  letter-spacing: -0.04em;
}

/* ---------- Lower editorial composition ---------- */

.about-antra-bottom {
  position: relative;

  display: grid;
  grid-template-columns:
    minmax(220px, 0.72fr)
    minmax(280px, 0.92fr)
    minmax(280px, 0.82fr);

  gap: clamp(38px, 5.5vw, 92px);
  align-items: start;

  padding-top: clamp(72px, 9vw, 145px);
  padding-bottom: clamp(20px, 2vw, 36px);
}

/* ---------- Peacock watermark ---------- */

.about-antra-watermark {
  position: absolute;

  left: clamp(-130px, -5vw, -45px);
  bottom: clamp(-45px, -2vw, -10px);

  z-index: 0;

  width: clamp(390px, 37vw, 680px);
  height: clamp(390px, 37vw, 680px);

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;

  opacity: 0.065;

  pointer-events: none;
  user-select: none;
}

.about-antra-watermark img {
  width: 100%;
  height: 100%;
  display: block;

  object-fit: contain;

  filter: grayscale(1) sepia(0.28);
}

.about-antra-watermark-space {
  min-height: clamp(300px, 31vw, 500px);
}

/* ---------- Story ---------- */

.about-antra-story {
  position: relative;
  z-index: 2;
}

.about-antra-story > p {
  margin: 0 0 clamp(36px, 4vw, 62px);

  color: var(--color-text);

  font-size: clamp(0.98rem, 1.15vw, 1.16rem);
  line-height: 1.9;
}

.about-antra-cta {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;

  min-width: 190px;

  padding: 15px 0 11px;

  color: var(--color-navy-deep);
  border-bottom: 1px solid rgba(14, 41, 67, 0.38);

  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.11em;
  text-transform: uppercase;

  transition:
    color 350ms ease,
    border-color 350ms ease;
}

.about-antra-cta-arrow {
  display: inline-block;

  color: var(--color-gold-dark);
  font-size: 1.15rem;

  transition: transform 450ms ease;
}

.about-antra-cta:is(:hover, :focus-visible) {
  color: var(--color-gold-dark);
  border-color: var(--color-gold-dark);
}

.about-antra-cta:is(:hover, :focus-visible)
.about-antra-cta-arrow {
  transform: translate(5px, -5px);
}

/* ---------- Genuine Vasupriy points ---------- */

.about-antra-points {
  position: relative;
  z-index: 2;

  border-top: 1px solid rgba(14, 41, 67, 0.18);
}

.about-antra-point {
  display: grid;
  grid-template-columns: 28px 1fr;
  gap: 14px;
  align-items: center;

  padding: 19px 0;

  border-bottom: 1px solid rgba(14, 41, 67, 0.18);
}

.about-antra-point > span {
  color: var(--color-gold-dark);
  font-size: 0.95rem;

  transition: transform 350ms ease;
}

.about-antra-point p {
  margin: 0;

  color: var(--color-navy-deep);

  font-family: var(--font-heading);
  font-size: clamp(1rem, 1.25vw, 1.28rem);
  line-height: 1.3;
}

.about-antra-point:hover > span {
  transform: translateX(5px);
}


/* =========================================================
   ABOUT — TABLET
   ========================================================= */

@media (max-width: 1100px) {

  .about-antra-heading,
  .about-antra-statement {
    grid-template-columns: minmax(130px, 0.26fr) minmax(0, 1fr);
    gap: 40px;
  }

  .about-antra-title {
    font-size: clamp(2.8rem, 6vw, 4.8rem);
  }

  .about-antra-bottom {
    grid-template-columns:
      minmax(160px, 0.55fr)
      minmax(250px, 1fr)
      minmax(250px, 0.9fr);

    gap: 38px;
  }

  .about-antra-watermark {
    left: -130px;
    width: 480px;
    height: 480px;
  }

  .about-antra-watermark-space {
    min-height: 330px;
  }
}


/* =========================================================
   ABOUT — TABLET / SMALL LAPTOP
   ========================================================= */

@media (max-width: 900px) {

  .about-antra-heading {
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .about-antra-heading-label {
    padding-top: 0;
  }

  .about-antra-title {
    max-width: 760px;
  }

  .about-antra-visual {
    height: clamp(400px, 67vw, 610px);
    border-radius: 28px;
  }

  .about-antra-statement {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .about-antra-statement::before {
    display: none;
  }

  .about-antra-statement p {
    max-width: 760px;
  }

  .about-antra-bottom {
    grid-template-columns: minmax(180px, 0.6fr) minmax(0, 1fr);
    gap: 45px 55px;
  }

  .about-antra-watermark-space {
    grid-row: 1 / span 2;
    min-height: 420px;
  }

  .about-antra-story {
    grid-column: 2;
  }

  .about-antra-points {
    grid-column: 2;
  }

  .about-antra-watermark {
    left: -140px;
    bottom: 40px;

    width: 500px;
    height: 500px;

    opacity: 0.055;
  }
}


/* =========================================================
   ABOUT — MOBILE
   ========================================================= */

@media (max-width: 640px) {

  .about-antra {
    overflow: hidden;
  }

  .about-antra-heading {
    gap: 24px;
    margin-bottom: 42px;
  }

  .about-antra-title {
    font-size: clamp(2.35rem, 11vw, 3.5rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .about-antra-title br {
    display: none;
  }

  .about-antra-visual {
    height: 72vw;
    min-height: 300px;
    max-height: 430px;

    border-radius: 22px;
  }

  .about-antra-statement {
    padding-top: 46px;
  }

  .about-antra-statement p {
    font-size: clamp(1.75rem, 8vw, 2.55rem);
    line-height: 1.1;
  }

  .about-antra-bottom {
    display: flex;
    flex-direction: column;

    gap: 42px;

    padding-top: 64px;
  }

  .about-antra-watermark-space {
    width: 100%;
    min-height: 220px;
  }

  .about-antra-watermark {
    left: 50%;
    bottom: auto;
    top: auto;

    width: 350px;
    height: 350px;

    transform: translateX(-50%);

    opacity: 0.05;
  }

  .about-antra-story,
  .about-antra-points {
    width: 100%;
  }

  .about-antra-story > p {
    font-size: 0.96rem;
    line-height: 1.8;
  }

  .about-antra-point {
    padding: 17px 0;
  }

  .about-antra-point p {
    font-size: 1rem;
  }
}


/* =========================================================
   ABOUT — REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  .about-antra-cta,
  .about-antra-cta-arrow,
  .about-antra-point > span {
    transition: none;
  }
}


/* =========================================================
   ABOUT — ANTRA IMAGE OFFSET + LEFT PEACOCK WATERMARK
   ========================================================= */

/* Match the same left/right relationship used by the heading */
.about-antra-visual {
  width: auto;

  margin-left: calc(
    (100% - clamp(240px, 26vw, 360px))
  );

  height: clamp(430px, 42vw, 650px);

  border-radius: 24px;
}

/*
  Move the existing Vasupriy logo into the intentionally
  empty left column beside the main image.
*/
.about-antra-watermark {
  top: clamp(390px, 35vw, 500px);
  bottom: auto;

  left: max(
    var(--page-padding),
    calc((100vw - 1200px) / 2)
  );

  width: clamp(220px, 20vw, 320px);
  height: clamp(300px, 29vw, 450px);

  display: flex;
  align-items: center;
  justify-content: center;

  opacity: 0.10;

  overflow: visible;
}

.about-antra-watermark img {
  width: 100%;
  height: 100%;

  object-fit: contain;

  transform: none;

  filter:
    grayscale(1)
    sepia(0.35)
    saturate(0.7);

  mix-blend-mode: multiply;
}

/*
  Old placeholder is no longer required because the watermark
  now belongs to the upper Antra-style empty column.
*/
.about-antra-watermark-space {
  min-height: 0;
}

/* Keep lower section balanced even though its decorative slot is empty */
.about-antra-bottom {
  grid-template-columns:
    minmax(270px, 0.9fr)
    minmax(280px, 0.85fr)
    minmax(310px, 0.9fr);
}


/* =========================================================
   ABOUT — RESPONSIVE IMAGE OFFSET
   ========================================================= */

@media (max-width: 1100px) {

  .about-antra-visual {
    margin-left: 27%;
  }

  .about-antra-watermark {
    left: var(--page-padding);

    width: 210px;
    height: 330px;
  }
}


@media (max-width: 900px) {

  /*
    Tablet: don't force desktop's large empty column.
  */
  .about-antra-visual {
    width: 100%;
    margin-left: 0;

    height: clamp(390px, 62vw, 560px);
  }

  .about-antra-watermark {
    display: none;
  }

  .about-antra-watermark-space {
    display: none;
  }

  .about-antra-bottom {
    grid-template-columns: 1fr 1fr;
  }

  .about-antra-story {
    grid-column: 1;
  }

  .about-antra-points {
    grid-column: 2;
  }
}


@media (max-width: 640px) {

  .about-antra-visual {
    width: 100%;
    margin-left: 0;

    height: 78vw;
    min-height: 300px;
  }

  .about-antra-bottom {
    display: flex;
    flex-direction: column;
  }
}


/* =========================================================
   ABOUT — FIX IMAGE WIDTH / ANTRA 30-70 COMPOSITION
   ========================================================= */

@media (min-width: 901px) {

  .about-antra-visual {
    /*
      Antra reference:
      ~30% decorative space on left
      ~70% large image on right
    */
    width: 72%;
    margin-left: auto;
    margin-right: 0;

    height: clamp(430px, 43vw, 660px);

    border-radius: 24px;
  }

  .about-antra-visual img {
    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    transform: none;
  }

  /*
    Peacock sits in the empty left 28% zone.
  */
  .about-antra-watermark {
    top: clamp(400px, 36vw, 515px);

    left: max(
      var(--page-padding),
      calc((100vw - 1200px) / 2)
    );

    width: clamp(210px, 20vw, 310px);
    height: clamp(300px, 30vw, 440px);

    opacity: 0.10;
  }
}


/* Large desktop — slightly closer to Antra proportions */
@media (min-width: 1280px) {

  .about-antra-visual {
    width: 60%;
  }
}


/* Tablet/mobile remains full width */
@media (max-width: 900px) {

  .about-antra-visual {
    width: 100%;
    margin-left: 0;
    margin-right: 0;
  }
}


/* =========================================================
   ABOUT — ENLARGE LEFT PEACOCK WATERMARK
   ========================================================= */

@media (min-width: 901px) {

  .about-antra-watermark {
    /* Taller peacock inside the 30% decorative column */
    width: clamp(250px, 23vw, 350px);
    height: clamp(440px, 43vw, 650px);

    /* Pull it slightly upward to fill the empty column */
    top: clamp(350px, 31vw, 445px);

    opacity: 0.115;
  }

  .about-antra-watermark img {
    width: 100%;
    height: 100%;

    object-fit: contain;
    object-position: center;

    transform: scale(1.18);
    transform-origin: center;
  }
}


/* Bigger desktop */
@media (min-width: 1280px) {

  .about-antra-watermark {
    width: clamp(280px, 24vw, 380px);
    height: clamp(500px, 46vw, 700px);

    top: clamp(330px, 29vw, 420px);
  }

  .about-antra-watermark img {
    transform: scale(1.24);
  }
}


/* =========================================================
   ABOUT — MATCH ANTRA IMAGE HEIGHT
   ========================================================= */

@media (min-width: 901px) {

  .about-antra-visual {
    width: 60%;
    margin-left: auto;
    margin-right: 0;

    /* Shorter landscape frame like Antra */
    height: clamp(350px, 34vw, 500px);

    border-radius: 24px;
  }

  .about-antra-visual img {
    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;
  }
}

@media (min-width: 1280px) {

  .about-antra-visual {
    height: clamp(390px, 32vw, 500px);
  }
}


/* =========================================================
   ABOUT — VISUAL STORY + HIGHLIGHTS
   Same About section / Antra-inspired composition
   ========================================================= */

.about-showcase {
  position: relative;
  z-index: 3;

  width: min(
    calc(100% - (var(--page-padding) * 2)),
    1180px
  );

  margin: clamp(115px, 10vw, 165px) auto 0;
}


/* =========================================================
   STAGGERED 3-IMAGE GALLERY
   ========================================================= */

.about-showcase-gallery {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));

  gap: clamp(22px, 2.8vw, 42px);

  align-items: start;

  /* width: min(100%, 1020px); */
  margin: 0 auto;
}

.about-showcase-image {
  position: relative;

  margin: 0;

  height: clamp(310px, 30vw, 405px);

  overflow: hidden;

  border-radius: 18px;

  background: rgba(14, 41, 67, 0.08);
}

.about-showcase-image--one {
  margin-top: 0;
}

.about-showcase-image--two {
  margin-top: clamp(34px, 3.5vw, 55px);
}

.about-showcase-image--three {
  margin-top: clamp(70px, 7vw, 105px);
}

.about-showcase-image img {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;
  object-position: center;

  transition:
    transform 900ms cubic-bezier(0.2, 0.75, 0.25, 1);
}

.about-showcase-image:is(:hover, :focus-within) img {
  transform: scale(1.035);
}


/* =========================================================
   FOUR HIGHLIGHT COLUMNS
   ========================================================= */

.about-showcase-highlights {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));

  gap: clamp(24px, 3vw, 44px);

  margin-top: clamp(115px, 10vw, 155px);
}

.about-showcase-highlight {
  min-width: 0;
}

.about-showcase-highlight > strong {
  display: block;

  min-height: 1.1em;
  margin-bottom: clamp(14px, 1.4vw, 20px);

  color: var(--color-navy-deep);

  font-family: var(--font-heading);
  font-size: clamp(2rem, 2.55vw, 3rem);
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.045em;
}

.about-showcase-highlight-copy {
  padding-top: 18px;

  border-top: 1px solid rgba(14, 41, 67, 0.22);
}

.about-showcase-highlight h3 {
  margin: 0 0 12px;

  color: var(--color-navy-deep);

  font-size: clamp(0.82rem, 0.9vw, 0.95rem);
  font-weight: 700;
  line-height: 1.3;
}

.about-showcase-highlight p {
  margin: 0;

  max-width: 220px;

  color: rgba(41, 41, 41, 0.66);

  font-size: clamp(0.7rem, 0.72vw, 0.78rem);
  line-height: 1.55;
}


/* =========================================================
   SUBTLE DECORATIVE RULE
   ========================================================= */

.about-showcase::before {
  content: '';

  position: absolute;

  top: -58px;
  left: 50%;

  width: min(92%, 1050px);
  height: 1px;

  transform: translateX(-50%);

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(14, 41, 67, 0.11) 16%,
      rgba(14, 41, 67, 0.11) 84%,
      transparent
    );
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 900px) {

  .about-showcase {
    margin-top: 105px;
  }

  .about-showcase-gallery {
    gap: 18px;
  }

  .about-showcase-image {
    height: clamp(250px, 37vw, 340px);

    border-radius: 16px;
  }

  .about-showcase-image--two {
    margin-top: 30px;
  }

  .about-showcase-image--three {
    margin-top: 60px;
  }

  .about-showcase-highlights {
    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 52px 32px;

    margin-top: 105px;
  }

  .about-showcase-highlight > strong {
    font-size: clamp(2.1rem, 5vw, 2.8rem);
  }

  .about-showcase-highlight p {
    max-width: 300px;
  }
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 640px) {

  .about-showcase {
    width: calc(100% - (var(--page-padding) * 2));

    margin-top: 82px;
  }

  .about-showcase::before {
    top: -40px;
  }

  .about-showcase-gallery {
    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 13px;

    width: 100%;
  }

  .about-showcase-image {
    height: clamp(230px, 59vw, 320px);

    border-radius: 13px;
  }

  .about-showcase-image--one {
    margin-top: 0;
  }

  .about-showcase-image--two {
    margin-top: 32px;
  }

  .about-showcase-image--three {
    grid-column: 2;

    width: 88%;

    margin-top: -5px;
    margin-left: 12%;
  }

  .about-showcase-highlights {
    grid-template-columns: 1fr;

    gap: 40px;

    margin-top: 72px;
  }

  .about-showcase-highlight > strong {
    margin-bottom: 14px;

    font-size: clamp(2rem, 9vw, 2.65rem);
  }

  .about-showcase-highlight-copy {
    display: grid;
    grid-template-columns: minmax(110px, 0.38fr) 1fr;

    gap: 22px;

    padding-top: 15px;
  }

  .about-showcase-highlight h3 {
    margin: 0;
  }

  .about-showcase-highlight p {
    max-width: none;

    font-size: 0.76rem;
  }
}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  .about-showcase-image img {
    transition: none;
  }

  .about-showcase-image:is(:hover, :focus-within) img {
    transform: none;
  }
}


/* =========================================================
   ABOUT WATERMARK — HEIGHT ONLY
   ========================================================= */

@media (min-width: 901px) {
  .about-antra-watermark {
    height: clamp(620px, 58vw, 880px);
  }
}

@media (min-width: 1280px) {
  .about-antra-watermark {
    height: clamp(680px, 62vw, 940px);
  }
}


/* =========================================================
   ABOUT WATERMARK — FILL COMPLETE LEFT EMPTY COLUMN
   Only watermark sizing / vertical coverage changed
   ========================================================= */

@media (min-width: 901px) {

  .about-antra-watermark {
    top: 250px;

    width: clamp(300px, 27vw, 410px);
    height: clamp(900px, 88vw, 1280px);

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: visible;
  }

  .about-antra-watermark img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: contain;
    object-position: center;

    transform: scale(1.12);
    transform-origin: center;
  }
}


@media (min-width: 1280px) {

  .about-antra-watermark {
    top: 230px;

    width: clamp(320px, 28vw, 430px);
    height: clamp(1000px, 90vw, 1350px);
  }

}


/* =========================================================
   ABOUT PEACOCK WATERMARK
   FINAL — HEIGHT-DRIVEN LEFT COLUMN FILL
   ========================================================= */

@media (min-width: 901px) {

  .about-antra-watermark {
    position: absolute;

    top: 185px;
    left: max(
      var(--page-padding),
      calc((100vw - 1200px) / 2)
    );

    width: 30%;
    height: 1050px;

    display: flex;
    align-items: flex-start;
    justify-content: center;

    overflow: visible;

    pointer-events: none;

    opacity: 0.10;
  }

  .about-antra-watermark img {
    /* IMPORTANT:
       Height controls logo size now — not width */
    width: auto;
    max-width: none;

    height: 100%;
    max-height: none;

    display: block;

    object-fit: contain;

    transform: none;
  }
}


@media (min-width: 1280px) {

  .about-antra-watermark {
    top: 175px;

    width: 31%;
    height: 1150px;
  }

}


/* =========================================================
   HOME — 3D VISUAL + OUR EXPERTISE
   ========================================================= */

.home-expertise {
  --expertise-scroll: 0;

  position: relative;
  isolation: isolate;

  margin-top: 0;

  background: var(--color-navy-deep, #0e2943);
  color: #fff;

  overflow: clip;
}


/* ---------- 3D TRANSITION AREA ---------- */

.home-expertise-visual {
  position: relative;
  z-index: 3;

  height: clamp(390px, 47vw, 650px);

  background: var(--color-ivory, #f5f0ea);

  overflow: visible;
}

.home-expertise-visual::before {
  content: '';

  position: absolute;
  inset: auto 0 0;

  height: 34%;

  background: var(--color-navy-deep, #0e2943);
}

.home-expertise-visual-inner {
  position: absolute;
  z-index: 2;

  left: 50%;
  bottom: clamp(-80px, -5vw, -45px);

  width: min(88vw, 1080px);

  transform:
    translate3d(
      -50%,
      calc(var(--expertise-scroll) * -70px),
      0
    );

  will-change: transform;
}

.home-expertise-floor-plan {
  display: block;

  width: 100%;
  height: auto;

  object-fit: contain;

  filter:
    drop-shadow(0 32px 35px rgba(0, 0, 0, 0.18));

  user-select: none;
  pointer-events: none;
}


/* ---------- DARK EXPERTISE BODY ---------- */

.home-expertise-body {
  position: relative;
  z-index: 1;

  padding:
    clamp(105px, 10vw, 155px)
    0
    clamp(110px, 12vw, 180px);

  background: var(--color-navy-deep, #0e2943);
}

.home-expertise-container {
  position: relative;
  z-index: 2;
}


/* ---------- LABEL ---------- */

.home-expertise-label {
  display: inline-flex;
  align-items: center;
  gap: 10px;

  margin-bottom: clamp(24px, 3vw, 42px);

  padding: 8px 16px;

  border: 1px solid rgba(255, 255, 255, 0.28);
  border-radius: 999px;

  color: rgba(255, 255, 255, 0.92);

  font-size: 0.72rem;
  font-weight: 700;

  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.home-expertise-label i {
  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: var(--color-gold, #d7b77d);
}


/* ---------- HEADING ---------- */

.home-expertise-heading {
  max-width: 1050px;
}

.home-expertise-heading h2 {
  margin: 0;

  max-width: 1000px;

  color: #fff;

  font-family: var(--font-heading);
  font-size: clamp(3rem, 6vw, 6.4rem);
  font-weight: 500;
  line-height: 0.96;

  letter-spacing: -0.055em;
}

.home-expertise-heading h2 em {
  color: var(--color-gold, #d7b77d);

  font-family: inherit;
  font-style: normal;
}


/* ---------- STAGGERED CARDS ---------- */

.home-expertise-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));

  gap: clamp(20px, 2vw, 32px);

  align-items: start;

  margin-top: clamp(75px, 9vw, 130px);
}

.home-expertise-card {
  min-width: 0;
}

.home-expertise-card--two {
  margin-top: 60px;
}

.home-expertise-card--three {
  margin-top: 120px;
}

.home-expertise-card--four {
  margin-top: 180px;
}

.home-expertise-card-image {
  position: relative;

  width: 100%;
  aspect-ratio: 1.15 / 1;

  overflow: hidden;

  border-radius: 20px;
}

.home-expertise-card-image img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  transition:
    transform 900ms cubic-bezier(0.2, 0.75, 0.25, 1);
}

.home-expertise-card:hover .home-expertise-card-image img {
  transform: scale(1.045);
}

.home-expertise-card-copy {
  position: relative;

  margin-top: 22px;
  padding-top: 17px;

  border-top: 1px solid rgba(255, 255, 255, 0.2);
}

.home-expertise-card-copy > span {
  position: absolute;

  top: 18px;
  right: 0;

  color: var(--color-gold, #d7b77d);

  font-size: 0.7rem;
  font-weight: 700;
}

.home-expertise-card h3 {
  margin: 0;

  max-width: 82%;

  color: #fff;

  font-family: var(--font-heading);
  font-size: clamp(1.25rem, 1.7vw, 1.75rem);
  font-weight: 600;
  line-height: 1.1;

  letter-spacing: -0.025em;
}

.home-expertise-card p {
  margin: 14px 0 0;

  max-width: 95%;

  color: rgba(255, 255, 255, 0.62);

  font-size: clamp(0.75rem, 0.8vw, 0.86rem);
  line-height: 1.6;
}


/* ---------- TABLET ---------- */

@media (max-width: 900px) {

  .home-expertise-visual {
    height: clamp(330px, 54vw, 470px);
  }

  .home-expertise-visual-inner {
    width: 94vw;
  }

  .home-expertise-heading h2 {
    font-size: clamp(3rem, 8vw, 5rem);
  }

  .home-expertise-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 50px 24px;
  }

  .home-expertise-card--two {
    margin-top: 55px;
  }

  .home-expertise-card--three {
    margin-top: 0;
  }

  .home-expertise-card--four {
    margin-top: 55px;
  }
}


/* ---------- MOBILE ---------- */

@media (max-width: 640px) {

  .home-expertise-visual {
    height: 300px;
  }

  .home-expertise-visual::before {
    height: 30%;
  }

  .home-expertise-visual-inner {
    bottom: -25px;

    width: 115vw;
  }

  .home-expertise-body {
    padding-top: 80px;
  }

  .home-expertise-heading h2 {
    font-size: clamp(2.7rem, 13vw, 4.2rem);
  }

  .home-expertise-grid {
    grid-template-columns: 1fr;

    gap: 48px;

    margin-top: 65px;
  }

  .home-expertise-card--two,
  .home-expertise-card--three,
  .home-expertise-card--four {
    margin-top: 0;
  }

  .home-expertise-card-image {
    aspect-ratio: 1.4 / 1;
  }
}


/* ---------- REDUCED MOTION ---------- */

@media (prefers-reduced-motion: reduce) {

  .home-expertise-visual-inner {
    transform: translateX(-50%);
  }

  .home-expertise-card-image img {
    transition: none;
  }

  .home-expertise-card:hover .home-expertise-card-image img {
    transform: none;
  }
}


/* =========================================================
   OUR EXPERTISE — REFERENCE IMAGE CARD TUNING
   JSX unchanged
   ========================================================= */

@media (min-width: 901px) {

  .home-expertise-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: clamp(22px, 2vw, 34px);

    align-items: start;

    margin-top: clamp(80px, 8vw, 125px);
    padding-bottom: clamp(30px, 4vw, 60px);
  }

  .home-expertise-card {
    width: 100%;
    min-width: 0;
  }

  /* Reference-style staircase */

  .home-expertise-card--one {
    margin-top: 0;
  }

  .home-expertise-card--two {
    margin-top: 70px;
  }

  .home-expertise-card--three {
    margin-top: 135px;
  }

  .home-expertise-card--four {
    margin-top: 200px;
  }

  /* Larger visual cards */

  .home-expertise-card-image {
    position: relative;

    width: 100%;
    height: clamp(260px, 23vw, 350px);

    overflow: hidden;

    border-radius: 18px;

    background: rgba(255,255,255,0.06);
  }

  .home-expertise-card-image img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    transform: scale(1.001);

    transition:
      transform 900ms cubic-bezier(.2,.75,.25,1);
  }

  .home-expertise-card:hover .home-expertise-card-image img {
    transform: scale(1.045);
  }

  /* Text directly below image */

  .home-expertise-card-copy {
    position: relative;

    margin-top: 22px;
    padding-top: 0;

    border-top: 0;
  }

  .home-expertise-card-copy::after {
    content: '';

    display: block;

    width: 100%;
    height: 1px;

    margin-top: 22px;

    background: rgba(255,255,255,0.18);
  }

  .home-expertise-card-copy > span {
    position: absolute;

    top: 3px;
    right: 0;

    color: var(--color-gold, #d7b77d);

    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: .08em;
  }

  .home-expertise-card h3 {
    margin: 0;

    max-width: 82%;

    color: #fff;

    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 1.65vw, 1.85rem);
    font-weight: 600;
    line-height: 1.08;

    letter-spacing: -0.035em;
  }

  .home-expertise-card p {
    margin: 15px 0 0;

    max-width: 92%;

    color: rgba(255,255,255,0.62);

    font-size: clamp(.74rem, .78vw, .84rem);
    line-height: 1.6;
  }
}


/* =========================================================
   TABLET
   ========================================================= */

@media (min-width: 641px) and (max-width: 900px) {

  .home-expertise-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 55px 24px;
  }

  .home-expertise-card-image {
    height: clamp(280px, 43vw, 390px);
  }

  .home-expertise-card--one,
  .home-expertise-card--three {
    margin-top: 0;
  }

  .home-expertise-card--two,
  .home-expertise-card--four {
    margin-top: 65px;
  }
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 640px) {

  .home-expertise-grid {
    display: grid;
    grid-template-columns: 1fr;

    gap: 55px;

    margin-top: 65px;
  }

  .home-expertise-card--one,
  .home-expertise-card--two,
  .home-expertise-card--three,
  .home-expertise-card--four {
    margin-top: 0;
  }

  .home-expertise-card-image {
    width: 100%;
    height: auto;

    aspect-ratio: 1.35 / 1;

    border-radius: 16px;
  }

  .home-expertise-card-copy {
    margin-top: 18px;
    padding-top: 0;

    border-top: 0;
  }

  .home-expertise-card-copy::after {
    content: '';

    display: block;

    width: 100%;
    height: 1px;

    margin-top: 20px;

    background: rgba(255,255,255,0.18);
  }
}


/* =========================================================
   OUR EXPERTISE — BEFORE / AFTER TRANSFORMATION
   ========================================================= */

.expertise-transformation {
  position: relative;

  /* margin-top: clamp(130px, 14vw, 220px); */
}

.expertise-transformation-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 30px;

  margin-bottom: 28px;
}

.expertise-transformation-heading > span {
  color: var(--color-gold, #d7b77d);

  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.expertise-transformation-heading p {
  max-width: 360px;

  margin: 0;

  color: rgba(255,255,255,0.58);

  font-size: 0.78rem;
  line-height: 1.55;
}


/* ---------- MAIN COMPARISON ---------- */

.before-after-comparison {
  --comparison-position: 50%;

  position: relative;

  width: 100%;
  height: clamp(500px, 57vw, 760px);

  overflow: hidden;

  border-radius: clamp(20px, 2vw, 30px);

  background: rgba(255,255,255,0.06);

  cursor: ew-resize;

  user-select: none;
  touch-action: none;

  box-shadow:
    0 35px 80px rgba(0,0,0,0.18);
}

.before-after-image {
  position: absolute;

  inset: 0;

  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
  object-position: center;

  pointer-events: none;
}


/* AFTER is base/full image */

.before-after-image--after {
  z-index: 1;
}


/* BEFORE sits on top and is clipped */

.before-after-after-layer {
  position: absolute;

  z-index: 2;

  inset: 0;

  width: var(--comparison-position);

  overflow: hidden;

  pointer-events: none;
}

.before-after-after-layer .before-after-image {
  width: 100vw;
  max-width: none;
}


/* Important: keep overlay image same visual width */

.before-after-after-layer .before-after-image--after {
  width: min(
    calc(100vw - (var(--page-padding) * 2)),
    1200px
  );

  max-width: none;
}


/* BEFORE image is the visible base */

.before-after-image--before {
  z-index: 0;
}


/* ---------- DIVIDER ---------- */

.before-after-divider {
  position: absolute;

  z-index: 5;

  top: 0;
  bottom: 0;

  left: var(--comparison-position);

  width: 2px;

  transform: translateX(-50%);

  background: var(--color-gold, #d7b77d);

  outline: none;

  pointer-events: none;
}

.before-after-divider::before,
.before-after-divider::after {
  content: '';

  position: absolute;

  left: 50%;

  width: 7px;
  height: 7px;

  transform: translateX(-50%);

  border-radius: 50%;

  background: var(--color-gold, #d7b77d);
}

.before-after-divider::before {
  top: 0;
}

.before-after-divider::after {
  bottom: 0;
}


/* ---------- HANDLE ---------- */

.before-after-handle {
  position: absolute;

  top: 50%;
  left: 50%;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 8px;

  width: 62px;
  height: 62px;

  transform: translate(-50%, -50%);

  border: 1px solid rgba(215,183,125,0.7);
  border-radius: 50%;

  background: var(--color-navy-deep, #0e2943);

  color: var(--color-gold, #d7b77d);

  box-shadow:
    0 10px 35px rgba(0,0,0,0.28);

  font-size: 1.4rem;
  line-height: 1;
}

.before-after-comparison--dragging .before-after-handle {
  transform:
    translate(-50%, -50%)
    scale(1.08);
}


/* ---------- LABELS ---------- */

.before-after-label {
  position: absolute;

  z-index: 4;

  bottom: 25px;

  padding: 9px 15px;

  border: 1px solid rgba(255,255,255,0.22);
  border-radius: 999px;

  background: rgba(14,41,67,0.68);

  color: #fff;

  backdrop-filter: blur(10px);

  font-size: 0.68rem;
  font-weight: 700;

  letter-spacing: 0.08em;
  text-transform: uppercase;

  pointer-events: none;
}

.before-after-label--before {
  left: 25px;
}

.before-after-label--after {
  right: 25px;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 640px) {

  .expertise-transformation {
    margin-top: 90px;
  }

  .expertise-transformation-heading {
    display: block;

    margin-bottom: 20px;
  }

  .expertise-transformation-heading p {
    margin-top: 12px;
  }

  .before-after-comparison {
    height: 115vw;
    max-height: 560px;

    border-radius: 18px;
  }

  .before-after-handle {
    width: 52px;
    height: 52px;
  }

  .before-after-label {
    bottom: 16px;
  }

  .before-after-label--before {
    left: 16px;
  }

  .before-after-label--after {
    right: 16px;
  }
}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  .before-after-handle {
    transition: none;
  }
}


/* =========================================================
   EXPERTISE SKILLS SHOWCASE
   Reference-inspired / Vasupriy theme
   ========================================================= */

.expertise-showcase {
  position: relative;
  isolation: isolate;

  overflow: hidden;

  padding:
    clamp(85px, 9vw, 135px)
    0
    clamp(55px, 6vw, 90px);

  background: #f7f5f1;
  color: #151515;
}

.expertise-showcase-container {
  position: relative;
  z-index: 2;
}


/* =========================================================
   SUBTLE ARCHITECTURAL BACKGROUND
   ========================================================= */

.expertise-showcase-blueprint {
  position: absolute;
  z-index: 0;

  top: 0;
  right: -80px;

  width: min(39vw, 590px);
  height: 72%;

  opacity: 0.34;

  pointer-events: none;

  background:
    linear-gradient(
      135deg,
      transparent 0 47%,
      rgba(14, 41, 67, 0.08) 47.15% 47.4%,
      transparent 47.55% 100%
    ),
    linear-gradient(
      45deg,
      transparent 0 66%,
      rgba(14, 41, 67, 0.055) 66.1% 66.35%,
      transparent 66.5% 100%
    ),
    repeating-linear-gradient(
      135deg,
      transparent 0 31px,
      rgba(14, 41, 67, 0.045) 31px 32px,
      transparent 32px 64px
    );

  transform: rotate(-3deg);
}


/* =========================================================
   TOP HEADING
   ========================================================= */

.expertise-showcase-heading {
  display: grid;
  grid-template-columns:
    minmax(220px, 30%)
    minmax(0, 1fr);

  gap: clamp(45px, 7vw, 105px);

  align-items: start;
}

.expertise-showcase-heading-space {
  padding-top: 8px;
}

.expertise-showcase-label {
  display: inline-flex;
  align-items: center;

  gap: 8px;

  min-height: 29px;

  padding: 7px 13px;

  border: 1px solid rgba(14, 41, 67, 0.17);
  border-radius: 999px;

  background: rgba(255,255,255,0.46);

  color: #202020;

  font-size: 0.64rem;
  font-weight: 700;

  line-height: 1;

  letter-spacing: 0.07em;
  text-transform: uppercase;
}

.expertise-showcase-label i {
  display: block;

  width: 5px;
  height: 5px;

  flex: 0 0 5px;

  border-radius: 50%;

  background: #d7b77d;
}

.expertise-showcase-heading h2 {
  max-width: 850px;

  margin: 0;

  color: #151515;

  font-family: var(--font-heading);
  font-size: clamp(3rem, 5.2vw, 5.35rem);
  font-weight: 600;

  line-height: 0.96;

  letter-spacing: -0.055em;
}

.expertise-showcase-heading h2 em {
  color: #d7b77d;

  font-family: inherit;
  font-style: normal;
  font-weight: inherit;
}


/* =========================================================
   LOWER CONTENT
   ========================================================= */

.expertise-showcase-content {
  display: grid;
  grid-template-columns:
    minmax(300px, 31%)
    minmax(0, 1fr);

  gap: clamp(60px, 10vw, 150px);

  align-items: end;

  margin-top: clamp(65px, 7vw, 105px);
}


/* =========================================================
   LEFT INFORMATION
   ========================================================= */

.expertise-showcase-info {
  position: relative;
  z-index: 3;

  padding-bottom: clamp(65px, 8vw, 115px);
}

.expertise-showcase-intro {
  max-width: 390px;

  margin: 0;

  color: rgba(21,21,21,0.68);

  font-size: clamp(0.9rem, 1vw, 1.02rem);

  line-height: 1.65;
}

.expertise-showcase-skills {
  display: grid;

  gap: 30px;

  margin-top: clamp(36px, 4vw, 55px);
}

.expertise-showcase-skill {
  width: 100%;
}

.expertise-showcase-skill-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 9px;
}

.expertise-showcase-skill-heading strong {
  color: #1b1b1b;

  font-size: clamp(0.82rem, 0.9vw, 0.94rem);
  font-weight: 700;

  letter-spacing: -0.025em;
}

.expertise-showcase-skill-heading span {
  color: #c79e58;

  font-size: 0.8rem;
  font-weight: 800;
}


/* =========================================================
   PROGRESS BARS
   ========================================================= */

.expertise-showcase-progress {
  position: relative;

  width: 100%;
  height: 2px;

  overflow: visible;

  background: rgba(14, 41, 67, 0.13);
}

.expertise-showcase-progress > span {
  position: absolute;

  top: 0;
  left: 0;

  display: block;

  width: var(--skill-width);
  height: 2px;

  background: #0e2943;
}

.expertise-showcase-progress > span::after {
  content: '';

  position: absolute;

  top: 50%;
  right: -1px;

  width: 9px;
  height: 2px;

  background: #0e2943;

  transform:
    translateY(-50%)
    rotate(-58deg);

  transform-origin: right center;
}


/* =========================================================
   RIGHT INTERIOR VISUAL
   ========================================================= */

.expertise-showcase-visual {
  position: relative;
  z-index: 3;

  display: flex;
  align-items: flex-end;
  justify-content: flex-end;

  min-width: 0;
  min-height: clamp(360px, 39vw, 570px);
}

.expertise-showcase-visual img {
  display: block;

  width: min(100%, 790px);
  max-height: 590px;

  margin-left: auto;

  object-fit: contain;
  object-position: right bottom;

  filter:
    drop-shadow(0 22px 26px rgba(14, 41, 67, 0.10));
}


/* =========================================================
   LARGE FAINT WORDMARK
   ========================================================= */

.expertise-showcase-wordmark {
  position: absolute;
  z-index: 1;

  left: clamp(-10px, -1vw, 0px);
  bottom: clamp(-58px, -4vw, -28px);

  color: rgba(14, 41, 67, 0.045);

  font-family: var(--font-heading);
  font-size: clamp(8rem, 18vw, 17rem);
  font-weight: 700;

  line-height: 0.72;

  letter-spacing: -0.09em;

  white-space: nowrap;

  pointer-events: none;
  user-select: none;
}


/* =========================================================
   LARGE DESKTOP
   ========================================================= */

@media (min-width: 1280px) {

  .expertise-showcase-content {
    grid-template-columns:
      minmax(330px, 30%)
      minmax(0, 1fr);
  }

  .expertise-showcase-visual {
    min-height: 550px;
  }

  .expertise-showcase-visual img {
    width: min(100%, 820px);
  }
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 900px) {

  .expertise-showcase {
    padding:
      85px
      0
      65px;
  }

  .expertise-showcase-heading {
    grid-template-columns: 1fr;

    gap: 28px;
  }

  .expertise-showcase-heading h2 {
    max-width: 760px;

    font-size: clamp(2.7rem, 8vw, 4.7rem);
  }

  .expertise-showcase-content {
    grid-template-columns:
      minmax(240px, 0.8fr)
      minmax(0, 1.2fr);

    gap: 45px;

    margin-top: 70px;
  }

  .expertise-showcase-info {
    padding-bottom: 40px;
  }

  .expertise-showcase-visual {
    min-height: 370px;
  }

  .expertise-showcase-blueprint {
    width: 55vw;
  }

  .expertise-showcase-wordmark {
    font-size: 21vw;
  }
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 640px) {

  .expertise-showcase {
    padding:
      70px
      0
      50px;
  }

  .expertise-showcase-heading {
    gap: 24px;
  }

  .expertise-showcase-heading h2 {
    font-size: clamp(2.45rem, 12vw, 3.65rem);

    line-height: 0.98;
  }

  .expertise-showcase-content {
    display: flex;
    flex-direction: column;

    gap: 45px;

    margin-top: 48px;
  }

  .expertise-showcase-info {
    width: 100%;

    padding-bottom: 0;
  }

  .expertise-showcase-intro {
    max-width: 100%;
  }

  .expertise-showcase-skills {
    gap: 27px;

    margin-top: 38px;
  }

  .expertise-showcase-visual {
    width: 100%;

    min-height: 0;

    margin-top: 10px;
  }

  .expertise-showcase-visual img {
    width: 110%;
    max-width: none;

    margin-left: -5%;
  }

  .expertise-showcase-blueprint {
    top: 32%;

    width: 90vw;
    height: 50%;

    opacity: 0.22;
  }

  .expertise-showcase-wordmark {
    left: -4%;
    bottom: -15px;

    font-size: 27vw;

    opacity: 0.9;
  }
}


/* =========================================================
   FOOTER — FULL PEACOCK WATERMARK
   Same brand artwork used in About
   ========================================================= */

.site-footer {
  position: relative;
  isolation: isolate;
  overflow: hidden;
}


/* Giant watermark behind the COMPLETE footer */

.footer-peacock-watermark {
  position: absolute;
  z-index: 0;

  inset: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;

  pointer-events: none;
  user-select: none;

  opacity: 0.055;
}


/*
   Height-driven sizing is intentional.
   About section taught us that width-constrained contain
   keeps the peacock visually too small.
*/

.footer-peacock-watermark img {
  display: block;

  width: auto;
  max-width: none;

  height: 118%;
  max-height: none;

  object-fit: contain;
  object-position: center;

  transform: none;

  filter: grayscale(1) brightness(2.5);
}


/* Keep ALL actual footer content above watermark */

.footer-top,
.footer-main,
.footer-bottom {
  position: relative;
  z-index: 2;
}


/* Make sure internal containers remain above artwork */

.footer-top .site-container,
.footer-main .site-container,
.footer-bottom .site-container {
  position: relative;
  z-index: 3;
}


/* =========================================================
   LARGE DESKTOP
   ========================================================= */

@media (min-width: 1280px) {

  .footer-peacock-watermark img {
    height: 128%;
  }
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 900px) {

  .footer-peacock-watermark {
    opacity: 0.05;
  }

  .footer-peacock-watermark img {
    height: 105%;
  }
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 640px) {

  .footer-peacock-watermark {
    align-items: center;

    opacity: 0.045;
  }

  .footer-peacock-watermark img {
    width: auto;
    max-width: none;

    height: 88%;
  }
}


/* =========================================================
   VASUPRIY — ANTRA HOME 4 HERO
   ========================================================= */

.antra4-hero {
  position: relative;
  isolation: isolate;
  overflow: hidden;

  min-height: clamp(720px, 88vh, 940px);

  padding-top: clamp(135px, 11vw, 175px);
  padding-bottom: clamp(60px, 7vw, 90px);

  color: var(--color-navy-deep);
  background:
    radial-gradient(
      circle at 11% 42%,
      rgba(215, 183, 125, 0.13),
      transparent 25%
    ),
    linear-gradient(
      135deg,
      #f8f5f0 0%,
      #f4efe8 48%,
      #f8f5f0 100%
    );
}


/* ---------------------------------------------------------
   Main layout
   --------------------------------------------------------- */

.antra4-hero-container {
  position: relative;
  z-index: 3;

  display: grid;
  grid-template-columns: minmax(0, 1.03fr) minmax(430px, 0.97fr);
  align-items: center;

  gap: clamp(45px, 5vw, 82px);
}


/* ---------------------------------------------------------
   Left content
   --------------------------------------------------------- */

.antra4-hero-copy {
  position: relative;
  z-index: 4;

  max-width: 760px;
}


/* Badge */

.antra4-hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 10px;

  margin-bottom: clamp(24px, 3vw, 38px);

  color: var(--color-navy-deep);

  font-size: 0.68rem;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.antra4-hero-badge > span:first-child {
  display: grid;

  width: 25px;
  height: 25px;

  place-items: center;

  color: var(--color-gold);

  font-size: 0.9rem;

  border: 1px solid rgba(14, 41, 67, 0.18);
  border-radius: 50%;
}


/* ---------------------------------------------------------
   Heading
   --------------------------------------------------------- */

.antra4-hero-title {
  position: relative;
  z-index: 2;

  display: flex;
  flex-direction: column;

  width: max-content;
  max-width: 100%;

  margin: 0;

  color: var(--color-navy-deep);

  font-family: var(--font-display);
  font-size: clamp(4.7rem, 6.35vw, 7.25rem);
  font-weight: 400;
  line-height: 0.88;
  letter-spacing: -0.055em;
}

.antra4-title-line {
  display: block;
}

.antra4-title-line--mixed {
  display: flex;
  align-items: center;

  gap: clamp(12px, 1.35vw, 22px);

  white-space: nowrap;
}

.antra4-hero-title em {
  color: var(--color-gold);

  font-family: inherit;
  font-weight: 400;
  font-style: italic;
}


/* ---------------------------------------------------------
   Small Antra-style image / video capsule
   --------------------------------------------------------- */

.antra4-video-pill {
  position: relative;

  display: inline-block;
  flex: 0 0 auto;

  width: clamp(92px, 8.3vw, 132px);
  height: clamp(45px, 4.1vw, 62px);

  overflow: hidden;

  border-radius: 999px;

  box-shadow:
    0 12px 28px rgba(14, 41, 67, 0.13);
}

.antra4-video-pill::after {
  content: '';

  position: absolute;
  inset: 0;

  background: rgba(8, 29, 47, 0.14);

  pointer-events: none;
}

.antra4-video-pill img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
}

.antra4-video-play {
  position: absolute;
  z-index: 2;
  top: 50%;
  left: 50%;

  display: grid;

  width: clamp(29px, 2.5vw, 38px);
  height: clamp(29px, 2.5vw, 38px);

  place-items: center;

  color: var(--color-navy-deep);
  background: rgba(255, 255, 255, 0.94);

  font-size: clamp(0.48rem, 0.6vw, 0.65rem);

  border-radius: 50%;

  transform: translate(-50%, -50%);

  box-shadow: 0 6px 18px rgba(14, 41, 67, 0.14);
}


/* ---------------------------------------------------------
   Lower copy + CTA
   --------------------------------------------------------- */

.antra4-hero-lower {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: clamp(25px, 3vw, 50px);

  max-width: 650px;

  margin-top: clamp(34px, 4vw, 54px);
}

.antra4-hero-description {
  max-width: 390px;

  margin: 0;

  color: rgba(41, 41, 41, 0.72);

  font-size: clamp(0.94rem, 1vw, 1.05rem);
  font-weight: 400;
  line-height: 1.8;
}


/* CTA */

.antra4-hero-cta {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;

  min-height: 56px;

  padding: 7px 7px 7px 23px;

  color: var(--color-navy-deep);
  background: transparent;

  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-decoration: none;
  text-transform: uppercase;

  border: 1px solid rgba(14, 41, 67, 0.42);
  border-radius: 999px;

  transition:
    color 300ms ease,
    background 300ms ease,
    border-color 300ms ease,
    transform 300ms ease;
}

.antra4-hero-cta > span:first-child {
  padding-right: 18px;
}

.antra4-hero-cta-arrow {
  display: grid;

  width: 42px;
  height: 42px;

  place-items: center;

  color: var(--color-navy-deep);
  background: var(--color-gold);

  font-size: 1rem;

  border-radius: 50%;

  transition:
    color 300ms ease,
    background 300ms ease,
    transform 300ms ease;
}

.antra4-hero-cta:hover {
  color: #fff;
  background: var(--color-navy-deep);
  border-color: var(--color-navy-deep);

  transform: translateY(-2px);
}

.antra4-hero-cta:hover .antra4-hero-cta-arrow {
  background: #fff;

  transform: rotate(45deg);
}


/* ---------------------------------------------------------
   Right image
   --------------------------------------------------------- */

.antra4-hero-visual {
  position: relative;

  z-index: 2;

  min-width: 0;
}

.antra4-hero-image-frame {
  position: relative;

  width: 100%;
  height: clamp(520px, 43vw, 690px);

  overflow: hidden;

  border-radius: 38px;

  box-shadow:
    0 35px 70px rgba(14, 41, 67, 0.12);
}

.antra4-hero-image-frame::after {
  content: '';

  position: absolute;
  inset: 0;

  pointer-events: none;

  border: 1px solid rgba(255, 255, 255, 0.42);
  border-radius: inherit;
}

.antra4-hero-image-frame img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
  object-position: center;

  transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
}

.antra4-hero:hover .antra4-hero-image-frame img {
  transform: scale(1.025);
}


/* Decorative navy circle */

.antra4-hero-dot {
  position: absolute;
  z-index: 5;

  top: 48%;
  left: -30px;

  width: 58px;
  height: 58px;

  background: var(--color-navy-deep);

  border: 8px solid #f5f0ea;
  border-radius: 50%;

  transform: translateY(-50%);

  box-shadow: 0 10px 25px rgba(14, 41, 67, 0.14);
}


/* ---------------------------------------------------------
   Architectural / blueprint atmosphere
   --------------------------------------------------------- */

.antra4-hero-blueprint {
  position: absolute;
  z-index: 0;

  top: 0;
  bottom: 0;
  left: 0;

  width: 55%;

  overflow: hidden;

  opacity: 0.55;

  pointer-events: none;
}

.antra4-hero-blueprint::before {
  content: '';

  position: absolute;

  top: 13%;
  left: -5%;

  width: 76%;
  height: 72%;

  border:
    1px solid rgba(14, 41, 67, 0.075);

  border-radius: 50% 50% 8% 8%;
  transform: rotate(-9deg);
}

.antra4-hero-blueprint::after {
  content: '';

  position: absolute;

  top: 22%;
  left: 9%;

  width: 48%;
  height: 55%;

  border-top: 1px solid rgba(14, 41, 67, 0.08);
  border-right: 1px solid rgba(14, 41, 67, 0.08);

  transform: skew(-11deg) rotate(-8deg);
}

.antra4-blueprint-line {
  position: absolute;

  display: block;

  border-color: rgba(14, 41, 67, 0.07);
  border-style: solid;

  transform-origin: center;
}

.antra4-blueprint-line--one {
  top: 20%;
  left: 8%;

  width: 330px;
  height: 510px;

  border-width: 1px 0 0 1px;

  transform: rotate(-18deg);
}

.antra4-blueprint-line--two {
  top: 29%;
  left: 21%;

  width: 370px;
  height: 390px;

  border-width: 1px 1px 0 0;

  transform: rotate(14deg);
}

.antra4-blueprint-line--three {
  top: 63%;
  left: -2%;

  width: 520px;
  height: 170px;

  border-width: 1px 0 0 0;

  transform: rotate(-11deg);
}


/* ---------------------------------------------------------
   Entrance motion
   --------------------------------------------------------- */

.site--ready .antra4-hero-badge {
  animation: antra4HeroReveal 750ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.site--ready .antra4-hero-title {
  animation: antra4HeroReveal 950ms cubic-bezier(0.22, 1, 0.36, 1) 100ms both;
}

.site--ready .antra4-hero-lower {
  animation: antra4HeroReveal 850ms cubic-bezier(0.22, 1, 0.36, 1) 260ms both;
}

.site--ready .antra4-hero-image-frame {
  animation: antra4HeroImageReveal 1100ms cubic-bezier(0.22, 1, 0.36, 1) 80ms both;
}

@keyframes antra4HeroReveal {
  from {
    opacity: 0;
    transform: translateY(30px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes antra4HeroImageReveal {
  from {
    opacity: 0;
    transform: translateY(24px) scale(0.97);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}


/* =========================================================
   LARGE LAPTOP
   ========================================================= */

@media (max-width: 1280px) {

  .antra4-hero-container {
    grid-template-columns:
      minmax(0, 1.08fr)
      minmax(390px, 0.92fr);

    gap: 42px;
  }

  .antra4-hero-title {
    font-size: clamp(4rem, 6.2vw, 6rem);
  }

  .antra4-video-pill {
    width: 100px;
    height: 50px;
  }

  .antra4-hero-image-frame {
    height: clamp(500px, 48vw, 650px);
  }

}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 1024px) {

  .antra4-hero {
    min-height: auto;

    padding-top: 145px;
    padding-bottom: 70px;
  }

  .antra4-hero-container {
    grid-template-columns: 1fr 0.82fr;

    gap: 35px;
  }

  .antra4-hero-title {
    font-size: clamp(3.5rem, 7vw, 5.15rem);
  }

  .antra4-title-line--mixed {
    gap: 10px;
  }

  .antra4-video-pill {
    width: 80px;
    height: 42px;
  }

  .antra4-hero-lower {
    align-items: flex-start;
    flex-direction: column;

    gap: 25px;
  }

  .antra4-hero-image-frame {
    height: 540px;

    border-radius: 30px;
  }

  .antra4-hero-dot {
    left: -24px;

    width: 48px;
    height: 48px;

    border-width: 7px;
  }

}


/* =========================================================
   MOBILE / SMALL TABLET
   ========================================================= */

@media (max-width: 820px) {

  .antra4-hero {
    padding-top: 125px;
    padding-bottom: 55px;
  }

  .antra4-hero-container {
    display: flex;
    flex-direction: column;

    align-items: stretch;

    gap: 45px;
  }

  .antra4-hero-copy {
    max-width: 680px;
  }

  .antra4-hero-title {
    font-size: clamp(3.8rem, 12vw, 6rem);
  }

  .antra4-hero-lower {
    max-width: 540px;
  }

  .antra4-hero-visual {
    width: min(100%, 650px);

    margin-left: auto;
  }

  .antra4-hero-image-frame {
    height: clamp(440px, 78vw, 620px);
  }

  .antra4-hero-dot {
    top: 42%;
    left: -20px;
  }

  .antra4-hero-blueprint {
    width: 100%;

    opacity: 0.4;
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 600px) {

  .antra4-hero {
    padding-top: 110px;
    padding-bottom: 45px;
  }

  .antra4-hero-badge {
    margin-bottom: 22px;

    font-size: 0.58rem;
  }

  .antra4-hero-title {
    width: 100%;

    font-size: clamp(3.25rem, 15.7vw, 5rem);
    line-height: 0.91;
  }

  .antra4-title-line--mixed {
    position: relative;

    display: block;

    white-space: normal;
  }

  .antra4-title-line--mixed > span:first-child {
    display: inline;
  }

  .antra4-title-line--mixed > em {
    display: inline;
  }

  .antra4-video-pill {
    display: inline-flex;

    width: 72px;
    height: 36px;

    margin: 0 7px;

    vertical-align: middle;

    transform: translateY(-7px);
  }

  .antra4-video-play {
    width: 25px;
    height: 25px;
  }

  .antra4-hero-lower {
    margin-top: 30px;
  }

  .antra4-hero-description {
    max-width: 100%;

    font-size: 0.92rem;
    line-height: 1.7;
  }

  .antra4-hero-cta {
    min-height: 52px;

    padding-left: 20px;
  }

  .antra4-hero-cta-arrow {
    width: 38px;
    height: 38px;
  }

  .antra4-hero-image-frame {
    height: 440px;

    border-radius: 24px;
  }

  .antra4-hero-dot {
    top: -18px;
    left: auto;
    right: 24px;

    width: 43px;
    height: 43px;

    border-width: 6px;

    transform: none;
  }

}


/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media (max-width: 420px) {

  .antra4-hero {
    padding-top: 105px;
  }

  .antra4-hero-title {
    font-size: clamp(3rem, 15.5vw, 4rem);
  }

  .antra4-video-pill {
    width: 62px;
    height: 32px;

    margin-inline: 5px;
  }

  .antra4-hero-image-frame {
    height: 390px;
  }

}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  .antra4-hero *,
  .antra4-hero *::before,
  .antra4-hero *::after {
    animation-duration: 0.01ms !important;
    animation-delay: 0ms !important;
    transition-duration: 0.01ms !important;
  }

}


/* =========================================================
   ANTRA INDEX 4 — FINAL REFERENCE MATCH
   Vasupriy branded content
   ========================================================= */

.antra4-hero {
  position: relative;
  isolation: isolate;
  overflow: hidden;

  min-height: 0;

  padding-top: 180px;
  padding-bottom: 82px;

  color: #171717;
  background: #f7f7f6;
}

.antra4-hero-container {
  position: relative;
  z-index: 2;

  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(0, 1fr);

  align-items: start;

  gap: 28px;

  width: calc(100% - 24px);
  max-width: none;

  margin: 0 auto;
  padding: 0;
}


/* =========================================================
   LEFT
   ========================================================= */

.antra4-hero-copy {
  position: relative;

  width: 100%;
  max-width: none;

  padding-top: 20px;
  padding-left: 0;
}


/* badge */

.antra4-hero-badge {
  display: inline-flex;
  align-items: center;

  gap: 9px;

  min-height: 31px;

  margin: 0 0 31px 0;
  padding: 5px 14px;

  color: #202020;

  font-family: Arial, Helvetica, sans-serif;
  font-size: 12px;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.025em;
  text-transform: uppercase;

  border: 1px solid rgba(0, 0, 0, 0.11);
  border-radius: 999px;
}

.antra4-hero-badge > span:first-child {
  display: block;

  width: 5px;
  height: 5px;

  color: transparent;
  background: #d7a957;

  border: 0;
  border-radius: 50%;
}


/* =========================================================
   TITLE — MATCH ANTRA SANS TYPOGRAPHY
   ========================================================= */

.antra4-hero-title {
  display: block;

  width: 100%;
  max-width: none;

  margin: 0;

  color: #171717;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: clamp(74px, 7.15vw, 112px);
  font-weight: 500;

  line-height: 1.055;
  letter-spacing: -0.065em;
}

.antra4-title-line {
  display: block;
}

.antra4-title-line--mixed {
  display: flex;
  align-items: center;

  gap: 13px;

  width: 100%;

  white-space: nowrap;
}


/* remove previous italic treatment */

.antra4-hero-title em {
  color: #d5a653;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-weight: 500;
  font-style: normal;
}


/* =========================================================
   VIDEO CAPSULE
   ========================================================= */

.antra4-video-pill {
  position: relative;

  display: inline-block;
  flex: 0 0 auto;

  width: 270px;
  height: 101px;

  margin-left: -2px;

  overflow: visible;

  border-radius: 999px;

  box-shadow: none;

  transform: translateY(2px);
}

.antra4-video-pill img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  border-radius: inherit;
}

.antra4-video-pill::after {
  display: none;
}

.antra4-video-play {
  position: absolute;

  z-index: 3;

  top: 50%;
  right: -1px;
  left: auto;

  display: grid;

  width: 82px;
  height: 82px;

  place-items: center;

  color: #ffffff;
  background: #aaa6a2;

  font-family: Arial, Helvetica, sans-serif;
  font-size: 17px;

  border: 0;
  border-radius: 50%;

  transform: translateY(-50%);

  box-shadow: none;
}


/* =========================================================
   LOWER CONTENT
   ========================================================= */

.antra4-hero-lower {
  display: block;

  max-width: 430px;

  margin-top: 47px;
}

.antra4-hero-description {
  max-width: 420px;

  margin: 0;

  color: #5b5b5b;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 18px;
  font-weight: 400;
  line-height: 1.55;
  letter-spacing: 0;
}


/* =========================================================
   CTA
   ========================================================= */

.antra4-hero-cta {
  display: inline-flex;

  min-height: 64px;

  align-items: center;
  justify-content: space-between;

  gap: 20px;

  margin-top: 59px;

  padding:
    7px
    7px
    7px
    24px;

  color: #171717;
  background: transparent;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 15px;
  font-weight: 700;
  letter-spacing: -0.035em;
  text-transform: none;

  border:
    1px solid
    rgba(20, 20, 20, 0.22);

  border-radius: 999px;

  box-shadow: none;
}

.antra4-hero-cta > span:first-child {
  padding: 0;
}

.antra4-hero-cta-arrow {
  display: grid;

  width: 42px;
  height: 42px;

  place-items: center;

  color: #ffffff;
  background: #d5a653;

  font-family: Arial, Helvetica, sans-serif;
  font-size: 20px;

  border-radius: 50%;

  transition:
    transform 250ms ease,
    background 250ms ease;
}

.antra4-hero-cta:hover {
  color: #171717;
  background: transparent;

  border-color: rgba(20, 20, 20, 0.42);

  transform: none;
}

.antra4-hero-cta:hover .antra4-hero-cta-arrow {
  color: #ffffff;
  background: #d5a653;

  transform: rotate(45deg);
}


/* =========================================================
   RIGHT IMAGE — 50% HERO
   ========================================================= */

.antra4-hero-visual {
  position: relative;

  width: 100%;

  padding-top: 0;
}

.antra4-hero-image-frame {
  position: relative;

  width: 100%;
  height: 650px;

  overflow: hidden;

  border-radius: 26px;

  box-shadow: none;
}

.antra4-hero-image-frame::after {
  display: none;
}

.antra4-hero-image-frame img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
  object-position: center;

  transform: none;
}

.antra4-hero:hover
.antra4-hero-image-frame img {
  transform: none;
}


/* little gold dot from reference */

.antra4-hero-dot {
  position: absolute;

  z-index: 5;

  top: auto;
  bottom: -5px;
  left: 28%;

  width: 10px;
  height: 10px;

  background: #d5a653;

  border: 0;
  border-radius: 50%;

  transform: none;

  box-shadow: none;
}


/* =========================================================
   BACKGROUND ARCHITECTURAL DRAWING
   ========================================================= */

.antra4-hero-blueprint {
  position: absolute;

  z-index: 0;

  inset: 0 auto 0 0;

  width: 51%;
  height: 100%;

  opacity: 1;

  overflow: hidden;

  pointer-events: none;
}

.antra4-hero-blueprint::before {
  content: '';

  position: absolute;

  top: -230px;
  left: 85px;

  width: 475px;
  height: 475px;

  border:
    1px solid
    rgba(100, 100, 100, 0.055);

  border-radius: 50%;

  transform: none;
}

.antra4-hero-blueprint::after {
  content: '';

  position: absolute;

  top: 290px;
  left: 145px;

  width: 430px;
  height: 310px;

  border:
    1px solid
    rgba(90, 90, 90, 0.045);

  transform:
    perspective(500px)
    rotateX(57deg)
    rotateZ(-7deg);
}

.antra4-blueprint-line {
  opacity: 0.55;
}

.antra4-blueprint-line--one {
  top: 310px;
  left: 70px;

  width: 510px;
  height: 330px;

  border-width: 1px 1px 0 0;
  border-color: rgba(70, 70, 70, 0.065);

  transform: skewY(-19deg);
}

.antra4-blueprint-line--two {
  top: 390px;
  left: 170px;

  width: 390px;
  height: 240px;

  border-width: 1px 0 0 1px;
  border-color: rgba(70, 70, 70, 0.06);

  transform: skewY(14deg);
}

.antra4-blueprint-line--three {
  top: 520px;
  left: 70px;

  width: 520px;
  height: 150px;

  border-width: 1px 0 0 0;
  border-color: rgba(70, 70, 70, 0.055);

  transform: rotate(-13deg);
}


/* =========================================================
   LAPTOP
   ========================================================= */

@media (max-width: 1200px) {

  .antra4-hero {
    padding-top: 165px;
  }

  .antra4-hero-container {
    gap: 22px;
  }

  .antra4-hero-title {
    font-size: clamp(64px, 7vw, 88px);
  }

  .antra4-video-pill {
    width: 205px;
    height: 82px;
  }

  .antra4-video-play {
    width: 66px;
    height: 66px;
  }

  .antra4-hero-image-frame {
    height: 610px;
  }

}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 900px) {

  .antra4-hero {
    padding-top: 140px;
    padding-bottom: 65px;
  }

  .antra4-hero-container {
    display: grid;

    grid-template-columns: 1fr;

    width: calc(100% - 40px);

    gap: 50px;
  }

  .antra4-hero-copy {
    max-width: 760px;
  }

  .antra4-hero-title {
    font-size: clamp(64px, 11vw, 96px);
  }

  .antra4-hero-lower {
    max-width: 500px;
  }

  .antra4-hero-image-frame {
    height: min(78vw, 650px);
  }

  .antra4-hero-blueprint {
    width: 100%;
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 600px) {

  .antra4-hero {
    padding-top: 115px;
    padding-bottom: 48px;
  }

  .antra4-hero-container {
    width: calc(100% - 30px);

    gap: 40px;
  }

  .antra4-hero-copy {
    padding-top: 0;
  }

  .antra4-hero-badge {
    margin-bottom: 25px;

    font-size: 10px;
  }

  .antra4-hero-title {
    font-size: clamp(49px, 15.4vw, 70px);

    line-height: 1;
  }

  .antra4-title-line--mixed {
    display: block;

    white-space: normal;
  }

  .antra4-title-line--mixed > span:first-child,
  .antra4-title-line--mixed > em {
    display: inline;
  }

  .antra4-video-pill {
    display: inline-block;

    width: 110px;
    height: 48px;

    margin: 0 5px;

    vertical-align: middle;

    transform: translateY(-5px);
  }

  .antra4-video-play {
    width: 42px;
    height: 42px;

    font-size: 11px;
  }

  .antra4-hero-lower {
    margin-top: 32px;
  }

  .antra4-hero-description {
    font-size: 16px;
  }

  .antra4-hero-cta {
    min-height: 58px;

    margin-top: 35px;
  }

  .antra4-hero-image-frame {
    height: 450px;

    border-radius: 22px;
  }

  .antra4-hero-dot {
    bottom: -5px;
    left: 30%;
  }

}


/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media (max-width: 400px) {

  .antra4-hero-title {
    font-size: 47px;
  }

  .antra4-video-pill {
    width: 92px;
    height: 43px;
  }

  .antra4-video-play {
    width: 37px;
    height: 37px;
  }

  .antra4-hero-image-frame {
    height: 410px;
  }

}

