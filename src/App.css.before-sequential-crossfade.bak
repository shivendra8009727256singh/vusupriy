/* =========================================================
   VASUPRIY INTERIOVILLA
   HOME — HEADER / HERO / INTRO
   ========================================================= */

.site {
  width: 100%;
  background: var(--color-ivory);
}

/* =========================================================
   HEADER
   ========================================================= */

.site-header {
  position: absolute;
  z-index: 50;
  top: 0;
  left: 0;

  width: 100%;

  color: var(--color-white);

  border-bottom: 1px solid rgba(255, 255, 255, 0.18);
}

.header-inner {
  display: grid;
  grid-template-columns: minmax(220px, auto) 1fr auto;
  min-height: 96px;
  align-items: center;
  gap: clamp(28px, 4vw, 64px);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 14px;

  width: fit-content;

  color: var(--color-white);
}

.brand-logo {
  display: block;

  width: 80px;
  height: 80px;

  flex: 0 0 80px;

  object-fit: contain;
}

.brand-name {
  display: flex;
  flex-direction: column;
}

.brand-name strong {
  color: var(--color-white);

  font-family: var(--font-display);
  font-size: 1.18rem;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 0.16em;
}

.brand-name small {
  margin-top: 7px;

  color: var(--color-gold-light);

  font-size: 0.55rem;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 0.32em;
}

.desktop-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(22px, 2.6vw, 42px);
}

.desktop-nav a {
  position: relative;

  padding-block: 35px;

  color: rgba(255, 255, 255, 0.9);

  /* Same typography family used by VASUPRIY wordmark */
  font-family: var(--font-display);
  font-size: 1.08rem;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 0.08em;

  transition:
    color var(--transition-base),
    transform var(--transition-base);
}

.desktop-nav a::after {
  position: absolute;
  bottom: -1px;
  left: 0;

  width: 0;
  height: 2px;

  content: "";

  background: var(--color-gold);

  transition: width var(--transition-base);
}

.desktop-nav a:hover,
.desktop-nav a.active {
  color: var(--color-gold-light);
}

.desktop-nav a:hover {
  transform: translateY(-2px);
}

.desktop-nav a:hover::after,
.desktop-nav a.active::after {
  width: 100%;
}

.header-cta {
  border-radius: 14px;
  display: inline-flex;
  min-height: 48px;
  align-items: center;
  justify-content: center;
  gap: 20px;

  padding: 12px 22px;

  color: var(--color-navy-deep);
  background: var(--color-gold);

  font-size: 0.67rem;
  font-weight: 800;
  letter-spacing: 0.09em;
  text-transform: uppercase;

  transition:
    background var(--transition-base),
    transform var(--transition-base);
}

.header-cta:hover {
  background: var(--color-white);
  transform: translateY(-2px);
}

.menu-button {
  display: none;

  width: 46px;
  height: 46px;

  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 7px;

  padding: 0;

  color: var(--color-white);
  background: transparent;

  cursor: pointer;
}

.menu-button span {
  width: 25px;
  height: 1px;

  background: currentColor;
}

/* =========================================================
   HERO
   ========================================================= */

.hero-section {
  position: relative;

  display: flex;
  min-height: 100svh;
  align-items: flex-end;

  overflow: hidden;

  color: var(--color-white);
  background: var(--color-navy-deep);
}

.hero-media {
  position: absolute;
  z-index: 0;
  inset: 0;
}

.hero-media img {
  width: 100%;
  height: 100%;

  object-fit: cover;
  object-position: center center;

  transform: scale(1.01);
}

.hero-image-shade {
  position: absolute;
  z-index: 1;
  inset: 0;

  background:
    linear-gradient(90deg,
      rgba(4, 18, 30, 0.55) 0%,
      rgba(4, 18, 30, 0.14) 54%,
      rgba(4, 18, 30, 0.05) 100%),
    linear-gradient(0deg,
      rgba(3, 15, 25, 0.62) 0%,
      transparent 48%);
}

.hero-navy-panel {
  position: absolute;
  z-index: 2;
  top: 0;
  bottom: 0;
  left: 0;

  width: 57%;

  background:
    linear-gradient(90deg,
      rgba(5, 24, 39, 0.99) 0%,
      rgba(7, 29, 47, 0.97) 58%,
      rgba(7, 29, 47, 0.77) 82%,
      rgba(7, 29, 47, 0) 100%);
}

.hero-container {
  position: relative;
  z-index: 3;

  display: grid;
  grid-template-columns: minmax(0, 1fr) 240px;
  align-items: end;
  gap: clamp(40px, 5vw, 80px);

  padding-top: 175px;
  padding-bottom: clamp(55px, 7vh, 82px);
}

.hero-content {
  width: 100%;
  max-width: 1050px;
}

.hero-eyebrow {
  display: flex;
  align-items: center;
  gap: 16px;

  margin-bottom: clamp(30px, 4.5vh, 48px);

  color: var(--color-gold-light);

  font-size: 0.67rem;
  font-weight: 800;
  line-height: 1.4;
  letter-spacing: 0.19em;
  text-transform: uppercase;
}

.eyebrow-line {
  width: 44px;
  height: 1px;

  flex-shrink: 0;

  background: currentColor;
}

.hero-title {
  max-width: 940px;

  color: var(--color-white);

  font-size: clamp(4rem, 7.6vw, 8rem);
  line-height: 0.84;
  letter-spacing: -0.058em;

  text-wrap: balance;
}

.hero-title-line--gold {
  color: var(--color-gold-light);
  font-style: italic;
}

.hero-title-line--white {
  color: var(--color-white);
}

.hero-bottom {
  display: flex;
  max-width: 950px;
  align-items: flex-end;
  justify-content: space-between;
  gap: 40px;

  margin-top: clamp(40px, 6vh, 65px);
}

.hero-description {
  display: grid;
  grid-template-columns: auto minmax(0, 410px);
  align-items: start;
  gap: 23px;
}

.hero-year {
  padding-top: 4px;

  color: var(--color-gold);

  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  white-space: nowrap;
}

.hero-description p {
  color: rgba(255, 255, 255, 0.75);

  font-size: 0.89rem;
  line-height: 1.75;
}

.hero-actions {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 25px;
}

.hero-primary-btn {
  display: inline-flex;
  min-height: 58px;
  align-items: center;
  justify-content: space-between;
  gap: 24px;

  padding: 12px 12px 12px 24px;

  color: var(--color-navy-deep);
  background: var(--color-gold);

  font-size: 0.66rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;

  transition:
    background var(--transition-base),
    transform var(--transition-base);
}

.hero-primary-btn:hover {
  background: var(--color-white);
  transform: translateY(-2px);
}

.button-arrow {
  display: grid;
  width: 34px;
  height: 34px;
  place-items: center;

  color: var(--color-white);
  background: var(--color-navy-deep);

  border-radius: 50%;

  font-size: 0.9rem;
}

.hero-text-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;

  padding-block: 9px;

  color: rgba(255, 255, 255, 0.94);

  border-bottom: 1px solid rgba(255, 255, 255, 0.45);

  font-size: 0.66rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;

  white-space: nowrap;
}

.hero-feature {
  position: relative;

  display: flex;
  min-height: 245px;
  flex-direction: column;
  justify-content: space-between;

  margin-bottom: 5px;
  padding: 25px;

  border: 1px solid rgba(223, 197, 150, 0.5);

  background: rgba(7, 29, 47, 0.79);
  backdrop-filter: blur(12px);

  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
}

.feature-top {
  display: flex;
  align-items: center;
  gap: 12px;
}

.feature-number,
.feature-label {
  color: var(--color-gold);

  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.feature-line {
  width: 35px;
  height: 1px;

  background: rgba(201, 166, 107, 0.6);
}

.feature-content {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.hero-feature strong {
  color: var(--color-white);

  font-family: var(--font-display);
  font-size: 1.55rem;
  font-weight: 400;
  line-height: 1.12;
}

.hero-scroll {
  position: absolute;
  right: -48px;
  bottom: 120px;

  display: flex;
  align-items: center;
  gap: 14px;

  color: rgba(255, 255, 255, 0.68);

  font-size: 0.56rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;

  transform: rotate(-90deg);
  transform-origin: center;
}

.scroll-line {
  width: 40px;
  height: 1px;

  background: var(--color-gold);
}

/* =========================================================
   EXPERTISE STRIP
   ========================================================= */

.brand-strip {
  position: relative;
  z-index: 5;

  width: 100%;

  overflow: hidden;

  color: var(--color-navy-deep);
  background: var(--color-gold);
}

.brand-strip-track {
  display: flex;
  width: 100%;
  min-height: 72px;
  align-items: center;
  justify-content: space-between;
  gap: 20px;

  padding-inline: var(--page-padding);

  white-space: nowrap;

  font-family: var(--font-display);
  font-size: clamp(0.92rem, 1.3vw, 1.25rem);
}

.brand-strip-track i {
  display: block;

  width: 5px;
  height: 5px;

  flex: 0 0 5px;

  background: var(--color-navy);
  border-radius: 50%;
}

/* =========================================================
   ABOUT INTRO
   ========================================================= */

.intro-section {
  position: relative;

  background: var(--color-ivory);
}

.intro-grid {
  display: grid;
  grid-template-columns: minmax(160px, 0.32fr) minmax(0, 1fr);
  gap: clamp(40px, 7vw, 110px);
}

.intro-label {
  padding-top: 13px;
}

.intro-content {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(260px, 0.42fr);
  align-items: end;
  gap: clamp(40px, 6vw, 90px);
}

.intro-content .section-title {
  color: var(--color-navy-deep);
}

.intro-content .section-title em {
  color: var(--color-gold-dark);
  font-weight: 400;
}

.intro-copy {
  padding-bottom: 9px;
}

.intro-copy p {
  margin-bottom: 30px;

  color: var(--color-text);

  font-size: 0.96rem;
}

.intro-copy a {
  display: inline-flex;
  align-items: center;
  gap: 20px;

  padding-bottom: 8px;

  color: var(--color-navy);

  border-bottom: 1px solid rgba(16, 43, 70, 0.4);

  font-size: 0.69rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 1180px) {
  .header-inner {
    gap: 24px;
  }

  .brand-name {
    display: none;
  }

  .header-inner {
    grid-template-columns: auto 1fr auto;
  }

  .desktop-nav {
    gap: 20px;
  }

  .hero-container {
    grid-template-columns: minmax(0, 1fr) 210px;
  }

  .hero-bottom {
    align-items: flex-start;
    flex-direction: column;
    gap: 28px;
  }

  .brand-strip-track {
    width: max-content;
    min-width: 100%;
    justify-content: flex-start;
    gap: 32px;
  }

  .intro-content {
    grid-template-columns: 1fr;
  }

  .intro-copy {
    max-width: 560px;
  }
}

/* =========================================================
   MOBILE NAV / TABLET HERO
   ========================================================= */

@media (max-width: 960px) {
  .header-inner {
    display: flex;
    min-height: 82px;
    justify-content: space-between;
  }

  .brand-name {
    display: flex;
  }

  .desktop-nav,
  .header-cta {
    display: none;
  }

  .menu-button {
    display: flex;
  }

  .hero-section {
    min-height: 900px;
  }

  .hero-navy-panel {
    width: 82%;
  }

  .hero-media img {
    object-position: 63% center;
  }

  .hero-container {
    display: block;

    padding-top: 150px;
    padding-bottom: 55px;
  }

  .hero-content {
    max-width: 820px;
  }

  .hero-feature {
    max-width: 290px;
    min-height: 190px;

    margin-top: 50px;
  }

  .hero-scroll {
    display: none;
  }

  .intro-grid {
    grid-template-columns: 1fr;
    gap: 35px;
  }

  .intro-label {
    padding-top: 0;
  }
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 640px) {
  .brand-logo {
    width: 47px;
    height: 47px;

    flex-basis: 47px;
  }

  .brand-name strong {
    font-size: 0.93rem;
  }

  .brand-name small {
    font-size: 0.46rem;
  }

  .hero-section {
    min-height: 940px;
  }

  .hero-media img {
    object-position: 67% center;
  }

  .hero-image-shade {
    background:
      linear-gradient(90deg,
        rgba(4, 18, 30, 0.66),
        rgba(4, 18, 30, 0.28)),
      linear-gradient(0deg,
        rgba(3, 15, 25, 0.78) 0%,
        rgba(3, 15, 25, 0.3) 70%,
        rgba(3, 15, 25, 0.55) 100%);
  }

  .hero-navy-panel {
    width: 100%;

    background:
      linear-gradient(90deg,
        rgba(5, 24, 39, 0.95) 0%,
        rgba(5, 24, 39, 0.77) 65%,
        rgba(5, 24, 39, 0.4) 100%);
  }

  .hero-container {
    padding-top: 140px;
    padding-bottom: 45px;
  }

  .hero-eyebrow {
    align-items: flex-start;

    margin-bottom: 30px;

    font-size: 0.57rem;
    line-height: 1.55;
  }

  .eyebrow-line {
    width: 28px;

    margin-top: 7px;
  }

  .hero-title {
    font-size: clamp(3.45rem, 17vw, 5.5rem);
  }

  .hero-bottom {
    margin-top: 40px;
  }

  .hero-description {
    grid-template-columns: 1fr;
    gap: 9px;
  }

  .hero-description p {
    max-width: 390px;
  }

  .hero-actions {
    width: 100%;
    align-items: flex-start;
    flex-direction: column;
  }

  .hero-primary-btn {
    width: 100%;
  }

  .hero-feature {
    max-width: 100%;

    margin-top: 38px;
  }

  .brand-strip-track {
    min-height: 62px;
    gap: 25px;

    padding-inline: 20px;

    font-size: 0.98rem;
  }

  .intro-content {
    gap: 35px;
  }
}

/* =========================================================
   VASUPRIY PRELOADER
   Inspired by Antra's multi-gutter opening concept
   ========================================================= */

body.is-loading {
  overflow: hidden;
}

.preloader {
  position: fixed;
  z-index: 9999;
  inset: 0;

  display: grid;
  place-items: center;

  overflow: hidden;

  color: #ffffff;
  background: #071d2f;
}

.preloader-panels {
  position: absolute;
  z-index: 1;
  inset: 0;

  display: grid;
  grid-template-columns: repeat(5, 1fr);
}

.preloader-panel {
  position: relative;

  display: block;

  height: 100%;

  background: #071d2f;

  border-right: 1px solid rgba(215, 183, 125, 0.12);

  transform: scaleY(1);
  transform-origin: top;

  transition:
    transform 0.9s cubic-bezier(0.76, 0, 0.24, 1),
    opacity 0.7s ease;
}

.preloader-panel:nth-child(2) {
  transition-delay: 0.06s;
}

.preloader-panel:nth-child(3) {
  transition-delay: 0.12s;
}

.preloader-panel:nth-child(4) {
  transition-delay: 0.18s;
}

.preloader-panel:nth-child(5) {
  transition-delay: 0.24s;
}

/* ---------------------------------------------------------
   BRAND
   --------------------------------------------------------- */

.preloader-brand {
  position: relative;
  z-index: 3;

  display: flex;
  align-items: center;
  flex-direction: column;

  text-align: center;
}

.preloader-logo-wrap {
  display: grid;

  width: 300px;
  height: 300px;

  place-items: center;

  margin-bottom: 24px;

  opacity: 0;

  transform: scale(0.72) rotate(-8deg);

  animation:
    loaderLogoIn 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
}

.preloader-logo {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: contain;
}

.preloader-wordmark {
  display: flex;
  align-items: center;
  flex-direction: column;

  overflow: hidden;
}

.preloader-wordmark span {
  display: block;

  color: #ffffff;

  font-family: var(--font-display);
  font-size: clamp(2.1rem, 5vw, 4.8rem);
  font-weight: 400;
  line-height: 0.95;
  letter-spacing: 0.16em;

  opacity: 0;

  transform: translateY(110%);

  animation:
    loaderTextIn 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.4s forwards;
}

.preloader-wordmark small {
  display: block;

  margin-top: 13px;

  color: var(--color-gold);

  font-size: clamp(0.58rem, 1vw, 0.76rem);
  font-weight: 800;
  letter-spacing: 0.48em;

  opacity: 0;

  transform: translateY(18px);

  animation:
    loaderFadeUp 0.7s ease 0.75s forwards;
}

.preloader-progress {
  position: relative;

  width: min(290px, 60vw);
  height: 1px;

  margin-top: 35px;

  overflow: hidden;

  background: rgba(255, 255, 255, 0.17);

  opacity: 0;

  animation: loaderOpacity 0.3s ease 0.85s forwards;
}

.preloader-progress span {
  position: absolute;
  inset: 0 auto 0 0;

  width: 100%;

  background: var(--color-gold);

  transform: scaleX(0);
  transform-origin: left;

  animation:
    loaderProgress 1.15s cubic-bezier(0.65, 0, 0.35, 1) 0.9s forwards;
}

.preloader-brand p {
  margin-top: 17px;

  color: rgba(255, 255, 255, 0.46);

  font-size: 0.58rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;

  opacity: 0;

  animation: loaderFadeUp 0.65s ease 1s forwards;
}

/* ---------------------------------------------------------
   CORNER DETAILS
   --------------------------------------------------------- */

.preloader-index {
  position: absolute;
  z-index: 3;
  bottom: 35px;

  color: rgba(215, 183, 125, 0.66);

  font-size: 0.54rem;
  font-weight: 800;
  letter-spacing: 0.18em;

  opacity: 0;

  animation: loaderOpacity 0.6s ease 1.15s forwards;
}

.preloader-index--left {
  left: clamp(24px, 4vw, 70px);
}

.preloader-index--right {
  right: clamp(24px, 4vw, 70px);
}

/* ---------------------------------------------------------
   PRELOADER EXIT
   --------------------------------------------------------- */

.preloader--leaving {
  pointer-events: none;
}

.preloader--leaving .preloader-brand {
  opacity: 0;

  transform: translateY(-25px);

  transition:
    opacity 0.35s ease,
    transform 0.5s cubic-bezier(0.76, 0, 0.24, 1);
}

.preloader--leaving .preloader-index {
  opacity: 0;

  transition: opacity 0.25s ease;
}

.preloader--leaving .preloader-panel {
  transform: scaleY(0);
}

.preloader--leaving .preloader-panel:nth-child(even) {
  transform-origin: bottom;
}

/* =========================================================
   INITIAL PAGE STATE
   ========================================================= */

.site-header .header-inner {
  opacity: 0;
  transform: translateY(-30px);
}

.hero-media {
  overflow: hidden;
}

.hero-media img {
  transform: scale(1.12);
}

.hero-eyebrow {
  opacity: 0;
  transform: translateY(25px);
}

.hero-title-line {
  display: block;

  opacity: 0;

  transform: translateY(85px);

  will-change: transform, opacity;
}

.hero-title-line--gold {
  color: var(--color-gold-light);

  font-style: italic;
}

.hero-title-line--white {
  color: var(--color-white);
}

.hero-bottom {
  opacity: 0;
  transform: translateY(35px);
}

.hero-feature {
  opacity: 0;

  transform: translateX(55px);
}

/* =========================================================
   PAGE ENTRANCE AFTER LOADER
   ========================================================= */

.site--ready .site-header .header-inner {
  animation:
    headerReveal 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.35s forwards;
}

.site--ready .hero-media img {
  animation:
    heroImageReveal 2.2s cubic-bezier(0.16, 1, 0.3, 1) 0.05s forwards;
}

.site--ready .hero-eyebrow {
  animation:
    heroFadeUp 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.45s forwards;
}

.site--ready .hero-title-line:nth-child(1) {
  animation:
    heroTitleReveal 0.95s cubic-bezier(0.16, 1, 0.3, 1) 0.52s forwards;
}

.site--ready .hero-title-line:nth-child(2) {
  animation:
    heroTitleReveal 0.95s cubic-bezier(0.16, 1, 0.3, 1) 0.64s forwards;
}

.site--ready .hero-title-line:nth-child(3) {
  animation:
    heroTitleReveal 0.95s cubic-bezier(0.16, 1, 0.3, 1) 0.76s forwards;
}

.site--ready .hero-bottom {
  animation:
    heroFadeUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.92s forwards;
}

.site--ready .hero-feature {
  animation:
    featureReveal 1s cubic-bezier(0.16, 1, 0.3, 1) 0.85s forwards;
}

/* =========================================================
   KEYFRAMES
   ========================================================= */

@keyframes loaderLogoIn {
  from {
    opacity: 0;
    transform: scale(0.72) rotate(-8deg);
  }

  to {
    opacity: 1;
    transform: scale(1) rotate(0);
  }
}

@keyframes loaderTextIn {
  from {
    opacity: 0;
    transform: translateY(110%);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes loaderFadeUp {
  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes loaderOpacity {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes loaderProgress {
  from {
    transform: scaleX(0);
  }

  to {
    transform: scaleX(1);
  }
}

@keyframes headerReveal {
  from {
    opacity: 0;
    transform: translateY(-30px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes heroImageReveal {
  from {
    transform: scale(1.12);
  }

  to {
    transform: scale(1.01);
  }
}

@keyframes heroFadeUp {
  from {
    opacity: 0;
    transform: translateY(35px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes heroTitleReveal {
  from {
    opacity: 0;
    transform: translateY(85px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes featureReveal {
  from {
    opacity: 0;
    transform: translateX(55px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* =========================================================
   MOBILE PRELOADER
   ========================================================= */

@media (max-width: 640px) {
  .preloader-panels {
    grid-template-columns: repeat(3, 1fr);
  }

  .preloader-panel:nth-child(4),
  .preloader-panel:nth-child(5) {
    display: none;
  }

  .preloader-logo-wrap {
    width: 76px;
    height: 76px;

    margin-bottom: 20px;
  }

  .preloader-wordmark span {
    font-size: clamp(2rem, 12vw, 3.2rem);
    letter-spacing: 0.1em;
  }

  .preloader-wordmark small {
    letter-spacing: 0.35em;
  }

  .preloader-index--right {
    display: none;
  }
}

/* =========================================================
   ACCESSIBILITY — REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  .preloader-logo-wrap,
  .preloader-wordmark span,
  .preloader-wordmark small,
  .preloader-progress,
  .preloader-progress span,
  .preloader-brand p,
  .preloader-index,
  .site-header .header-inner,
  .hero-media img,
  .hero-eyebrow,
  .hero-title-line,
  .hero-bottom,
  .hero-feature {
    animation-duration: 0.01ms !important;
    animation-delay: 0ms !important;
  }

  .preloader-panel {
    transition-duration: 0.01ms !important;
  }
}

/* =========================================================
   VASUPRIY FOOTER
   ========================================================= */

.site-footer {
  position: relative;

  overflow: hidden;

  color: rgba(255, 255, 255, 0.72);
  background: var(--color-navy-deep);
}

/* =========================================================
   LARGE CTA
   ========================================================= */

.footer-top {
  position: relative;

  padding-block: clamp(80px, 10vw, 145px);

  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
}

.footer-top::before {
  position: absolute;
  top: -220px;
  right: -100px;

  width: 550px;
  height: 550px;

  content: "";

  border: 1px solid rgba(201, 166, 107, 0.12);
  border-radius: 50%;
}

.footer-top::after {
  position: absolute;
  right: 120px;
  bottom: -310px;

  width: 500px;
  height: 500px;

  content: "";

  border: 1px solid rgba(201, 166, 107, 0.08);
  border-radius: 50%;
}

.footer-cta {
  position: relative;
  z-index: 2;
}

.footer-cta-label {
  display: flex;
  align-items: center;
  gap: 15px;

  margin-bottom: clamp(28px, 4vw, 48px);

  color: var(--color-gold);

  font-size: 0.65rem;
  font-weight: 800;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.footer-label-line {
  display: block;

  width: 42px;
  height: 1px;

  background: currentColor;
}

.footer-big-link {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 40px;

  color: var(--color-white);
}

.footer-big-link > span:first-child {
  font-family: var(--font-display);
  font-size: clamp(3.5rem, 7.2vw, 7.8rem);
  font-weight: 400;
  line-height: 0.91;
  letter-spacing: -0.055em;
}

.footer-big-link em {
  color: var(--color-gold-light);

  font-weight: 400;
}

.footer-circle-arrow {
  display: grid;

  width: clamp(85px, 10vw, 140px);
  height: clamp(85px, 10vw, 140px);

  flex: 0 0 auto;
  place-items: center;

  color: var(--color-navy-deep);
  background: var(--color-gold);

  border-radius: 50%;

  font-family: var(--font-display);
  font-size: clamp(1.8rem, 3vw, 3rem);

  transform: rotate(0deg);

  transition:
    color 0.5s cubic-bezier(0.16, 1, 0.3, 1),
    background 0.5s cubic-bezier(0.16, 1, 0.3, 1),
    transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.footer-big-link:hover .footer-circle-arrow {
  color: var(--color-navy-deep);
  background: var(--color-white);

  transform: rotate(45deg);
}

/* =========================================================
   MAIN FOOTER
   ========================================================= */

.footer-main {
  padding-block: clamp(65px, 8vw, 105px);
}

.footer-grid {
  display: grid;
  grid-template-columns:
    minmax(280px, 1.4fr)
    minmax(150px, 0.7fr)
    minmax(210px, 0.9fr)
    minmax(240px, 0.9fr);

  gap: clamp(40px, 6vw, 90px);
}

.footer-brand {
  max-width: 350px;
}

.footer-logo-link {
  display: inline-flex;
  align-items: center;
  gap: 15px;

  margin-bottom: 30px;
}

.footer-logo {
  width: 64px;
  height: 64px;

  object-fit: contain;
}

.footer-wordmark {
  display: flex;
  flex-direction: column;
}

.footer-wordmark strong {
  color: var(--color-white);

  font-family: var(--font-display);
  font-size: 1.28rem;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 0.16em;
}

.footer-wordmark small {
  margin-top: 8px;

  color: var(--color-gold);

  font-size: 0.55rem;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 0.34em;
}

.footer-brand p {
  max-width: 320px;

  margin-bottom: 25px;

  color: rgba(255, 255, 255, 0.56);

  font-size: 0.88rem;
  line-height: 1.85;
}

.footer-since {
  color: var(--color-gold);

  font-size: 0.57rem;
  font-weight: 800;
  letter-spacing: 0.18em;
}

.footer-heading {
  display: block;

  margin-bottom: 30px;

  color: var(--color-gold);

  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.19em;
  text-transform: uppercase;
}

/* =========================================================
   LINKS
   ========================================================= */

.footer-links {
  display: flex;
  flex-direction: column;
}

.footer-links a {
  display: flex;
  align-items: center;
  gap: 13px;

  width: fit-content;

  padding-block: 7px;

  color: rgba(255, 255, 255, 0.78);

  font-family: var(--font-display);
  font-size: 1.05rem;

  transition:
    color var(--transition-base),
    transform var(--transition-base);
}

.footer-links a span {
  color: rgba(201, 166, 107, 0.55);

  font-family: var(--font-body);
  font-size: 0.48rem;
  font-weight: 700;
}

.footer-links a:hover {
  color: var(--color-gold-light);

  transform: translateX(6px);
}

/* =========================================================
   SERVICES
   ========================================================= */

.footer-service-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.footer-service-list span {
  color: rgba(255, 255, 255, 0.62);

  font-size: 0.8rem;
  line-height: 1.55;
}

/* =========================================================
   CONNECT
   ========================================================= */

.footer-connect p {
  max-width: 280px;

  margin-bottom: 27px;

  color: rgba(255, 255, 255, 0.57);

  font-size: 0.84rem;
  line-height: 1.75;
}

.footer-consultation {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  gap: 20px;

  padding-block: 14px;

  color: var(--color-white);

  border-top: 1px solid rgba(255, 255, 255, 0.17);
  border-bottom: 1px solid rgba(255, 255, 255, 0.17);

  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.09em;
  text-transform: uppercase;

  transition:
    color var(--transition-base),
    border-color var(--transition-base);
}

.footer-consultation:hover {
  color: var(--color-gold);

  border-color: rgba(201, 166, 107, 0.65);
}

.footer-socials {
  display: flex;
  gap: 10px;

  margin-top: 28px;
}

.footer-socials a {
  display: grid;

  width: 40px;
  height: 40px;

  place-items: center;

  color: rgba(255, 255, 255, 0.72);

  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 50%;

  font-size: 0.57rem;
  font-weight: 800;
  letter-spacing: 0.06em;

  transition:
    color var(--transition-base),
    background var(--transition-base),
    border-color var(--transition-base),
    transform var(--transition-base);
}

.footer-socials a:hover {
  color: var(--color-navy-deep);
  background: var(--color-gold);
  border-color: var(--color-gold);

  transform: translateY(-4px);
}

/* =========================================================
   BOTTOM BAR
   ========================================================= */

.footer-bottom {
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.footer-bottom-inner {
  display: flex;
  min-height: 76px;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
}

.footer-bottom p {
  color: rgba(255, 255, 255, 0.38);

  font-size: 0.68rem;
  letter-spacing: 0.04em;
}

.back-to-top {
  display: inline-flex;
  align-items: center;
  gap: 14px;

  padding: 10px 0;

  color: rgba(255, 255, 255, 0.7);
  background: transparent;

  font-size: 0.61rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;

  cursor: pointer;

  transition: color var(--transition-base);
}

.back-to-top span:last-child {
  color: var(--color-gold);

  font-size: 1rem;

  transition: transform var(--transition-base);
}

.back-to-top:hover {
  color: var(--color-white);
}

.back-to-top:hover span:last-child {
  transform: translateY(-4px);
}

/* =========================================================
   FOOTER RESPONSIVE
   ========================================================= */

@media (max-width: 1050px) {
  .footer-grid {
    grid-template-columns: 1.2fr 0.8fr 1fr;
  }

  .footer-connect {
    grid-column: 1 / -1;

    max-width: 500px;
  }
}

@media (max-width: 720px) {
  .footer-big-link {
    align-items: flex-start;
    flex-direction: column;
  }

  .footer-circle-arrow {
    width: 82px;
    height: 82px;
  }

  .footer-grid {
    grid-template-columns: 1fr 1fr;
  }

  .footer-brand,
  .footer-connect {
    grid-column: 1 / -1;
  }
}

@media (max-width: 480px) {
  .footer-top {
    padding-block: 75px;
  }

  .footer-big-link > span:first-child {
    font-size: clamp(3rem, 15vw, 4.4rem);
  }

  .footer-grid {
    grid-template-columns: 1fr;
  }

  .footer-brand,
  .footer-connect {
    grid-column: auto;
  }

  .footer-main {
    padding-block: 60px;
  }

  .footer-bottom-inner {
    min-height: 100px;
    align-items: flex-start;
    justify-content: center;
    flex-direction: column;

    padding-block: 22px;
  }
}

/* =========================================================
   PREMIUM FLOATING GLASS HEADER
   ========================================================= */

.site-header {
  position: fixed;
  z-index: 1000;
  top: 16px;
  left: 0;

  width: 100%;

  border: 0;

  pointer-events: none;

  transition:
    top 0.55s cubic-bezier(0.16, 1, 0.3, 1),
    padding 0.55s cubic-bezier(0.16, 1, 0.3, 1);
}

.site-header .header-inner {
  position: relative;

  min-height: 86px;

  padding: 0 18px 0 20px;

  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 3px;

  background:
    linear-gradient(
      105deg,
      rgba(5, 25, 41, 0.92) 0%,
      rgba(7, 29, 47, 0.78) 48%,
      rgba(7, 29, 47, 0.62) 100%
    );

  box-shadow:
    0 16px 50px rgba(0, 0, 0, 0.13),
    inset 0 1px 0 rgba(255, 255, 255, 0.06);

  backdrop-filter: blur(18px) saturate(130%);
  -webkit-backdrop-filter: blur(18px) saturate(130%);

  pointer-events: auto;

  transition:
    min-height 0.55s cubic-bezier(0.16, 1, 0.3, 1),
    max-width 0.55s cubic-bezier(0.16, 1, 0.3, 1),
    padding 0.55s cubic-bezier(0.16, 1, 0.3, 1),
    border-radius 0.55s cubic-bezier(0.16, 1, 0.3, 1),
    background 0.4s ease,
    box-shadow 0.4s ease;
}

/* Fine gold architectural line */

.site-header .header-inner::before {
  position: absolute;
  top: -1px;
  left: 20px;

  width: 92px;
  height: 1px;

  content: "";

  background:
    linear-gradient(
      90deg,
      transparent,
      var(--color-gold),
      transparent
    );

  opacity: 0.9;
}

/* =========================================================
   LOGO AREA
   ========================================================= */

.site-header .brand {
  position: relative;

  gap: 14px;

  padding-right: 24px;
}

.site-header .brand::after {
  position: absolute;
  top: 50%;
  right: 0;

  width: 1px;
  height: 35px;

  content: "";

  background:
    linear-gradient(
      to bottom,
      transparent,
      rgba(215, 183, 125, 0.55),
      transparent
    );

  transform: translateY(-50%);
}

.site-header .brand-logo {
  transition:
    width 0.55s cubic-bezier(0.16, 1, 0.3, 1),
    height 0.55s cubic-bezier(0.16, 1, 0.3, 1),
    transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
}

.site-header .brand:hover .brand-logo {
  transform: scale(1.06);
}

.site-header .brand-name strong {
  font-family: var(--font-display);
  letter-spacing: 0.16em;
}

.site-header .brand-name small {
  color: var(--color-gold);
}

/* =========================================================
   NAVIGATION
   ========================================================= */

.site-header .desktop-nav {
  gap: clamp(20px, 2.25vw, 38px);
}

.site-header .desktop-nav a {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 34px 0;

  color: rgba(255, 255, 255, 0.83);

  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 0.055em;

  transition:
    color 0.35s ease,
    transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
    padding 0.55s cubic-bezier(0.16, 1, 0.3, 1);
}

/*
  Remove previous conventional underline.
*/

.site-header .desktop-nav a::after {
  bottom: 19px;
  left: 50%;

  width: 0;
  height: 1px;

  background: var(--color-gold);

  transform: translateX(-50%);

  transition:
    width 0.4s cubic-bezier(0.16, 1, 0.3, 1),
    bottom 0.55s cubic-bezier(0.16, 1, 0.3, 1);
}

/*
  Gold navigation dot.
*/

.site-header .desktop-nav a::before {
  position: absolute;
  bottom: 15px;
  left: 50%;

  width: 4px;
  height: 4px;

  content: "";

  background: var(--color-gold);
  border-radius: 50%;

  opacity: 0;

  transform:
    translateX(-50%)
    translateY(6px)
    scale(0);

  transition:
    opacity 0.3s ease,
    transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
    bottom 0.55s cubic-bezier(0.16, 1, 0.3, 1);
}

.site-header .desktop-nav a:hover,
.site-header .desktop-nav a.active {
  color: var(--color-gold-light);

  transform: translateY(-2px);
}

.site-header .desktop-nav a:hover::after {
  width: 100%;
}

.site-header .desktop-nav a.active::after {
  width: 28px;
}

.site-header .desktop-nav a:hover::before,
.site-header .desktop-nav a.active::before {
  opacity: 1;

  transform:
    translateX(-50%)
    translateY(0)
    scale(1);
}

/* =========================================================
   CONSULTATION CTA
   ========================================================= */

.site-header .header-cta {
  position: relative;

  min-height: 50px;

  gap: 22px;

  overflow: hidden;

  padding: 10px 13px 10px 23px;

  border: 1px solid var(--color-gold);

  background: var(--color-gold);

  transition:
    color 0.4s ease,
    background 0.4s ease,
    transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
    box-shadow 0.4s ease;
}

.site-header .header-cta::before {
  position: absolute;
  inset: 0;

  content: "";

  background: var(--color-navy-deep);

  transform: translateX(-102%);

  transition:
    transform 0.55s cubic-bezier(0.76, 0, 0.24, 1);
}

.site-header .header-cta span {
  position: relative;
  z-index: 2;
}

.site-header .header-cta span:last-child {
  display: grid;

  width: 30px;
  height: 30px;

  place-items: center;

  color: var(--color-white);
  background: var(--color-navy-deep);

  border-radius: 50%;

  transition:
    color 0.4s ease,
    background 0.4s ease,
    transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
}

.site-header .header-cta:hover {
  color: var(--color-white);
  background: var(--color-gold);

  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.16);

  transform: translateY(-2px);
}

.site-header .header-cta:hover::before {
  transform: translateX(0);
}

.site-header .header-cta:hover span:last-child {
  color: var(--color-navy-deep);
  background: var(--color-gold);

  transform: rotate(45deg);
}

/* =========================================================
   SCROLLED — COMPACT STICKY MODE
   ========================================================= */

.site-header--scrolled {
  top: 8px;
}

.site-header--scrolled .header-inner {
  min-height: 68px;

  padding-right: 10px;
  padding-left: 15px;

  border-color: rgba(215, 183, 125, 0.22);
  border-radius: 4px;

  background: rgba(5, 24, 39, 0.93);

  box-shadow:
    0 15px 45px rgba(0, 0, 0, 0.2),
    inset 0 1px 0 rgba(255, 255, 255, 0.06);

  backdrop-filter: blur(24px) saturate(145%);
  -webkit-backdrop-filter: blur(24px) saturate(145%);
}

.site-header--scrolled .brand-logo {
  width: 47px;
  height: 47px;

  flex-basis: 47px;
}

.site-header--scrolled .brand-name strong {
  font-size: 1rem;
}

.site-header--scrolled .brand-name small {
  margin-top: 5px;

  font-size: 0.48rem;
}

.site-header--scrolled .desktop-nav a {
  padding-block: 25px;

  font-size: 0.94rem;
}

.site-header--scrolled .desktop-nav a::after {
  bottom: 12px;
}

.site-header--scrolled .desktop-nav a::before {
  bottom: 8px;
}

.site-header--scrolled .header-cta {
  min-height: 44px;
}

.site-header--scrolled .header-cta span:last-child {
  width: 27px;
  height: 27px;
}

/* =========================================================
   HEADER LOAD ANIMATION — INDIVIDUAL ELEMENTS
   ========================================================= */

.site--ready .desktop-nav a {
  animation:
    premiumNavReveal 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.site--ready .desktop-nav a:nth-child(1) {
  animation-delay: 0.42s;
}

.site--ready .desktop-nav a:nth-child(2) {
  animation-delay: 0.49s;
}

.site--ready .desktop-nav a:nth-child(3) {
  animation-delay: 0.56s;
}

.site--ready .desktop-nav a:nth-child(4) {
  animation-delay: 0.63s;
}

.site--ready .desktop-nav a:nth-child(5) {
  animation-delay: 0.7s;
}

.site--ready .desktop-nav a:nth-child(6) {
  animation-delay: 0.77s;
}

@keyframes premiumNavReveal {
  from {
    opacity: 0;

    transform: translateY(-15px);
  }

  to {
    opacity: 1;

    transform: translateY(0);
  }
}

/* =========================================================
   HEADER RESPONSIVE
   ========================================================= */

@media (max-width: 1180px) {
  .site-header .header-inner {
    min-height: 78px;
  }

  .site-header .brand {
    padding-right: 16px;
  }

  .site-header .brand::after {
    display: none;
  }

  .site-header .desktop-nav {
    gap: 19px;
  }

  .site-header .desktop-nav a {
    padding-block: 29px;

    font-size: 0.92rem;
  }

  .site-header .header-cta {
    padding-left: 17px;
  }
}

@media (max-width: 960px) {
  .site-header {
    top: 10px;
  }

  .site-header .header-inner {
    min-height: 70px;

    padding: 8px 12px 8px 14px;

    border-radius: 3px;
  }

  .site-header--scrolled {
    top: 6px;
  }

  .site-header--scrolled .header-inner {
    min-height: 62px;
  }

  .site-header .brand {
    padding-right: 0;
  }

  .site-header .menu-button {
    display: flex;

    border: 1px solid rgba(215, 183, 125, 0.4);
    border-radius: 50%;

    transition:
      background 0.3s ease,
      border-color 0.3s ease;
  }

  .site-header .menu-button:hover {
    background: rgba(215, 183, 125, 0.12);
    border-color: var(--color-gold);
  }
}

@media (max-width: 640px) {
  .site-header {
    top: 7px;
  }

  .site-header .header-inner {
    min-height: 64px;

    padding: 7px 10px;
  }

  .site-header .brand-logo {
    width: 43px;
    height: 43px;

    flex-basis: 43px;
  }

  .site-header .brand-name strong {
    font-size: 0.85rem;

    letter-spacing: 0.13em;
  }

  .site-header .brand-name small {
    margin-top: 5px;

    font-size: 0.42rem;
    letter-spacing: 0.27em;
  }

  .site-header .menu-button {
    width: 42px;
    height: 42px;
  }
}

/* =========================================================
   EXTENDED HEADER NAVIGATION
   ========================================================= */

.site-header .desktop-nav {
  gap: clamp(15px, 1.55vw, 27px);
}

.site-header .desktop-nav a {
  font-size: 0.92rem;
  letter-spacing: 0.035em;
  white-space: nowrap;
}

@media (max-width: 1240px) {
  .site-header .desktop-nav {
    gap: 15px;
  }

  .site-header .desktop-nav a {
    font-size: 0.84rem;
  }

  .site-header .brand-name {
    display: none;
  }
}
/* =========================================================
   SHARED RESPONSIVE MOBILE NAVIGATION
   ========================================================= */

body.menu-open {
  overflow: hidden;
}

.mobile-menu {
  position: fixed;
  inset: 0;
  z-index: 9000;
  visibility: hidden;
  pointer-events: none;
}

.mobile-menu-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(2, 15, 25, 0.66);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  opacity: 0;
  transition: opacity 0.45s ease;
}

.mobile-menu-panel {
  position: absolute;
  top: 0;
  right: 0;

  display: flex;
  flex-direction: column;

  width: min(100%, 520px);
  height: 100%;
  min-height: 100dvh;

  padding:
    clamp(100px, 13vh, 130px)
    clamp(28px, 6vw, 54px)
    34px;

  overflow-y: auto;
  overflow-x: hidden;

  color: var(--color-white);

  background:
    radial-gradient(
      circle at 85% 12%,
      rgba(215, 183, 125, 0.12),
      transparent 30%
    ),
    var(--color-navy-deep);

  transform: translateX(105%);

  transition:
    transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
}

.mobile-menu--open {
  visibility: visible;
  pointer-events: auto;
}

.mobile-menu--open .mobile-menu-backdrop {
  opacity: 1;
}

.mobile-menu--open .mobile-menu-panel {
  transform: translateX(0);
}

.mobile-menu-decoration {
  position: absolute;
  top: 16%;
  right: -20px;

  pointer-events: none;
  opacity: 0.035;
}

.mobile-menu-decoration span {
  font-family: var(--font-display);
  font-size: clamp(5rem, 20vw, 10rem);
  line-height: 0.8;
  letter-spacing: -0.06em;
  white-space: nowrap;
}

.mobile-menu-top {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding-bottom: 20px;

  border-bottom: 1px solid rgba(215, 183, 125, 0.2);
}

.mobile-menu-label,
.mobile-menu-index {
  color: var(--color-gold-light);

  font-size: 0.7rem;
  font-weight: 600;

  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.mobile-navigation {
  display: flex;
  flex-direction: column;
  margin-top: 12px;
}

.mobile-navigation a {
  position: relative;

  display: grid;
  grid-template-columns: 36px 1fr auto;
  gap: 12px;
  align-items: center;

  min-height: 65px;

  color: rgba(255, 255, 255, 0.76);

  border-bottom: 1px solid rgba(255, 255, 255, 0.08);

  text-decoration: none;

  opacity: 0;
  transform: translateX(30px);

  transition:
    color 0.3s ease,
    border-color 0.3s ease,
    padding-left 0.35s ease;
}

.mobile-menu--open .mobile-navigation a {
  animation:
    mobileNavReveal
    0.65s
    cubic-bezier(0.16, 1, 0.3, 1)
    forwards;
}

.mobile-menu--open .mobile-navigation a:nth-child(1) {
  animation-delay: 0.08s;
}

.mobile-menu--open .mobile-navigation a:nth-child(2) {
  animation-delay: 0.12s;
}

.mobile-menu--open .mobile-navigation a:nth-child(3) {
  animation-delay: 0.16s;
}

.mobile-menu--open .mobile-navigation a:nth-child(4) {
  animation-delay: 0.20s;
}

.mobile-menu--open .mobile-navigation a:nth-child(5) {
  animation-delay: 0.24s;
}

.mobile-menu--open .mobile-navigation a:nth-child(6) {
  animation-delay: 0.28s;
}

.mobile-menu--open .mobile-navigation a:nth-child(7) {
  animation-delay: 0.32s;
}

.mobile-menu--open .mobile-navigation a:nth-child(8) {
  animation-delay: 0.36s;
}

.mobile-navigation a:hover,
.mobile-navigation a.active {
  color: var(--color-gold-light);
  border-color: rgba(215, 183, 125, 0.35);
  padding-left: 8px;
}

.mobile-nav-number {
  color: rgba(215, 183, 125, 0.58);

  font-size: 0.66rem;
  letter-spacing: 0.12em;
}

.mobile-nav-label {
  font-family: var(--font-display);
  font-size: clamp(1.3rem, 5vw, 1.8rem);
  line-height: 1;
}

.mobile-nav-arrow {
  color: var(--color-gold);
  font-size: 1rem;

  opacity: 0;
  transform: translate(-8px, 8px);

  transition:
    opacity 0.3s ease,
    transform 0.3s ease;
}

.mobile-navigation a:hover .mobile-nav-arrow,
.mobile-navigation a.active .mobile-nav-arrow {
  opacity: 1;
  transform: translate(0, 0);
}

.mobile-menu-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;

  margin-top: auto;
  padding-top: 28px;
}

.mobile-menu-bottom p {
  margin: 0;

  color: rgba(255, 255, 255, 0.48);

  font-size: 0.75rem;
  line-height: 1.7;

  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.mobile-consultation {
  display: inline-flex;
  align-items: center;
  gap: 12px;

  color: var(--color-gold-light);

  font-size: 0.75rem;
  font-weight: 600;

  letter-spacing: 0.1em;
  text-decoration: none;
  text-transform: uppercase;
}

.mobile-consultation span {
  transition: transform 0.3s ease;
}

.mobile-consultation:hover span {
  transform: translate(3px, -3px);
}

/* Hamburger animation */

.menu-button {
  position: relative;
  z-index: 9100;
}

.menu-button span {
  transform-origin: center;

  transition:
    transform 0.35s ease,
    width 0.35s ease;
}

.menu-button--active span:first-child {
  transform: translateY(3px) rotate(45deg);
}

.menu-button--active span:last-child {
  transform: translateY(-3px) rotate(-45deg);
}

/* =========================================================
   RESPONSIVE HEADER
   ========================================================= */

@media (min-width: 1101px) {
  .mobile-menu {
    display: none;
  }
}

@media (max-width: 1100px) {
  .desktop-nav,
  .header-cta {
    display: none !important;
  }

  .menu-button {
    display: flex !important;
  }
}

@media (max-width: 640px) {
  .mobile-menu-panel {
    width: 100%;

    padding:
      92px
      22px
      24px;
  }

  .mobile-navigation a {
    grid-template-columns: 30px 1fr auto;
    min-height: 58px;
  }

  .mobile-nav-label {
    font-size: clamp(1.2rem, 6vw, 1.55rem);
  }

  .mobile-menu-bottom {
    align-items: flex-start;
    flex-direction: column;
    gap: 16px;
  }

  .mobile-menu-bottom p {
    display: none;
  }
}

@media (max-height: 700px) and (max-width: 1100px) {
  .mobile-menu-panel {
    padding-top: 82px;
  }

  .mobile-navigation a {
    min-height: 50px;
  }

  .mobile-menu-bottom {
    padding-top: 18px;
  }
}

@keyframes mobileNavReveal {
  from {
    opacity: 0;
    transform: translateX(30px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .mobile-menu-panel,
  .mobile-menu-backdrop,
  .mobile-navigation a,
  .mobile-nav-arrow,
  .menu-button span {
    animation: none !important;
    transition-duration: 0.01ms !important;
  }

  .mobile-menu--open .mobile-navigation a {
    opacity: 1;
    transform: none;
  }
}

/* =========================================================
   MOBILE NAVIGATION - SMALL SCREEN FIT FIX
   ========================================================= */

@media (max-width: 640px) {
  .mobile-menu-panel {
    padding: 84px 20px 20px;
  }

  .mobile-menu-top {
    padding-bottom: 12px;
  }

  .mobile-navigation {
    margin-top: 4px;
  }

  .mobile-navigation a {
    min-height: 45px;
    grid-template-columns: 28px 1fr auto;
    gap: 10px;
  }

  .mobile-nav-number {
    font-size: 0.58rem;
  }

  .mobile-nav-label {
    font-size: clamp(1.05rem, 5.2vw, 1.35rem);
  }

  .mobile-menu-bottom {
    margin-top: 14px;
    padding-top: 12px;
  }

  .mobile-consultation {
    font-size: 0.67rem;
    line-height: 1.4;
  }
}

@media (max-width: 640px) and (max-height: 720px) {
  .mobile-menu-panel {
    padding-top: 72px;
    padding-bottom: 14px;
  }

  .mobile-menu-top {
    padding-bottom: 8px;
  }

  .mobile-menu-label,
  .mobile-menu-index {
    font-size: 0.58rem;
  }

  .mobile-navigation {
    margin-top: 2px;
  }

  .mobile-navigation a {
    min-height: 40px;
  }

  .mobile-nav-label {
    font-size: 1.05rem;
  }

  .mobile-menu-bottom {
    margin-top: 8px;
    padding-top: 8px;
  }
}

/* Keep hamburger/close control visible above mobile drawer */

@media (max-width: 1100px) {
  .site-header {
    z-index: 9200;
  }

  .menu-button {
    position: relative;
    z-index: 9300;
  }
}

/* =========================================================
   SHARED SITE LAYOUT - HEADER REVEAL
   Header now lives outside Home's .site--ready wrapper.
   ========================================================= */

.site-header .header-inner {
  animation:
    headerReveal 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.35s forwards;
}


/* =========================================================
   FEATURED PROJECTS
   Antra-inspired editorial showcase / Vasupriy theme
   ========================================================= */

.featured-projects {
  position: relative;
  overflow: clip;
  background:
    radial-gradient(circle at 92% 8%, rgba(215, 183, 125, 0.12), transparent 28%),
    var(--color-ivory);
  color: var(--color-navy);
}

.featured-projects::before {
  content: "";
  position: absolute;
  top: 0;
  left: var(--page-padding);
  right: var(--page-padding);
  height: 1px;
  background: rgba(14, 41, 67, 0.14);
}

.projects-heading-row {
  display: grid;
  grid-template-columns: minmax(180px, 0.72fr) minmax(0, 2fr);
  gap: clamp(40px, 7vw, 120px);
  align-items: start;
  margin-bottom: clamp(54px, 7vw, 100px);
}

.projects-heading-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 24px;
}

.projects-heading-meta .section-label {
  color: var(--color-gold-dark);
}

.projects-count {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: rgba(14, 41, 67, 0.48);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.projects-heading-copy {
  max-width: 940px;
}

.projects-title {
  margin: 0;
  color: var(--color-navy);
  font-size: clamp(3rem, 5.4vw, 6.5rem);
  font-weight: 400;
  line-height: 0.91;
  letter-spacing: -0.055em;
}

.projects-title em {
  color: var(--color-gold-dark);
  font-weight: 400;
}

.projects-heading-copy > p {
  max-width: 630px;
  margin: clamp(28px, 3vw, 42px) 0 0;
  color: rgba(41, 41, 41, 0.68);
  font-size: clamp(0.95rem, 1.15vw, 1.08rem);
  line-height: 1.8;
}

/* Main editorial layout */

.projects-showcase {
  display: grid;
  grid-template-columns: minmax(0, 1.38fr) minmax(330px, 0.62fr);
  gap: clamp(36px, 5vw, 80px);
  align-items: start;
}

.projects-visual {
  position: sticky;
  top: 118px;
  min-width: 0;
}

.projects-visual-frame {
  position: relative;
  overflow: hidden;
  min-height: clamp(500px, 62vw, 780px);
  background: var(--color-navy-deep);
  isolation: isolate;
}

.projects-visual-frame::before {
  content: "";
  position: absolute;
  inset: 18px;
  z-index: 3;
  border: 1px solid rgba(255, 255, 255, 0.22);
  pointer-events: none;
}

.projects-visual-frame img {
  width: 100%;
  height: 100%;
  min-height: inherit;
  display: block;
  object-fit: cover;
  object-position: center;
  transform: scale(1.025);
  transition:
    transform 1.4s cubic-bezier(0.16, 1, 0.3, 1),
    filter 0.8s ease;
}

.projects-visual-frame:hover img {
  transform: scale(1.07);
}

.projects-visual-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    linear-gradient(
      180deg,
      rgba(5, 18, 30, 0.02) 35%,
      rgba(5, 18, 30, 0.66) 100%
    );
  pointer-events: none;
}

.projects-visual-caption {
  position: absolute;
  z-index: 4;
  left: clamp(30px, 4vw, 58px);
  right: clamp(30px, 4vw, 58px);
  bottom: clamp(30px, 4vw, 50px);
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  color: var(--color-white);
  pointer-events: none;
}

.projects-visual-caption span:first-child {
  font-family: var(--font-display);
  font-size: clamp(1.1rem, 1.7vw, 1.65rem);
}

.projects-visual-caption span:last-child {
  color: rgba(255, 255, 255, 0.68);
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-align: right;
  text-transform: uppercase;
}

/* Project rows */

.projects-list {
  min-width: 0;
}

.project-row {
  position: relative;
  display: grid;
  grid-template-columns: 52px minmax(0, 1fr) 38px;
  gap: clamp(18px, 2vw, 28px);
  align-items: start;
  min-height: clamp(235px, 24vw, 310px);
  padding: clamp(34px, 4vw, 52px) 0;
  border-top: 1px solid rgba(14, 41, 67, 0.16);
  transition:
    padding-left 0.45s cubic-bezier(0.16, 1, 0.3, 1),
    border-color 0.35s ease;
}

.project-row:last-child {
  border-bottom: 1px solid rgba(14, 41, 67, 0.16);
}

.project-row::before {
  content: "";
  position: absolute;
  top: -1px;
  left: 0;
  width: 0;
  height: 1px;
  background: var(--color-gold);
  transition: width 0.65s cubic-bezier(0.16, 1, 0.3, 1);
}

.project-row:hover {
  padding-left: 12px;
}

.project-row:hover::before {
  width: 100%;
}

.project-number {
  padding-top: 6px;
  color: var(--color-gold-dark);
  font-family: var(--font-display);
  font-size: 0.82rem;
  letter-spacing: 0.08em;
}

.project-row-content {
  min-width: 0;
}

.project-kicker {
  display: block;
  margin-bottom: 16px;
  color: rgba(14, 41, 67, 0.48);
  font-size: 0.61rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.project-row h3 {
  margin: 0;
  color: var(--color-navy);
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 2.65vw, 3rem);
  font-weight: 400;
  line-height: 1;
  letter-spacing: -0.035em;
}

.project-row p {
  max-width: 390px;
  margin: 18px 0 0;
  color: rgba(41, 41, 41, 0.62);
  font-size: 0.86rem;
  line-height: 1.75;
}

.project-row-arrow {
  display: grid;
  width: 34px;
  height: 34px;
  place-items: center;
  margin-top: 2px;
  border: 1px solid rgba(14, 41, 67, 0.18);
  border-radius: 50%;
  color: var(--color-navy);
  font-size: 0.88rem;
  transition:
    color 0.35s ease,
    background 0.35s ease,
    border-color 0.35s ease,
    transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
}

.project-row:hover .project-row-arrow {
  transform: rotate(45deg);
  border-color: var(--color-navy);
  background: var(--color-navy);
  color: var(--color-white);
}

/* Footer CTA */

.projects-footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 40px;
  margin-top: clamp(52px, 6vw, 90px);
  padding-top: 28px;
  border-top: 1px solid rgba(14, 41, 67, 0.14);
}

.projects-footer > p {
  max-width: 450px;
  margin: 0;
  color: rgba(41, 41, 41, 0.5);
  font-size: 0.72rem;
  line-height: 1.7;
}

.projects-view-all {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 28px;
  padding: 0 0 12px;
  color: var(--color-navy);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.13em;
  text-decoration: none;
  text-transform: uppercase;
}

.projects-view-all::after {
  content: "";
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 1px;
  background:
    linear-gradient(
      90deg,
      var(--color-gold) 0 50%,
      rgba(14, 41, 67, 0.2) 50% 100%
    );
  background-size: 200% 100%;
  background-position: 100% 0;
  transition: background-position 0.5s ease;
}

.projects-view-all:hover::after {
  background-position: 0 0;
}

.projects-view-all > span:last-child {
  font-size: 1rem;
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.projects-view-all:hover > span:last-child {
  transform: translate(4px, -4px);
}

/* =========================================================
   FEATURED PROJECTS - TABLET
   ========================================================= */

@media (max-width: 1100px) {
  .projects-heading-row {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .projects-heading-meta {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .projects-showcase {
    grid-template-columns: 1fr;
    gap: 34px;
  }

  .projects-visual {
    position: relative;
    top: auto;
  }

  .projects-visual-frame {
    min-height: clamp(430px, 67vw, 680px);
  }

  .projects-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid rgba(14, 41, 67, 0.16);
  }

  .project-row {
    grid-template-columns: 34px minmax(0, 1fr);
    min-height: 300px;
    padding: 32px 24px;
    border-right: 1px solid rgba(14, 41, 67, 0.16);
  }

  .project-row:last-child {
    border-right: 0;
    border-bottom: 0;
  }

  .project-row-arrow {
    position: absolute;
    right: 22px;
    bottom: 26px;
  }

  .project-row:hover {
    padding-left: 24px;
  }

  .project-row h3 {
    font-size: clamp(1.55rem, 3vw, 2.2rem);
  }
}

/* =========================================================
   FEATURED PROJECTS - MOBILE
   ========================================================= */

@media (max-width: 720px) {
  .featured-projects::before {
    left: 20px;
    right: 20px;
  }

  .projects-heading-row {
    margin-bottom: 38px;
  }

  .projects-heading-meta {
    gap: 18px;
  }

  .projects-count {
    font-size: 0.58rem;
  }

  .projects-title {
    font-size: clamp(2.65rem, 12vw, 4.4rem);
    line-height: 0.94;
  }

  .projects-heading-copy > p {
    margin-top: 24px;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .projects-showcase {
    gap: 20px;
  }

  .projects-visual-frame {
    min-height: 0;
    aspect-ratio: 1 / 1.18;
  }

  .projects-visual-frame img {
    min-height: 0;
    object-position: center;
  }

  .projects-visual-frame::before {
    inset: 10px;
  }

  .projects-visual-caption {
    left: 22px;
    right: 22px;
    bottom: 22px;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .projects-visual-caption span:last-child {
    text-align: left;
  }

  .projects-list {
    display: block;
    border-bottom: 0;
  }

  .project-row {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) 32px;
    min-height: 0;
    gap: 14px;
    padding: 30px 0;
    border-right: 0;
  }

  .project-row:last-child {
    border-bottom: 1px solid rgba(14, 41, 67, 0.16);
  }

  .project-row:hover {
    padding-left: 0;
  }

  .project-kicker {
    margin-bottom: 10px;
    font-size: 0.56rem;
  }

  .project-row h3 {
    font-size: clamp(1.75rem, 8vw, 2.35rem);
  }

  .project-row p {
    margin-top: 14px;
    font-size: 0.8rem;
  }

  .project-row-arrow {
    position: static;
    right: auto;
    bottom: auto;
    width: 30px;
    height: 30px;
  }

  .projects-footer {
    display: block;
    margin-top: 44px;
  }

  .projects-footer > p {
    margin-bottom: 30px;
  }

  .projects-view-all {
    width: 100%;
    justify-content: space-between;
  }
}

/* =========================================================
   FEATURED PROJECTS - REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {
  .projects-visual-frame img,
  .project-row,
  .project-row::before,
  .project-row-arrow,
  .projects-view-all::after,
  .projects-view-all > span:last-child {
    transition: none !important;
  }

  .projects-visual-frame:hover img {
    transform: none;
  }
}


/* =========================================================
   FEATURED PROJECTS - INTERACTIVE VISUAL STATES
   ========================================================= */

.projects-image-stack {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
}

.project-visual-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  min-height: 0;
  object-fit: cover;
  object-position: center;

  opacity: 0;
  visibility: hidden;

  transform: scale(1.08);
  filter: saturate(0.86) brightness(0.9);

  transition:
    opacity 0.75s ease,
    visibility 0.75s ease,
    transform 1.25s cubic-bezier(0.16, 1, 0.3, 1),
    filter 1s ease;
}

.project-visual-image--active {
  opacity: 1;
  visibility: visible;
  transform: scale(1.01);
  filter: saturate(1) brightness(1);
}

/* Prevent old generic image hover rule from scaling every layer */

.projects-visual-frame:hover .project-visual-image {
  transform: scale(1.08);
}

.projects-visual-frame:hover .project-visual-image--active {
  transform: scale(1.045);
}

/* Image counter */

.projects-visual-index {
  position: absolute;
  z-index: 4;
  top: clamp(30px, 3.5vw, 48px);
  right: clamp(30px, 3.5vw, 48px);

  display: flex;
  align-items: center;
  gap: 13px;

  color: var(--color-white);
  font-size: 0.64rem;
  font-weight: 700;
  letter-spacing: 0.16em;
}

.projects-visual-index::before {
  content: "";
  width: 34px;
  height: 1px;
  background: rgba(255, 255, 255, 0.55);
}

.projects-visual-index span:first-child {
  color: var(--color-gold-light);
  font-family: var(--font-display);
  font-size: 1rem;
}

.projects-visual-index span:last-child {
  color: rgba(255, 255, 255, 0.58);
}

/* Active project row */

.project-row {
  outline: none;
}

.project-row--active {
  border-color: rgba(215, 183, 125, 0.52);
}

.project-row--active::before {
  width: 100%;
}

.project-row--active .project-number {
  color: var(--color-gold-dark);
}

.project-row--active .project-kicker {
  color: var(--color-gold-dark);
}

.project-row--active h3 {
  color: var(--color-navy-deep);
}

.project-row--active .project-row-arrow {
  transform: rotate(45deg);
  border-color: var(--color-navy);
  background: var(--color-navy);
  color: var(--color-white);
}

.project-row:focus-visible {
  outline: 1px solid var(--color-gold);
  outline-offset: 6px;
}

/* Caption transition */

.projects-visual-caption span:first-child {
  animation: projectCaptionReveal 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes projectCaptionReveal {
  from {
    opacity: 0;
    transform: translateY(14px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* =========================================================
   PROJECT VISUAL - TABLET / MOBILE
   ========================================================= */

@media (max-width: 1100px) {
  .project-visual-image {
    object-position: center;
  }

  .projects-visual-index {
    top: 30px;
    right: 30px;
  }
}

@media (max-width: 720px) {
  .projects-visual-index {
    top: 22px;
    right: 22px;
    gap: 9px;
    font-size: 0.55rem;
  }

  .projects-visual-index::before {
    width: 22px;
  }

  .projects-visual-index span:first-child {
    font-size: 0.82rem;
  }

  .project-row--active {
    padding-left: 0;
  }

  .projects-visual-frame:hover .project-visual-image--active {
    transform: scale(1.01);
  }
}

/* =========================================================
   PROJECT VISUAL - REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {
  .project-visual-image,
  .projects-visual-caption span:first-child {
    animation: none !important;
    transition: none !important;
  }

  .project-visual-image--active,
  .projects-visual-frame:hover .project-visual-image--active {
    transform: none;
  }
}


/* =========================================================
   FEATURED PROJECTS - CINEMATIC ENTRANCE MOTION
   ========================================================= */

/* Initial states */

.featured-projects .projects-heading-meta {
  opacity: 0;
  transform: translateY(28px);
}

.featured-projects .projects-title {
  opacity: 0;
  transform: translateY(46px);
}

.featured-projects .projects-heading-copy > p {
  opacity: 0;
  transform: translateY(30px);
}

.featured-projects .projects-visual {
  opacity: 0;
  transform: translateY(54px);
}

.featured-projects .projects-visual-frame {
  clip-path: inset(0 0 100% 0);
}

.featured-projects .project-row {
  opacity: 0;
  transform: translateY(34px);
}

.featured-projects .projects-footer {
  opacity: 0;
  transform: translateY(24px);
}

/* ---------------------------------------------------------
   Section enters viewport
   --------------------------------------------------------- */

.featured-projects--visible .projects-heading-meta {
  animation:
    projectsRevealUp 0.75s cubic-bezier(0.16, 1, 0.3, 1)
    0.05s forwards;
}

.featured-projects--visible .projects-title {
  animation:
    projectsRevealUp 0.95s cubic-bezier(0.16, 1, 0.3, 1)
    0.14s forwards;
}

.featured-projects--visible .projects-heading-copy > p {
  animation:
    projectsRevealUp 0.8s cubic-bezier(0.16, 1, 0.3, 1)
    0.28s forwards;
}

.featured-projects--visible .projects-visual {
  animation:
    projectsRevealUp 1s cubic-bezier(0.16, 1, 0.3, 1)
    0.34s forwards;
}

.featured-projects--visible .projects-visual-frame {
  animation:
    projectFrameReveal 1.15s cubic-bezier(0.16, 1, 0.3, 1)
    0.3s forwards;
}

.featured-projects--visible .project-row:nth-child(1) {
  animation:
    projectsRevealUp 0.8s cubic-bezier(0.16, 1, 0.3, 1)
    0.42s forwards;
}

.featured-projects--visible .project-row:nth-child(2) {
  animation:
    projectsRevealUp 0.8s cubic-bezier(0.16, 1, 0.3, 1)
    0.54s forwards;
}

.featured-projects--visible .project-row:nth-child(3) {
  animation:
    projectsRevealUp 0.8s cubic-bezier(0.16, 1, 0.3, 1)
    0.66s forwards;
}

.featured-projects--visible .projects-footer {
  animation:
    projectsRevealUp 0.8s cubic-bezier(0.16, 1, 0.3, 1)
    0.72s forwards;
}

/* ---------------------------------------------------------
   Active row micro-interactions
   --------------------------------------------------------- */

.project-row--active .project-number {
  animation:
    projectNumberPulse 0.55s cubic-bezier(0.16, 1, 0.3, 1);
}

.project-row--active .project-row-content {
  transform: translateX(4px);
  transition:
    transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

.project-row:not(.project-row--active) .project-row-content {
  transform: translateX(0);
  transition:
    transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

/* ---------------------------------------------------------
   Image counter motion
   --------------------------------------------------------- */

.projects-visual-index span:first-child {
  animation:
    projectCounterReveal 0.55s cubic-bezier(0.16, 1, 0.3, 1);
}

/* ---------------------------------------------------------
   Premium frame shimmer
   --------------------------------------------------------- */

.projects-visual-frame::after {
  content: "";
  position: absolute;
  z-index: 5;
  top: 0;
  bottom: 0;
  left: -55%;
  width: 34%;
  pointer-events: none;

  background:
    linear-gradient(
      105deg,
      transparent 0%,
      rgba(255, 255, 255, 0.04) 30%,
      rgba(215, 183, 125, 0.15) 50%,
      rgba(255, 255, 255, 0.04) 70%,
      transparent 100%
    );

  transform: skewX(-14deg);
  opacity: 0;
}

.featured-projects--visible .projects-visual-frame::after {
  animation:
    projectFrameShimmer 1.35s ease 0.85s 1 forwards;
}

/* ---------------------------------------------------------
   Keyframes
   --------------------------------------------------------- */

@keyframes projectsRevealUp {
  from {
    opacity: 0;
    transform: translateY(38px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes projectFrameReveal {
  from {
    clip-path: inset(0 0 100% 0);
  }

  to {
    clip-path: inset(0 0 0 0);
  }
}

@keyframes projectNumberPulse {
  0% {
    opacity: 0.35;
    transform: translateY(8px);
  }

  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes projectCounterReveal {
  0% {
    opacity: 0;
    transform: translateY(-8px);
  }

  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes projectFrameShimmer {
  0% {
    left: -55%;
    opacity: 0;
  }

  18% {
    opacity: 1;
  }

  75% {
    opacity: 0.65;
  }

  100% {
    left: 125%;
    opacity: 0;
  }
}

/* ---------------------------------------------------------
   Touch / mobile refinement
   --------------------------------------------------------- */

@media (max-width: 720px) {
  .featured-projects .projects-title,
  .featured-projects .projects-heading-copy > p,
  .featured-projects .projects-heading-meta,
  .featured-projects .projects-visual,
  .featured-projects .project-row,
  .featured-projects .projects-footer {
    transform: translateY(22px);
  }

  .featured-projects--visible .project-row:nth-child(1) {
    animation-delay: 0.28s;
  }

  .featured-projects--visible .project-row:nth-child(2) {
    animation-delay: 0.36s;
  }

  .featured-projects--visible .project-row:nth-child(3) {
    animation-delay: 0.44s;
  }

  .project-row--active .project-row-content {
    transform: none;
  }
}

/* ---------------------------------------------------------
   Accessibility - reduced motion
   --------------------------------------------------------- */

@media (prefers-reduced-motion: reduce) {
  .featured-projects .projects-heading-meta,
  .featured-projects .projects-title,
  .featured-projects .projects-heading-copy > p,
  .featured-projects .projects-visual,
  .featured-projects .project-row,
  .featured-projects .projects-footer {
    opacity: 1 !important;
    transform: none !important;
    animation: none !important;
  }

  .featured-projects .projects-visual-frame {
    clip-path: none !important;
    animation: none !important;
  }

  .projects-visual-frame::after,
  .project-row--active .project-number,
  .projects-visual-index span:first-child {
    animation: none !important;
  }

  .project-row-content {
    transform: none !important;
    transition: none !important;
  }
}


/* =========================================================
   FEATURED PROJECTS - IMAGE TRANSITION SPECIFICITY FIX
   Keeps generic frame image rules from overriding
   interactive project image states.
   ========================================================= */

.projects-visual-frame .project-visual-image {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;
  min-height: 0;

  object-fit: cover;
  object-position: center;

  opacity: 0;
  visibility: hidden;

  transform: scale(1.08);
  filter: saturate(0.86) brightness(0.9);

  transition:
    opacity 0.75s ease,
    visibility 0.75s ease,
    transform 1.25s cubic-bezier(0.16, 1, 0.3, 1),
    filter 1s ease;
}

.projects-visual-frame .project-visual-image--active {
  opacity: 1;
  visibility: visible;

  transform: scale(1.01);
  filter: saturate(1) brightness(1);
}

.projects-visual-frame:hover .project-visual-image {
  transform: scale(1.08);
}

.projects-visual-frame:hover .project-visual-image--active {
  transform: scale(1.045);
}

@media (max-width: 720px) {
  .projects-visual-frame:hover .project-visual-image--active {
    transform: scale(1.01);
  }
}

@media (prefers-reduced-motion: reduce) {
  .projects-visual-frame .project-visual-image {
    transition: none !important;
  }

  .projects-visual-frame .project-visual-image--active,
  .projects-visual-frame:hover .project-visual-image--active {
    transform: none !important;
  }
}


/* =========================================================
   FEATURED PROJECTS - DESKTOP SCROLL STORY
   Gives each project enough vertical travel while the
   visual remains pinned beside the active project.
   ========================================================= */

@media (min-width: 1101px) {
  .featured-projects .projects-showcase {
    align-items: stretch;
  }

  .featured-projects .projects-visual {
    position: sticky;
    top: clamp(96px, 10vh, 118px);
    align-self: start;
    height: calc(100vh - clamp(120px, 14vh, 160px));
    min-height: 560px;
    max-height: 760px;
  }

  .featured-projects .projects-visual-frame {
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .featured-projects .projects-list {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .featured-projects .project-row {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) 38px;
    align-content: center;

    min-height: clamp(500px, 72vh, 720px);
    padding-top: clamp(70px, 9vh, 110px);
    padding-bottom: clamp(70px, 9vh, 110px);
  }

  .featured-projects .project-row-content {
    align-self: center;
  }

  .featured-projects .project-number,
  .featured-projects .project-row-arrow {
    align-self: center;
  }

  .featured-projects .project-row:hover {
    padding-left: 12px;
  }
}

/* Large desktop: keep the storytelling spacious without
   making each step excessively tall. */
@media (min-width: 1600px) {
  .featured-projects .project-row {
    min-height: clamp(560px, 68vh, 760px);
  }

  .featured-projects .projects-visual {
    max-height: 800px;
  }
}


/* =========================================================
   FEATURED PROJECTS - DESKTOP FINAL GEOMETRY POLISH
   ========================================================= */

@media (min-width: 1101px) {
  .featured-projects .projects-visual {
    height: calc(100vh - clamp(150px, 17vh, 190px));
    min-height: 520px;
    max-height: 720px;
  }

  .featured-projects .project-row {
    min-height: clamp(440px, 63vh, 620px);
    padding-top: clamp(58px, 7vh, 90px);
    padding-bottom: clamp(58px, 7vh, 90px);
  }
}

@media (min-width: 1600px) {
  .featured-projects .projects-visual {
    max-height: 760px;
  }

  .featured-projects .project-row {
    min-height: clamp(500px, 61vh, 680px);
  }
}


/* =========================================================
   FEATURED PROJECTS - DESKTOP FINAL GEOMETRY POLISH
   ========================================================= */

@media (min-width: 1101px) {
  .featured-projects .projects-visual {
    height: calc(100vh - clamp(150px, 17vh, 190px));
    min-height: 520px;
    max-height: 720px;
  }

  .featured-projects .project-row {
    min-height: clamp(440px, 63vh, 620px);
    padding-top: clamp(58px, 7vh, 90px);
    padding-bottom: clamp(58px, 7vh, 90px);
  }
}

@media (min-width: 1600px) {
  .featured-projects .projects-visual {
    max-height: 760px;
  }

  .featured-projects .project-row {
    min-height: clamp(500px, 61vh, 680px);
  }
}


/* =========================================================
   FEATURED PROJECTS - RESPONSIVE SCROLL STORY
   Tablet: pinned visual + vertical project chapters
   Mobile: compact pinned visual + touch-friendly chapters
   ========================================================= */

/* ---------------- TABLET ---------------- */

@media (min-width: 721px) and (max-width: 1100px) {
  .featured-projects .projects-showcase {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.72fr);
    gap: clamp(28px, 4vw, 48px);
    align-items: stretch;
  }

  .featured-projects .projects-visual {
    position: sticky;
    top: 96px;
    align-self: start;
    height: min(64vh, 620px);
    min-height: 430px;
  }

  .featured-projects .projects-visual-frame {
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .featured-projects .projects-list {
    display: flex;
    flex-direction: column;
    border-bottom: 0;
  }

  .featured-projects .project-row {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    min-height: clamp(360px, 52vh, 500px);
    padding: 46px 20px;
    border-right: 0;
    border-bottom: 0;
  }

  .featured-projects .project-row:last-child {
    border-right: 0;
    border-bottom: 1px solid rgba(14, 41, 67, 0.16);
  }

  .featured-projects .project-row:hover {
    padding-left: 20px;
  }

  .featured-projects .project-row-arrow {
    position: absolute;
    right: 20px;
    bottom: 28px;
  }

  .featured-projects .project-row h3 {
    font-size: clamp(1.65rem, 3.2vw, 2.45rem);
  }
}


/* ---------------- MOBILE ---------------- */

@media (max-width: 720px) {
  .featured-projects .projects-showcase {
    display: block;
  }

  .featured-projects .projects-visual {
    position: sticky;
    top: 76px;
    z-index: 8;

    width: 100%;
    margin-bottom: 18px;

    background: var(--color-ivory);
  }

  .featured-projects .projects-visual-frame {
    width: 100%;
    height: clamp(270px, 68vw, 390px);
    min-height: 0;
    aspect-ratio: auto;
  }

  .featured-projects .projects-list {
    position: relative;
    z-index: 2;

    display: block;
    border-bottom: 0;

    background: var(--color-ivory);
  }

  .featured-projects .project-row {
    min-height: clamp(270px, 72vh, 390px);
    padding-top: 42px;
    padding-bottom: 42px;
  }

  .featured-projects .project-row:first-child {
    border-top-color: rgba(14, 41, 67, 0.16);
  }

  .featured-projects .projects-visual-caption {
    left: 20px;
    right: 20px;
    bottom: 18px;
  }

  .featured-projects .projects-visual-index {
    top: 20px;
    right: 20px;
  }
}


/* Very small phones */

@media (max-width: 430px) {
  .featured-projects .projects-visual {
    top: 70px;
  }

  .featured-projects .projects-visual-frame {
    height: clamp(245px, 70vw, 310px);
  }

  .featured-projects .project-row {
    min-height: 300px;
  }
}


/* =========================================================
   FEATURED PROJECTS - MOBILE FINAL POLISH
   Keeps the pinned visual compact on short phone screens.
   ========================================================= */

@media (max-width: 720px) {
  .featured-projects .projects-visual-frame {
    height: clamp(235px, 61vw, 330px);
  }

  .featured-projects .project-row {
    min-height: clamp(250px, 52vh, 340px);
    padding-top: 38px;
    padding-bottom: 38px;
  }

  .featured-projects .projects-visual-caption {
    bottom: 16px;
  }
}

@media (max-width: 430px) {
  .featured-projects .projects-visual-frame {
    height: clamp(225px, 60vw, 285px);
  }

  .featured-projects .project-row {
    min-height: 280px;
  }
}


/* =========================================================
   HOME SERVICES
   Vasupriy navy / champagne interpretation
   ========================================================= */

.home-services {
  position: relative;
  overflow: hidden;
  background:
    linear-gradient(
      135deg,
      #081d30 0%,
      var(--color-navy) 48%,
      #102f4b 100%
    );
  color: var(--color-ivory);
  isolation: isolate;
}

.home-services::before {
  content: "";
  position: absolute;
  top: 0;
  left: var(--page-padding);
  right: var(--page-padding);
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(215, 183, 125, 0.5),
    transparent
  );
}

.home-services-atmosphere,
.home-services-grid,
.home-services-glow {
  position: absolute;
  pointer-events: none;
}

.home-services-atmosphere {
  inset: 0;
  overflow: hidden;
  z-index: -1;
}

.home-services-grid {
  inset: 0;
  opacity: 0.055;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.12) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.12) 1px, transparent 1px);
  background-size: 80px 80px;
  mask-image: linear-gradient(to bottom, black, transparent 90%);
}

.home-services-glow {
  border-radius: 50%;
  filter: blur(1px);
}

.home-services-glow--one {
  width: 540px;
  height: 540px;
  top: -260px;
  right: -140px;
  background: radial-gradient(
    circle,
    rgba(215, 183, 125, 0.14),
    transparent 68%
  );
}

.home-services-glow--two {
  width: 500px;
  height: 500px;
  bottom: -300px;
  left: -160px;
  background: radial-gradient(
    circle,
    rgba(215, 183, 125, 0.09),
    transparent 70%
  );
}

.home-services-container {
  position: relative;
  z-index: 2;
}


/* ---------------- HEADING ---------------- */

.home-services-heading {
  display: grid;
  grid-template-columns: minmax(190px, 0.58fr) minmax(0, 1.42fr);
  gap: clamp(40px, 7vw, 110px);
  align-items: start;
  margin-bottom: clamp(64px, 8vw, 110px);
}

.home-services-heading-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 26px;
  padding-top: 9px;
}

.home-services-label {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 9px 15px;
  border: 1px solid rgba(215, 183, 125, 0.38);
  border-radius: 999px;

  color: var(--color-gold);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.home-services-label > span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--color-gold);
  box-shadow: 0 0 0 5px rgba(215, 183, 125, 0.1);
}

.home-services-count {
  color: rgba(245, 240, 234, 0.44);
  font-size: 0.68rem;
  letter-spacing: 0.18em;
}

.home-services-heading-copy h2 {
  margin: 0;
  max-width: 920px;

  color: var(--color-ivory);
  font-family: var(--font-heading);
  font-size: clamp(3.1rem, 5.7vw, 6.5rem);
  font-weight: 400;
  line-height: 0.94;
  letter-spacing: -0.055em;
}

.home-services-heading-copy h2 span {
  color: var(--color-gold);
  font-style: italic;
}

.home-services-heading-copy > p {
  max-width: 630px;
  margin: 34px 0 0;

  color: rgba(245, 240, 234, 0.68);
  font-size: clamp(0.92rem, 1.1vw, 1.05rem);
  line-height: 1.8;
}


/* ---------------- MAIN STAGE ---------------- */

.home-services-stage {
  display: grid;
  grid-template-columns: minmax(0, 0.92fr) minmax(420px, 1.08fr);
  gap: clamp(48px, 7vw, 110px);
  align-items: stretch;
}

.home-services-content {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.home-services-list {
  border-top: 1px solid rgba(245, 240, 234, 0.17);
}

.home-service-item {
  position: relative;
  display: grid;
  grid-template-columns: 52px minmax(0, 1fr) 34px;
  gap: 18px;
  align-items: center;

  width: 100%;
  min-height: 92px;
  padding: 22px 0;

  border: 0;
  border-bottom: 1px solid rgba(245, 240, 234, 0.17);
  background: transparent;

  color: rgba(245, 240, 234, 0.56);
  text-align: left;
  cursor: pointer;

  transition:
    color 0.4s ease,
    padding-left 0.45s cubic-bezier(0.16, 1, 0.3, 1),
    border-color 0.4s ease;
}

.home-service-item::before {
  content: "";
  position: absolute;
  left: 0;
  bottom: -1px;

  width: 0;
  height: 1px;

  background: var(--color-gold);

  transition: width 0.65s cubic-bezier(0.16, 1, 0.3, 1);
}

.home-service-number {
  color: rgba(215, 183, 125, 0.56);
  font-size: 0.66rem;
  letter-spacing: 0.16em;
  transition: color 0.35s ease;
}

.home-service-title {
  font-family: var(--font-heading);
  font-size: clamp(1.55rem, 2.25vw, 2.55rem);
  font-weight: 400;
  line-height: 1.08;
  letter-spacing: -0.025em;
}

.home-service-arrow {
  display: grid;
  place-items: center;

  width: 32px;
  height: 32px;

  border: 1px solid rgba(245, 240, 234, 0.22);
  border-radius: 50%;

  font-size: 0.9rem;

  opacity: 0.42;
  transform: rotate(0deg);

  transition:
    opacity 0.35s ease,
    color 0.35s ease,
    border-color 0.35s ease,
    transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
}

.home-service-item:hover,
.home-service-item:focus-visible,
.home-service-item--active {
  color: var(--color-gold);
  padding-left: 12px;
  outline: none;
}

.home-service-item--active {
  border-bottom-color: rgba(215, 183, 125, 0.48);
}

.home-service-item--active::before {
  width: 100%;
}

.home-service-item:hover .home-service-number,
.home-service-item:focus-visible .home-service-number,
.home-service-item--active .home-service-number {
  color: var(--color-gold);
}

.home-service-item:hover .home-service-arrow,
.home-service-item:focus-visible .home-service-arrow,
.home-service-item--active .home-service-arrow {
  color: var(--color-navy-deep);
  border-color: var(--color-gold);
  background: var(--color-gold);
  opacity: 1;
  transform: rotate(45deg);
}


/* ---------------- DESCRIPTION / CTA ---------------- */

.home-services-description {
  min-height: 104px;
  margin-top: 38px;
}

.home-services-description p {
  max-width: 540px;
  margin: 0;

  color: rgba(245, 240, 234, 0.7);
  font-size: 0.94rem;
  line-height: 1.8;

  animation: homeServiceTextReveal 0.55s
    cubic-bezier(0.16, 1, 0.3, 1);
}

.home-services-cta {
  position: relative;

  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: 34px;

  width: fit-content;
  min-width: 245px;
  margin-top: 28px;
  padding: 17px 20px 17px 22px;

  border: 1px solid rgba(215, 183, 125, 0.55);
  border-radius: 999px;

  color: var(--color-ivory);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-decoration: none;
  text-transform: uppercase;

  overflow: hidden;
  isolation: isolate;

  transition:
    color 0.4s ease,
    border-color 0.4s ease;
}

.home-services-cta::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;

  background: var(--color-gold);
  transform: translateX(-102%);

  transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
}

.home-services-cta:hover {
  color: var(--color-navy-deep);
  border-color: var(--color-gold);
}

.home-services-cta:hover::before {
  transform: translateX(0);
}

.home-services-cta-arrow {
  font-size: 1rem;
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.home-services-cta:hover .home-services-cta-arrow {
  transform: translate(3px, -3px);
}


/* ---------------- VISUAL ---------------- */

.home-services-visual {
  min-width: 0;
}

.home-services-image-frame {
  position: relative;
  overflow: hidden;

  width: 100%;
  height: 100%;
  min-height: 590px;

  border-radius: 2px 42px 2px 42px;
  background: #081b2c;

  box-shadow:
    0 28px 80px rgba(0, 0, 0, 0.22),
    inset 0 0 0 1px rgba(215, 183, 125, 0.1);

  isolation: isolate;
}

.home-services-image-frame::before {
  content: "";
  position: absolute;
  inset: 16px;
  z-index: 4;

  border: 1px solid rgba(215, 183, 125, 0.26);
  border-radius: 1px 30px 1px 30px;

  pointer-events: none;
}

.home-service-image {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;
  object-fit: cover;

  opacity: 0;
  visibility: hidden;
  transform: scale(1.08);

  filter: saturate(0.84) brightness(0.8);

  transition:
    opacity 0.72s ease,
    visibility 0.72s ease,
    transform 1.15s cubic-bezier(0.16, 1, 0.3, 1),
    filter 0.9s ease;
}

.home-service-image--active {
  opacity: 1;
  visibility: visible;
  transform: scale(1.01);
  filter: saturate(0.96) brightness(0.9);
}

.home-services-image-frame:hover .home-service-image--active {
  transform: scale(1.045);
}

.home-services-image-shade {
  position: absolute;
  inset: 0;
  z-index: 2;

  background:
    linear-gradient(
      180deg,
      rgba(5, 20, 33, 0.08) 25%,
      rgba(5, 20, 33, 0.28) 58%,
      rgba(5, 20, 33, 0.82) 100%
    ),
    linear-gradient(
      90deg,
      rgba(5, 20, 33, 0.18),
      transparent 52%
    );

  pointer-events: none;
}

.home-services-visual-index {
  position: absolute;
  top: 36px;
  right: 38px;
  z-index: 5;

  display: flex;
  align-items: baseline;
  gap: 7px;

  color: var(--color-ivory);
}

.home-services-visual-index span:first-child {
  color: var(--color-gold);
  font-family: var(--font-heading);
  font-size: clamp(2.5rem, 4vw, 4.5rem);
  line-height: 1;

  animation: homeServiceCounterReveal 0.5s
    cubic-bezier(0.16, 1, 0.3, 1);
}

.home-services-visual-index span:last-child {
  color: rgba(245, 240, 234, 0.5);
  font-size: 0.7rem;
  letter-spacing: 0.12em;
}

.home-services-visual-caption {
  position: absolute;
  left: 42px;
  right: 42px;
  bottom: 38px;
  z-index: 5;

  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 30px;

  color: var(--color-ivory);
}

.home-services-visual-caption > span {
  max-width: 390px;

  font-family: var(--font-heading);
  font-size: clamp(1.7rem, 2.8vw, 3rem);
  line-height: 1.02;
  letter-spacing: -0.025em;

  animation: homeServiceTextReveal 0.55s
    cubic-bezier(0.16, 1, 0.3, 1);
}

.home-services-visual-caption small {
  max-width: 190px;

  color: rgba(245, 240, 234, 0.6);
  font-size: 0.58rem;
  line-height: 1.6;
  letter-spacing: 0.14em;
  text-align: right;
  text-transform: uppercase;
}


/* ---------------- ANIMATION ---------------- */

@keyframes homeServiceTextReveal {
  from {
    opacity: 0;
    transform: translateY(14px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes homeServiceCounterReveal {
  from {
    opacity: 0;
    transform: translateY(-12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}


/* =========================================================
   HOME SERVICES - TABLET
   ========================================================= */

@media (max-width: 1100px) {
  .home-services-heading {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .home-services-heading-meta {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .home-services-stage {
    grid-template-columns: minmax(0, 0.95fr) minmax(340px, 1.05fr);
    gap: 36px;
  }

  .home-service-item {
    grid-template-columns: 40px minmax(0, 1fr) 32px;
  }

  .home-service-title {
    font-size: clamp(1.4rem, 2.8vw, 2rem);
  }

  .home-services-image-frame {
    min-height: 520px;
  }
}


/* =========================================================
   HOME SERVICES - MOBILE
   ========================================================= */

@media (max-width: 760px) {
  .home-services-heading {
    margin-bottom: 48px;
  }

  .home-services-heading-meta {
    gap: 18px;
  }

  .home-services-heading-copy h2 {
    font-size: clamp(2.65rem, 11.5vw, 4.3rem);
  }

  .home-services-heading-copy > p {
    margin-top: 24px;
    font-size: 0.88rem;
  }

  .home-services-stage {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .home-services-content {
    order: 2;
  }

  .home-services-visual {
    order: 1;
  }

  .home-services-image-frame {
    min-height: 0;
    height: clamp(330px, 105vw, 480px);
    border-radius: 2px 28px 2px 28px;
  }

  .home-services-image-frame::before {
    inset: 10px;
    border-radius: 1px 20px 1px 20px;
  }

  .home-services-visual-index {
    top: 24px;
    right: 24px;
  }

  .home-services-visual-caption {
    left: 24px;
    right: 24px;
    bottom: 24px;

    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .home-services-visual-caption small {
    text-align: left;
  }

  .home-service-item {
    grid-template-columns: 36px minmax(0, 1fr) 30px;
    min-height: 82px;
    gap: 12px;
    padding: 20px 0;
  }

  .home-service-item:hover,
  .home-service-item:focus-visible,
  .home-service-item--active {
    padding-left: 6px;
  }

  .home-service-title {
    font-size: clamp(1.35rem, 6vw, 1.85rem);
  }

  .home-services-description {
    min-height: 0;
    margin-top: 30px;
  }

  .home-services-cta {
    width: 100%;
    margin-top: 26px;
  }
}


/* =========================================================
   HOME SERVICES - SMALL MOBILE
   ========================================================= */

@media (max-width: 430px) {
  .home-services-count {
    display: none;
  }

  .home-services-image-frame {
    height: 320px;
  }

  .home-services-visual-caption > span {
    font-size: 1.6rem;
  }

  .home-services-visual-caption small {
    font-size: 0.52rem;
  }
}


/* ---------------- REDUCED MOTION ---------------- */

@media (prefers-reduced-motion: reduce) {
  .home-service-item,
  .home-service-item::before,
  .home-service-arrow,
  .home-service-image,
  .home-services-cta::before,
  .home-services-cta-arrow {
    transition: none !important;
  }

  .home-services-description p,
  .home-services-visual-index span:first-child,
  .home-services-visual-caption > span {
    animation: none !important;
  }

  .home-service-image,
  .home-service-image--active,
  .home-services-image-frame:hover .home-service-image--active {
    transform: none;
  }
}


/* =========================================================
   SMOOTH CINEMATIC IMAGE SWITCHING
   Featured Projects + Home Services
   ========================================================= */

/* ---------- Featured Projects ---------- */

.featured-projects .project-visual-image {
  transition:
    opacity 1.15s cubic-bezier(0.22, 1, 0.36, 1),
    transform 1.45s cubic-bezier(0.22, 1, 0.36, 1),
    filter 1.15s ease !important;

  will-change: opacity, transform;
}

.featured-projects .project-visual-image:not(.project-visual-image--active) {
  opacity: 0;
  transform: scale(1.055);
}

.featured-projects .project-visual-image--active {
  opacity: 1;
  transform: scale(1);
}


/* ---------- Interior Services ---------- */

.home-services .home-service-image {
  transition:
    opacity 1.2s cubic-bezier(0.22, 1, 0.36, 1),
    transform 1.5s cubic-bezier(0.22, 1, 0.36, 1),
    filter 1.2s ease !important;

  will-change: opacity, transform, filter;
}

.home-services .home-service-image:not(.home-service-image--active) {
  opacity: 0;
  transform: scale(1.06);
}

.home-services .home-service-image--active {
  opacity: 1;
  transform: scale(1.01);
}


/* Keep reduced-motion accessibility intact */

@media (prefers-reduced-motion: reduce) {
  .featured-projects .project-visual-image,
  .home-services .home-service-image {
    transition: none !important;
    transform: none !important;
  }
}


/* =========================================================
   TRUE SLOW IMAGE CROSSFADE
   Previous image stays visible while next image fades in
   ========================================================= */

/* ---------- Featured Projects ---------- */

.featured-projects .project-visual-image {
  visibility: visible !important;

  opacity: 0 !important;
  transform: scale(1.045) !important;

  transition:
    opacity 1.8s cubic-bezier(0.4, 0, 0.2, 1),
    transform 2.4s cubic-bezier(0.16, 1, 0.3, 1),
    filter 1.8s ease !important;

  will-change: opacity, transform;
}

.featured-projects .project-visual-image--active {
  visibility: visible !important;
  opacity: 1 !important;
  transform: scale(1) !important;
}


/* ---------- Home Services ---------- */

.home-services .home-service-image {
  visibility: visible !important;

  opacity: 0 !important;
  transform: scale(1.045) !important;

  transition:
    opacity 1.8s cubic-bezier(0.4, 0, 0.2, 1),
    transform 2.4s cubic-bezier(0.16, 1, 0.3, 1),
    filter 1.8s ease !important;

  will-change: opacity, transform;
}

.home-services .home-service-image--active {
  visibility: visible !important;
  opacity: 1 !important;
  transform: scale(1) !important;
}


/* Don't let hover zoom override the crossfade */

.home-services .home-services-image-frame:hover .home-service-image--active {
  transform: scale(1) !important;
}


/* Accessibility */

@media (prefers-reduced-motion: reduce) {
  .featured-projects .project-visual-image,
  .home-services .home-service-image {
    transition: none !important;
    transform: none !important;
  }
}


/* =========================================================
   FINAL SLOW CINEMATIC CROSSFADE
   ========================================================= */

.featured-projects .project-visual-image,
.home-services .home-service-image {
  visibility: visible !important;

  transition:
    opacity 2.6s cubic-bezier(0.37, 0, 0.23, 1),
    transform 3.2s cubic-bezier(0.16, 1, 0.3, 1),
    filter 2.6s ease !important;
}

.featured-projects .project-visual-image:not(.project-visual-image--active),
.home-services .home-service-image:not(.home-service-image--active) {
  opacity: 0 !important;
  transform: scale(1.035) !important;
}

.featured-projects .project-visual-image--active,
.home-services .home-service-image--active {
  opacity: 1 !important;
  transform: scale(1) !important;
}

@media (prefers-reduced-motion: reduce) {
  .featured-projects .project-visual-image,
  .home-services .home-service-image {
    transition: none !important;
    transform: none !important;
  }
}

