/* =========================================================
   ABOUT PAGE
   VASUPRIY INTERIOVILLA
   Theme:
   Midnight Teal  #004758
   Bronze Gold    #B48F4E
========================================================= */

.about-page {
  width: 100%;
  overflow: hidden;
  background: #f7f7f5;
}


/* =========================================================
   WHO WE ARE
========================================================= */

.about-who {
  --about-teal: #004758;
  --about-gold: #b48f4e;
  --about-ink: #171918;
  --about-muted: #676967;
  --about-line: rgba(0, 71, 88, 0.13);

  position: relative;
  padding: 56px 0 86px;
  background: #f7f7f5;
}

.about-who-container {
  width: min(94%, 1440px);
  margin: 0 auto;
}


/* ---------- TOP AREA ---------- */

.about-who-intro {
  display: grid;
  grid-template-columns: minmax(210px, 0.7fr) minmax(0, 2fr);
  gap: clamp(45px, 7vw, 115px);
  margin-bottom: 58px;
}

.about-who-label-column {
  position: relative;
  min-height: 150px;
}

.about-who-label {
  display: inline-flex;
  align-items: center;
  gap: 8px;

  min-height: 29px;
  padding: 0 15px;

  border: 1px solid rgba(0, 71, 88, 0.18);
  border-radius: 999px;

  color: var(--about-teal);

  font-size: 10px;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 0.055em;
  text-transform: uppercase;
}

.about-who-label i {
  display: block;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--about-gold);
}

.about-who-label-dot {
  position: absolute;
  top: 11px;
  right: 36px;

  width: 9px;
  height: 9px;

  border-radius: 50%;
  background: var(--about-gold);
}

.about-who-label-line {
  position: absolute;
  top: 0;
  right: 0;

  width: 1px;
  height: 126px;

  background:
    linear-gradient(
      to bottom,
      transparent,
      rgba(0, 71, 88, 0.13) 16%,
      rgba(0, 71, 88, 0.13) 82%,
      transparent
    );
}

.about-who-heading {
  max-width: 960px;
}

.about-who-heading h1 {
  margin: 0;

  color: var(--about-ink);

  font-family: Arial, Helvetica, sans-serif;
  font-size: clamp(42px, 4.6vw, 76px);
  font-weight: 700;
  line-height: 0.99;
  letter-spacing: -0.055em;
}

.about-who-heading h1 span {
  color: var(--about-gold);
}

.about-who-heading p {
  max-width: 820px;
  margin: 27px 0 0;

  color: var(--about-muted);

  font-size: 15px;
  line-height: 1.8;
}


/* =========================================================
   IMAGE + SERVICES
========================================================= */

.about-who-content {
  display: grid;
  grid-template-columns: minmax(0, 1.06fr) minmax(0, 0.94fr);
  gap: clamp(50px, 5vw, 82px);
  align-items: stretch;
}


/* ---------- IMAGE ---------- */

.about-who-visual {
  position: relative;

  min-height: 525px;

  overflow: hidden;
  border-radius: 0 26px 26px 26px;

  background: #ddd;
}

.about-who-visual > img {
  display: block;

  width: 100%;
  height: 100%;
  min-height: 525px;

  object-fit: cover;

  transition:
    transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
}

.about-who-visual:hover > img {
  transform: scale(1.025);
}


/* ---------- IMAGE GLASS CARD ---------- */

.about-who-image-caption {
  position: absolute;
  left: 24px;
  bottom: 22px;

  width: min(66%, 390px);
  min-height: 128px;

  display: flex;
  align-items: center;

  padding: 25px 29px;

  border: 1px solid rgba(255, 255, 255, 0.17);
  border-radius: 22px;

  background: rgba(0, 42, 51, 0.68);
  backdrop-filter: blur(13px);
  -webkit-backdrop-filter: blur(13px);

  box-shadow:
    0 15px 40px rgba(0, 0, 0, 0.14);
}

.about-who-image-caption p {
  margin: 0;

  color: rgba(255, 255, 255, 0.94);

  font-size: 13px;
  font-weight: 500;
  line-height: 1.75;
}


/* =========================================================
   SERVICES LIST
========================================================= */

.about-who-services {
  border-top: 1px solid var(--about-line);
}

.about-who-service {
  appearance: none;

  width: 100%;
  min-height: 93px;

  display: grid;
  grid-template-columns: 34px minmax(0, 1fr) 48px;
  gap: 10px;
  align-items: center;

  padding: 0;

  border: 0;
  border-bottom: 1px solid var(--about-line);

  background: transparent;

  color: var(--about-ink);

  text-align: left;
  cursor: pointer;
}

.about-who-service-number {
  color: #626765;

  font-size: 11px;
  font-weight: 800;

  transition: color 300ms ease;
}

.about-who-service strong {
  font-family: Arial, Helvetica, sans-serif;
  font-size: clamp(20px, 1.8vw, 30px);
  font-weight: 700;
  line-height: 1.12;
  letter-spacing: -0.035em;

  transition:
    color 300ms ease,
    transform 350ms cubic-bezier(0.22, 1, 0.36, 1);
}

.about-who-service-arrow {
  justify-self: end;

  display: grid;
  place-items: center;

  width: 42px;
  height: 42px;

  border: 1px solid rgba(180, 143, 78, 0.28);
  border-radius: 50%;

  background: var(--about-gold);
  color: #fff;

  font-size: 21px;

  transition:
    transform 350ms cubic-bezier(0.22, 1, 0.36, 1),
    background 300ms ease,
    color 300ms ease;
}

.about-who-service:hover strong,
.about-who-service--active strong {
  color: var(--about-gold);
}

.about-who-service:hover .about-who-service-number,
.about-who-service--active .about-who-service-number {
  color: var(--about-gold);
}

.about-who-service:hover .about-who-service-arrow,
.about-who-service--active .about-who-service-arrow {
  transform: translateX(3px);
  background: var(--about-teal);
  color: #fff;
}

.about-who-mobile-link {
  display: none;
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1024px) {
  .about-who {
    padding: 50px 0 72px;
  }

  .about-who-intro {
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 40px;
  }

  .about-who-content {
    gap: 36px;
  }

  .about-who-visual,
  .about-who-visual > img {
    min-height: 475px;
  }

  .about-who-service {
    min-height: 82px;
  }

  .about-who-service strong {
    font-size: 21px;
  }
}


/* =========================================================
   MOBILE / SMALL TABLET
========================================================= */

@media (max-width: 800px) {
  .about-who {
    padding: 40px 0 65px;
  }

  .about-who-container {
    width: min(91%, 680px);
  }

  .about-who-intro {
    display: block;
    margin-bottom: 38px;
  }

  .about-who-label-column {
    min-height: auto;
    margin-bottom: 27px;
  }

  .about-who-label-dot,
  .about-who-label-line {
    display: none;
  }

  .about-who-heading h1 {
    font-size: clamp(40px, 9.5vw, 64px);
  }

  .about-who-heading p {
    margin-top: 22px;
    font-size: 14px;
  }

  .about-who-content {
    grid-template-columns: 1fr;
    gap: 38px;
  }

  .about-who-visual,
  .about-who-visual > img {
    min-height: 520px;
  }

  .about-who-services {
    width: 100%;
  }

  .about-who-service {
    min-height: 82px;
    grid-template-columns: 31px minmax(0, 1fr) 43px;
  }

  .about-who-service strong {
    font-size: clamp(19px, 4.5vw, 25px);
  }

  .about-who-service-arrow {
    width: 39px;
    height: 39px;
  }
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 520px) {
  .about-who {
    padding-top: 32px;
  }

  .about-who-heading h1 {
    font-size: clamp(37px, 11.5vw, 52px);
    line-height: 1.01;
  }

  .about-who-heading p {
    line-height: 1.7;
  }

  .about-who-visual,
  .about-who-visual > img {
    min-height: 430px;
  }

  .about-who-visual {
    border-radius: 0 20px 20px 20px;
  }

  .about-who-image-caption {
    left: 14px;
    right: 14px;
    bottom: 14px;

    width: auto;
    min-height: auto;

    padding: 19px 20px;

    border-radius: 17px;
  }

  .about-who-image-caption p {
    font-size: 12px;
    line-height: 1.65;
  }

  .about-who-service {
    min-height: 75px;
  }

  .about-who-service-number {
    font-size: 10px;
  }

  .about-who-service strong {
    font-size: 18px;
  }

  .about-who-service-arrow {
    width: 36px;
    height: 36px;
    font-size: 18px;
  }

  .about-who-mobile-link {
    display: flex;
    margin-top: 35px;
  }

  .about-who-mobile-link a {
    display: inline-flex;
    align-items: center;
    gap: 13px;

    color: var(--about-teal);

    text-decoration: none;
    text-transform: uppercase;

    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .about-who-mobile-link a span {
    color: var(--about-gold);
    font-size: 17px;
  }
}

/* =========================================================
   WHO WE ARE — HEADER CLEARANCE + DYNAMIC IMAGE FIX
========================================================= */

/* Floating/sticky navbar ke liye proper clearance */
.about-page {
  position: relative;
}

.about-who {
  padding-top: 155px;
}


/* =========================================================
   DYNAMIC SERVICE IMAGES
========================================================= */

.about-who-visual {
  position: relative;
  min-height: 525px;
  overflow: hidden;
}

.about-who-image-stack {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.about-who-image {
  position: absolute;
  inset: 0;

  display: block;
  width: 100%;
  height: 100%;

  object-fit: cover;

  opacity: 0;
  visibility: hidden;

  transform: scale(1.045);

  transition:
    opacity 650ms ease,
    visibility 650ms ease,
    transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
}

.about-who-image--active {
  opacity: 1;
  visibility: visible;
  transform: scale(1);
}


/* Existing old direct-image rule ko neutralize */
.about-who-visual > img {
  display: none !important;
}


/* Caption image ke upar */
.about-who-image-caption {
  z-index: 3;
}


/* Hover par active image ko subtle zoom */
.about-who-visual:hover .about-who-image--active {
  transform: scale(1.025);
}


/* =========================================================
   RESPONSIVE HEADER CLEARANCE
========================================================= */

@media (max-width: 1024px) {
  .about-who {
    padding-top: 145px;
  }
}

@media (max-width: 800px) {
  .about-who {
    padding-top: 125px;
  }
}

@media (max-width: 520px) {
  .about-who {
    padding-top: 110px;
  }
}


/* =========================================================
   HOW WE WORK
========================================================= */

.about-process {
  --process-teal: #004758;
  --process-gold: #b48f4e;
  --process-ink: #171918;
  --process-muted: #676967;
  --process-line: rgba(0, 71, 88, 0.13);

  position: relative;
  padding: 105px 0 110px;
  background: #f7f7f5;
}

.about-process-container {
  width: min(90%, 1220px);
  margin: 0 auto;
}


/* ---------- HEADING ---------- */

.about-process-intro {
  display: grid;
  grid-template-columns: minmax(220px, 0.75fr) minmax(0, 1.65fr);
  gap: clamp(55px, 8vw, 125px);
  margin-bottom: 66px;
}

.about-process-label-column {
  position: relative;
  min-height: 135px;
}

.about-process-top-line {
  position: absolute;
  top: -28px;
  left: 0;
  right: 0;

  height: 1px;
  background: var(--process-line);
}

.about-process-label {
  display: inline-flex;
  align-items: center;
  gap: 7px;

  min-height: 27px;
  padding: 0 14px;

  border: 1px solid rgba(0, 71, 88, 0.17);
  border-radius: 999px;

  color: var(--process-teal);

  font-size: 9px;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.about-process-label i {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--process-gold);
}

.about-process-vertical-line {
  position: absolute;
  top: -28px;
  right: 0;

  width: 1px;
  height: 145px;

  background:
    linear-gradient(
      to bottom,
      rgba(0, 71, 88, 0.12),
      rgba(0, 71, 88, 0.12) 75%,
      transparent
    );
}

.about-process-heading h2 {
  margin: 0;

  color: var(--process-ink);

  font-family: Arial, Helvetica, sans-serif;
  font-size: clamp(40px, 4.2vw, 65px);
  font-weight: 700;
  line-height: 1.02;
  letter-spacing: -0.055em;
}

.about-process-heading h2 span {
  color: var(--process-gold);
}

.about-process-heading h2 strong {
  color: var(--process-teal);
  font-weight: 700;
}

.about-process-heading > p {
  max-width: 750px;
  margin: 25px 0 0;

  color: var(--process-muted);

  font-size: 14px;
  line-height: 1.75;
}


/* =========================================================
   CONTENT
========================================================= */

.about-process-content {
  display: grid;
  grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
  gap: clamp(50px, 6vw, 88px);
  align-items: center;
}


/* ---------- IMAGE ---------- */

.about-process-visual {
  position: relative;
  height: 430px;

  overflow: hidden;
  border-radius: 22px;

  background: #ddd;
}

.about-process-visual img {
  display: block;
  width: 100%;
  height: 100%;

  object-fit: cover;

  transition:
    transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
}

.about-process-visual:hover img {
  transform: scale(1.035);
}


/* =========================================================
   PROCESS STEPS
========================================================= */

.about-process-steps {
  border-top: 1px solid var(--process-line);
}

.about-process-step {
  display: grid;
  grid-template-columns: 66px minmax(0, 1fr);
  gap: 16px;
  align-items: center;

  min-height: 113px;
  padding: 16px 0;

  border-bottom: 1px solid var(--process-line);
}

.about-process-number {
  display: grid;
  place-items: center;

  width: 54px;
  height: 54px;

  border-radius: 50%;

  background: #fff;
  color: var(--process-teal);

  font-size: 13px;
  font-weight: 700;

  transition:
    background 300ms ease,
    color 300ms ease,
    transform 350ms cubic-bezier(0.22, 1, 0.36, 1);
}

.about-process-step h3 {
  margin: 0 0 8px;

  color: var(--process-ink);

  font-family: Arial, Helvetica, sans-serif;
  font-size: clamp(21px, 2vw, 28px);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.035em;

  transition: color 300ms ease;
}

.about-process-step p {
  max-width: 440px;
  margin: 0;

  color: var(--process-muted);

  font-size: 12px;
  line-height: 1.65;
}

.about-process-step:hover .about-process-number {
  background: var(--process-gold);
  color: #fff;
  transform: scale(1.05);
}

.about-process-step:hover h3 {
  color: var(--process-gold);
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 900px) {
  .about-process {
    padding: 85px 0 90px;
  }

  .about-process-container {
    width: min(91%, 760px);
  }

  .about-process-intro {
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 40px;
    margin-bottom: 50px;
  }

  .about-process-content {
    grid-template-columns: 1fr;
    gap: 45px;
  }

  .about-process-visual {
    height: 500px;
  }
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 650px) {
  .about-process {
    padding: 72px 0 75px;
  }

  .about-process-intro {
    display: block;
    margin-bottom: 40px;
  }

  .about-process-label-column {
    min-height: auto;
    margin-bottom: 26px;
  }

  .about-process-top-line,
  .about-process-vertical-line {
    display: none;
  }

  .about-process-heading h2 {
    font-size: clamp(38px, 10vw, 52px);
  }

  .about-process-heading > p {
    font-size: 13px;
  }

  .about-process-visual {
    height: 390px;
    border-radius: 17px;
  }

  .about-process-step {
    grid-template-columns: 54px minmax(0, 1fr);
    gap: 13px;
    min-height: 108px;
  }

  .about-process-number {
    width: 46px;
    height: 46px;
    font-size: 11px;
  }

  .about-process-step h3 {
    font-size: 21px;
  }

  .about-process-step p {
    font-size: 11px;
  }
}


/* =========================================================
   HOW WE WORK — DYNAMIC 4 IMAGE SWITCHER
========================================================= */

.about-process-visual {
  position: relative;
  overflow: hidden;
}

.about-process-image-stack {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.about-process-image {
  position: absolute;
  inset: 0;

  display: block;
  width: 100%;
  height: 100%;

  object-fit: cover;

  opacity: 0;
  visibility: hidden;

  transform: scale(1.055);

  transition:
    opacity 650ms ease,
    visibility 650ms ease,
    transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
}

.about-process-image--active {
  opacity: 1;
  visibility: visible;
  transform: scale(1);
}


/* Disable old direct-image behavior */
.about-process-visual > img {
  display: none !important;
}


/* Process row can receive keyboard focus */
.about-process-step {
  cursor: pointer;
  outline: none;
}


/* Active step styling */
.about-process-step--active .about-process-number {
  background: var(--process-gold);
  color: #fff;
  transform: scale(1.05);
}

.about-process-step--active h3 {
  color: var(--process-gold);
}


/* Active image subtle interaction */
.about-process-visual:hover .about-process-image--active {
  transform: scale(1.025);
}


/* =========================================================
   WHAT WE DO
   Midnight Teal #004758 / Bronze Gold #B48F4E
========================================================= */

.about-what {
  --what-teal: #004758;
  --what-gold: #b48f4e;
  --what-ink: #171918;
  --what-muted: #666865;
  --what-line: rgba(0, 71, 88, 0.14);

  position: relative;
  padding: 88px 0 0;
  overflow: hidden;
  background: #f8f6f2;
}

.about-what-container {
  width: min(92%, 1360px);
  margin: 0 auto;
}


/* ---------- HEADING ---------- */

.about-what-heading {
  margin-bottom: 70px;
  text-align: center;
}

.about-what-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 7px;

  margin-bottom: 18px;

  color: var(--what-teal);

  font-size: 11px;
  font-weight: 700;
}

.about-what-eyebrow i {
  color: var(--what-gold);
  font-style: normal;
}

.about-what-heading h2 {
  margin: 0;

  color: var(--what-teal);

  font-family: Arial, Helvetica, sans-serif;
  font-size: clamp(39px, 4vw, 62px);
  font-weight: 500;
  line-height: 1.03;
  letter-spacing: -0.045em;
  text-transform: uppercase;
}


/* ---------- THREE COLUMN LAYOUT ---------- */

.about-what-layout {
  display: grid;

  grid-template-columns:
    minmax(240px, 1fr)
    minmax(420px, 1.35fr)
    minmax(240px, 1fr);

  gap: clamp(38px, 4vw, 68px);
  align-items: center;
}


/* ---------- SERVICE COLUMNS ---------- */

.about-what-column {
  display: flex;
  flex-direction: column;
  justify-content: space-between;

  gap: 82px;
  padding-bottom: 52px;
}

.about-what-service {
  position: relative;
}

.about-what-icon {
  display: block;

  margin-bottom: 20px;

  color: var(--what-gold);

  font-size: 29px;
  line-height: 1;

  transition:
    transform 350ms ease,
    color 300ms ease;
}

.about-what-service h3 {
  margin: 0 0 11px;

  color: var(--what-teal);

  font-family: Arial, Helvetica, sans-serif;
  font-size: 16px;
  font-weight: 700;
  line-height: 1.3;

  transition: color 300ms ease;
}

.about-what-service > p {
  max-width: 310px;
  margin: 0;

  color: var(--what-muted);

  font-size: 12px;
  line-height: 1.65;
}

.about-what-detail {
  display: flex;
  gap: 7px;
  align-items: flex-start;

  margin-top: 19px;
  padding-top: 15px;

  border-top: 1px solid var(--what-line);
}

.about-what-detail > span {
  display: grid;
  place-items: center;

  flex: 0 0 14px;

  width: 14px;
  height: 14px;

  margin-top: 1px;

  border-radius: 50%;

  background: var(--what-gold);
  color: #fff;

  font-size: 8px;
  font-weight: 800;
}

.about-what-detail p {
  margin: 0;

  color: var(--what-muted);

  font-size: 10px;
  line-height: 1.55;
}

.about-what-service:hover h3 {
  color: var(--what-gold);
}

.about-what-service:hover .about-what-icon {
  color: var(--what-teal);
  transform: translateY(-4px);
}


/* =========================================================
   CENTER ARCH IMAGES
========================================================= */

.about-what-visual {
  position: relative;

  min-height: 545px;

  align-self: end;
}

.about-what-arch {
  position: absolute;
  bottom: 0;

  overflow: hidden;

  background: #ddd;
}

.about-what-arch img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  transition:
    transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
}

.about-what-arch:hover img {
  transform: scale(1.035);
}


/* tall rear arch */

.about-what-arch--back {
  left: 4%;

  width: 55%;
  height: 100%;

  border-radius: 260px 260px 0 0;
}


/* shorter front arch */

.about-what-arch--front {
  right: 2%;

  width: 56%;
  height: 76%;

  border-left: 4px solid #f8f6f2;
  border-radius: 260px 260px 0 0;
}


/* ---------- ROUND SEAL ---------- */

.about-what-seal {
  position: absolute;
  z-index: 5;

  top: 24%;
  left: 55%;

  transform: translate(-50%, -50%);

  display: grid;
  place-items: center;

  width: 78px;
  height: 78px;

  border: 5px solid #f8f6f2;
  border-radius: 50%;

  background: var(--what-gold);
  color: #fff;

  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
}

.about-what-seal span {
  margin-top: -5px;

  font-family: Georgia, serif;
  font-size: 27px;
  font-weight: 700;
}

.about-what-seal small {
  position: absolute;
  bottom: 9px;

  width: 100%;

  color: #fff;

  font-size: 6px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-align: center;
  text-transform: uppercase;
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1050px) {
  .about-what-layout {
    grid-template-columns: 1fr 1.15fr;
  }

  .about-what-column--right {
    grid-column: 1 / -1;

    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 45px;

    padding-bottom: 75px;
  }

  .about-what-visual {
    min-height: 500px;
  }
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 720px) {
  .about-what {
    padding-top: 70px;
  }

  .about-what-container {
    width: min(90%, 620px);
  }

  .about-what-heading {
    margin-bottom: 45px;
  }

  .about-what-heading h2 {
    font-size: clamp(34px, 9vw, 48px);
  }

  .about-what-layout {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .about-what-visual {
    order: -1;

    width: 100%;
    min-height: 470px;
  }

  .about-what-column,
  .about-what-column--right {
    display: grid;
    grid-template-columns: 1fr;

    width: 100%;

    gap: 42px;
    padding: 0;
  }

  .about-what-service > p {
    max-width: none;
  }

  .about-what-column--right {
    padding-bottom: 70px;
  }
}


@media (max-width: 480px) {
  .about-what-visual {
    min-height: 390px;
  }

  .about-what-seal {
    width: 64px;
    height: 64px;
  }

  .about-what-seal span {
    font-size: 22px;
  }

  .about-what-seal small {
    bottom: 7px;
    font-size: 5px;
  }
}


/* =========================================================
   ABOUT PAGE — ALLOW ALL SECTIONS TO FLOW VERTICALLY
========================================================= */

.about-page {
  height: auto !important;
  min-height: 100vh !important;
  max-height: none !important;
  overflow-x: hidden !important;
  overflow-y: visible !important;
}

.about-what {
  display: block !important;
  position: relative !important;
  width: 100% !important;
  height: auto !important;
  min-height: 700px !important;
  visibility: visible !important;
  opacity: 1 !important;
  clear: both !important;
  z-index: 1 !important;
}


/* WHAT WE DO — VASUPRIY BRAND LOGO BADGE */

.about-what-seal {
  padding: 8px !important;
  background: #ffffff !important;
  border: 4px solid #f8f6f2 !important;
  box-sizing: border-box !important;
}

.about-what-seal-logo {
  display: block !important;
  width: 100% !important;
  height: 100% !important;

  object-fit: contain !important;
  object-position: center !important;

  opacity: 1 !important;
  filter: none !important;
  transform: none !important;
}

.about-what-seal > span,
.about-what-seal > small {
  display: none !important;
}


/* =========================================================
   OUR APPROACH
========================================================= */

.about-approach {
  --approach-teal: #004758;
  --approach-gold: #b48f4e;
  --approach-ivory: #f8f6f2;

  position: relative;
  padding: 100px 0 42px;
  overflow: hidden;
  background: var(--approach-ivory);
}

.about-approach-container {
  width: min(94%, 1420px);
  margin: 0 auto;
}


/* HEADING */

.about-approach-heading {
  max-width: 900px;
  margin: 0 auto 82px;
  text-align: center;
}

.about-approach-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 7px;

  margin-bottom: 18px;

  color: var(--approach-teal);

  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.03em;
}

.about-approach-eyebrow i {
  color: var(--approach-gold);
  font-style: normal;
}

.about-approach-heading h2 {
  margin: 0;

  color: var(--approach-teal);

  font-family: Arial, Helvetica, sans-serif;
  font-size: clamp(42px, 4.3vw, 68px);
  font-weight: 500;
  line-height: 1.02;
  letter-spacing: -0.045em;
  text-transform: uppercase;
}

.about-approach-heading h2 span {
  color: var(--approach-gold);
}

.about-approach-heading > p {
  max-width: 620px;
  margin: 23px auto 0;

  color: #686b69;

  font-size: 13px;
  line-height: 1.7;
}


/* FOUR CARDS */

.about-approach-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));

  gap: clamp(20px, 2.2vw, 34px);
}

.about-approach-card {
  min-width: 0;
}

.about-approach-image {
  position: relative;

  height: clamp(330px, 30vw, 440px);

  overflow: hidden;

  border-radius: 22px;

  background: #ddd;
}

.about-approach-image::after {
  content: '';

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      to top,
      rgba(0, 32, 40, 0.84) 0%,
      rgba(0, 32, 40, 0.24) 45%,
      rgba(0, 32, 40, 0.02) 70%
    );

  transition: background 500ms ease;
}

.about-approach-image img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  transition:
    transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
}

.about-approach-card:hover .about-approach-image img {
  transform: scale(1.055);
}


/* NUMBER */

.about-approach-index {
  position: absolute;
  z-index: 3;

  top: 22px;
  left: 22px;

  display: grid;
  place-items: center;

  width: 39px;
  height: 39px;

  border: 1px solid rgba(255, 255, 255, 0.55);
  border-radius: 50%;

  background: rgba(0, 71, 88, 0.58);
  backdrop-filter: blur(7px);

  color: #fff;

  font-size: 10px;
  font-weight: 700;
}


/* CARD TEXT */

.about-approach-overlay {
  position: absolute;
  z-index: 3;

  right: 21px;
  bottom: 23px;
  left: 21px;
}

.about-approach-overlay h3 {
  margin: 0;

  color: #fff;

  font-family: Arial, Helvetica, sans-serif;
  font-size: clamp(19px, 1.65vw, 25px);
  font-weight: 600;
  line-height: 1.15;
  letter-spacing: -0.025em;
}

.about-approach-overlay p {
  max-height: 0;
  margin: 0;

  overflow: hidden;

  color: rgba(255, 255, 255, 0.82);

  font-size: 11px;
  line-height: 1.55;

  opacity: 0;
  transform: translateY(8px);

  transition:
    max-height 500ms ease,
    margin 500ms ease,
    opacity 400ms ease,
    transform 500ms ease;
}

.about-approach-card:hover .about-approach-overlay p {
  max-height: 90px;
  margin-top: 10px;

  opacity: 1;
  transform: translateY(0);
}


/* META UNDER CARD */

.about-approach-meta {
  display: flex;
  align-items: center;
  gap: 9px;

  padding: 14px 3px 0;

  color: #626664;

  font-size: 10px;
  font-weight: 600;
}

.about-approach-meta span {
  width: 6px;
  height: 6px;

  flex: 0 0 6px;

  border-radius: 50%;

  background: var(--approach-gold);
}


/* BOTTOM STRIP */

.about-approach-statement {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 13px;

  margin-top: 60px;
  padding-top: 20px;

  border-top: 1px solid rgba(0, 71, 88, 0.12);
}

.about-approach-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-width: 70px;
  min-height: 25px;

  padding: 5px 13px;

  border-radius: 999px;

  background: var(--approach-gold);
  color: #fff;

  font-size: 10px;
  font-weight: 700;
}

.about-approach-statement p {
  margin: 0;

  color: var(--approach-teal);

  font-size: 14px;
}

.about-approach-statement strong {
  color: var(--approach-gold);
  font-weight: 600;
}


/* TABLET */

@media (max-width: 1050px) {
  .about-approach-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .about-approach-image {
    height: 430px;
  }
}


/* MOBILE */

@media (max-width: 640px) {
  .about-approach {
    padding-top: 72px;
  }

  .about-approach-container {
    width: min(90%, 560px);
  }

  .about-approach-heading {
    margin-bottom: 48px;
  }

  .about-approach-heading h2 {
    font-size: clamp(34px, 10vw, 48px);
  }

  .about-approach-grid {
    grid-template-columns: 1fr;
    gap: 34px;
  }

  .about-approach-image {
    height: 430px;
  }

  .about-approach-overlay p {
    max-height: 100px;
    margin-top: 10px;

    opacity: 1;
    transform: none;
  }

  .about-approach-statement {
    flex-direction: column;
    gap: 10px;

    margin-top: 45px;

    text-align: center;
  }

  .about-approach-statement p {
    font-size: 12px;
    line-height: 1.6;
  }
}


/* =========================================================
   OUR PARTNERS
========================================================= */

.about-partners {
  --partners-teal: #004758;
  --partners-gold: #b48f4e;
  --partners-ivory: #f8f6f2;

  position: relative;

  padding: 105px 0 70px;

  overflow: hidden;

  background: var(--partners-ivory);
}

.about-partners-container {
  width: min(90%, 1220px);
  margin: 0 auto;
}


/* =========================================================
   HEADING
========================================================= */

.about-partners-heading {
  max-width: 860px;
  margin: 0 auto 65px;

  text-align: center;
}

.about-partners-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 7px;

  margin-bottom: 18px;

  color: var(--partners-teal);

  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.03em;
}

.about-partners-eyebrow i {
  color: var(--partners-gold);
  font-style: normal;
}

.about-partners-heading h2 {
  margin: 0;

  color: var(--partners-teal);

  font-family: Arial, Helvetica, sans-serif;

  font-size: clamp(42px, 4.2vw, 66px);
  font-weight: 500;

  line-height: 1.02;

  letter-spacing: -0.045em;

  text-transform: uppercase;
}

.about-partners-heading h2 span {
  color: var(--partners-gold);
}

.about-partners-heading p {
  max-width: 640px;

  margin: 24px auto 0;

  color: #676a68;

  font-size: 13px;
  line-height: 1.75;
}


/* =========================================================
   MARQUEE
========================================================= */

.about-partners-marquee {
  position: relative;

  width: 100%;

  overflow: hidden;

  padding: 18px 0 25px;
}


/* subtle fade at left/right */

.about-partners-marquee::before,
.about-partners-marquee::after {
  content: '';

  position: absolute;
  z-index: 5;

  top: 0;
  bottom: 0;

  width: clamp(45px, 8vw, 145px);

  pointer-events: none;
}

.about-partners-marquee::before {
  left: 0;

  background:
    linear-gradient(
      to right,
      var(--partners-ivory),
      rgba(248, 246, 242, 0)
    );
}

.about-partners-marquee::after {
  right: 0;

  background:
    linear-gradient(
      to left,
      var(--partners-ivory),
      rgba(248, 246, 242, 0)
    );
}


/* moving track */

.about-partners-track {
  display: flex;

  width: max-content;

  will-change: transform;

  animation:
    vasupriyPartnersMarquee 32s linear infinite;
}

.about-partners-marquee:hover .about-partners-track {
  animation-play-state: paused;
}

.about-partners-group {
  display: flex;
  align-items: center;

  flex-shrink: 0;

  gap: 22px;

  padding-right: 22px;
}


/* =========================================================
   LOGO CARD
========================================================= */

.about-partner-card {
  display: flex;
  align-items: center;
  justify-content: center;

  flex: 0 0 205px;

  width: 205px;
  height: 112px;

  padding: 23px 28px;

  box-sizing: border-box;

  border: 1px solid rgba(0, 71, 88, 0.10);

  border-radius: 18px;

  background: rgba(255, 255, 255, 0.74);

  transition:
    transform 350ms cubic-bezier(0.22, 1, 0.36, 1),
    border-color 300ms ease,
    background 300ms ease,
    box-shadow 350ms ease;
}

.about-partner-card img {
  display: block;

  width: 100%;
  max-width: 145px;

  height: 58px;

  object-fit: contain;

  opacity: 0.72;

  filter: grayscale(1);

  transition:
    filter 350ms ease,
    opacity 350ms ease,
    transform 350ms ease;
}


/* logo hover */

.about-partner-card:hover {
  transform: translateY(-6px);

  border-color: rgba(180, 143, 78, 0.38);

  background: #fff;

  box-shadow:
    0 16px 40px rgba(0, 71, 88, 0.08);
}

.about-partner-card:hover img {
  opacity: 1;

  filter: grayscale(0);

  transform: scale(1.04);
}


/* =========================================================
   MARQUEE ANIMATION
========================================================= */

@keyframes vasupriyPartnersMarquee {
  from {
    transform: translate3d(0, 0, 0);
  }

  to {
    transform: translate3d(-50%, 0, 0);
  }
}


/* =========================================================
   BOTTOM DETAILS
========================================================= */

.about-partners-bottom {
  display: flex;
  align-items: center;
  justify-content: center;

  flex-wrap: wrap;

  gap: 13px;

  margin-top: 42px;
  padding-top: 22px;

  border-top: 1px solid rgba(0, 71, 88, 0.11);

  color: var(--partners-teal);

  font-size: 10px;
  font-weight: 700;

  letter-spacing: 0.09em;

  text-transform: uppercase;
}

.about-partners-bottom i {
  display: block;

  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: var(--partners-gold);
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 900px) {

  .about-partners {
    padding: 85px 0 60px;
  }

  .about-partner-card {
    flex-basis: 180px;

    width: 180px;
    height: 102px;

    padding: 20px 24px;
  }

  .about-partner-card img {
    max-width: 130px;
    height: 52px;
  }

  .about-partners-track {
    animation-duration: 28s;
  }
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

  .about-partners {
    padding: 70px 0 50px;
  }

  .about-partners-container {
    width: min(90%, 560px);
  }

  .about-partners-heading {
    margin-bottom: 42px;
  }

  .about-partners-heading h2 {
    font-size: clamp(34px, 10vw, 48px);
  }

  .about-partners-heading p {
    font-size: 12px;
  }

  .about-partners-group {
    gap: 14px;

    padding-right: 14px;
  }

  .about-partner-card {
    flex-basis: 155px;

    width: 155px;
    height: 90px;

    padding: 18px 20px;

    border-radius: 14px;
  }

  .about-partner-card img {
    max-width: 115px;
    height: 46px;
  }

  .about-partners-track {
    animation-duration: 24s;
  }

  .about-partners-bottom {
    gap: 9px 11px;

    margin-top: 30px;

    font-size: 8px;
  }
}


/* Respect reduced motion */

@media (prefers-reduced-motion: reduce) {
  .about-partners-track {
    animation-play-state: paused;
  }
}


/* =========================================================
   OUR SPECIALITIES
========================================================= */

.about-specialities {
  --speciality-teal: #004758;
  --speciality-gold: #b48f4e;
  --speciality-cream: #f4f0e9;

  position: relative;
  padding: 105px 0 78px;
  overflow: hidden;

  background: var(--speciality-cream);
}

.about-specialities-container {
  width: min(92%, 1380px);
  margin: 0 auto;
}


/* =========================================================
   HEADING
========================================================= */

.about-specialities-heading {
  max-width: 900px;
  margin: 0 auto 75px;

  text-align: center;
}

.about-specialities-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;

  margin-bottom: 18px;

  color: var(--speciality-teal);

  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.about-specialities-eyebrow i {
  color: var(--speciality-gold);
  font-style: normal;
}

.about-specialities-heading h2 {
  margin: 0;

  color: var(--speciality-teal);

  font-family: Arial, Helvetica, sans-serif;
  font-size: clamp(42px, 4.3vw, 68px);
  font-weight: 500;
  line-height: 1.02;

  letter-spacing: -0.045em;
  text-transform: uppercase;
}

.about-specialities-heading h2 span {
  color: var(--speciality-gold);
}

.about-specialities-heading p {
  max-width: 650px;
  margin: 23px auto 0;

  color: #666a68;

  font-size: 13px;
  line-height: 1.75;
}


/* =========================================================
   CARDS
========================================================= */

.about-specialities-grid {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(0, 1.08fr)
    minmax(0, 1fr);

  gap: clamp(20px, 2.4vw, 36px);

  align-items: center;
}

.about-speciality-card {
  position: relative;
}

.about-speciality-card--featured {
  transform: translateY(-18px);
}


/* IMAGE */

.about-speciality-image {
  position: relative;

  height: 520px;

  overflow: hidden;

  border-radius: 190px 190px 24px 24px;

  background: #d9d7d2;

  box-shadow:
    0 20px 55px rgba(0, 71, 88, 0.08);
}

.about-speciality-card--featured .about-speciality-image {
  height: 575px;

  border-radius: 220px 220px 24px 24px;
}

.about-speciality-image::after {
  content: '';

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      to top,
      rgba(0, 38, 47, 0.90) 0%,
      rgba(0, 38, 47, 0.50) 30%,
      rgba(0, 38, 47, 0.06) 68%
    );

  transition: background 500ms ease;
}

.about-speciality-image img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  transition:
    transform 1s cubic-bezier(0.22, 1, 0.36, 1);
}

.about-speciality-card:hover img {
  transform: scale(1.065);
}


/* =========================================================
   NUMBER
========================================================= */

.about-speciality-number {
  position: absolute;
  z-index: 4;

  top: 25px;
  left: 27px;

  display: grid;
  place-items: center;

  width: 43px;
  height: 43px;

  border: 1px solid rgba(255,255,255,.55);
  border-radius: 50%;

  background: rgba(0,71,88,.55);

  backdrop-filter: blur(8px);

  color: #fff;

  font-size: 10px;
  font-weight: 700;
}


/* =========================================================
   FEATURED BADGE
========================================================= */

.about-speciality-featured-label {
  position: absolute;
  z-index: 5;

  top: 28px;
  right: 28px;

  padding: 8px 15px;

  border-radius: 999px;

  background: var(--speciality-gold);
  color: #fff;

  font-size: 9px;
  font-weight: 700;

  letter-spacing: .08em;
  text-transform: uppercase;
}


/* =========================================================
   CARD CONTENT
========================================================= */

.about-speciality-overlay {
  position: absolute;
  z-index: 4;

  right: 30px;
  bottom: 32px;
  left: 30px;
}

.about-speciality-overlay > span {
  display: block;

  margin-bottom: 10px;

  color: #e5c98f;

  font-size: 9px;
  font-weight: 700;

  letter-spacing: .12em;
  text-transform: uppercase;
}

.about-speciality-overlay h3 {
  margin: 0;

  color: #fff;

  font-family: Arial, Helvetica, sans-serif;

  font-size: clamp(25px, 2vw, 34px);
  font-weight: 500;

  line-height: 1.03;

  letter-spacing: -.035em;
}

.about-speciality-overlay p {
  max-width: 330px;

  margin: 15px 0 0;

  color: rgba(255,255,255,.78);

  font-size: 11px;
  line-height: 1.65;
}


/* GOLD LINE */

.about-speciality-overlay::before {
  content: '';

  display: block;

  width: 36px;
  height: 2px;

  margin-bottom: 17px;

  background: var(--speciality-gold);

  transition: width 450ms ease;
}

.about-speciality-card:hover
.about-speciality-overlay::before {
  width: 72px;
}


/* =========================================================
   FOOTER STRIP
========================================================= */

.about-specialities-footer {
  display: flex;
  align-items: center;
  justify-content: center;

  flex-wrap: wrap;

  gap: 14px;

  margin-top: 58px;
  padding-top: 24px;

  border-top: 1px solid rgba(0,71,88,.12);

  color: #626764;

  font-size: 9px;
  font-weight: 700;

  letter-spacing: .10em;

  text-transform: uppercase;
}

.about-specialities-footer i {
  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: var(--speciality-gold);
}

.about-specialities-footer strong {
  color: var(--speciality-teal);
  font-weight: 800;
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1000px) {

  .about-specialities-grid {
    grid-template-columns: repeat(2, minmax(0,1fr));
  }

  .about-speciality-card--featured {
    transform: none;
  }

  .about-speciality-card:last-child {
    grid-column: 1 / -1;

    width: min(52%, 500px);
    margin: 0 auto;
  }

  .about-speciality-image,
  .about-speciality-card--featured
  .about-speciality-image {
    height: 520px;
  }
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 650px) {

  .about-specialities {
    padding: 72px 0 55px;
  }

  .about-specialities-container {
    width: min(90%, 560px);
  }

  .about-specialities-heading {
    margin-bottom: 48px;
  }

  .about-specialities-heading h2 {
    font-size: clamp(34px, 10vw, 48px);
  }

  .about-specialities-heading p {
    font-size: 12px;
  }

  .about-specialities-grid {
    grid-template-columns: 1fr;

    gap: 28px;
  }

  .about-speciality-card:last-child {
    grid-column: auto;

    width: 100%;
  }

  .about-speciality-image,
  .about-speciality-card--featured
  .about-speciality-image {
    height: 500px;

    border-radius: 160px 160px 20px 20px;
  }

  .about-speciality-card--featured {
    transform: none;
  }

  .about-speciality-overlay {
    right: 24px;
    bottom: 26px;
    left: 24px;
  }

  .about-speciality-overlay h3 {
    font-size: 29px;
  }

  .about-specialities-footer {
    gap: 10px;

    margin-top: 42px;

    text-align: center;
  }
}


/* =========================================================
   WHO WE ARE V2
   Dark editorial layout
========================================================= */

.about-who-v2 {
  --who-teal: #004758;
  --who-gold: #b48f4e;

  position: relative;
  z-index: 1;

  width: 100%;

  padding:
    clamp(105px, 10vw, 150px)
    clamp(18px, 3vw, 48px)
    clamp(80px, 8vw, 120px);

  box-sizing: border-box;
  overflow: hidden;

  background:
    radial-gradient(
      circle at 72% 35%,
      rgba(0, 71, 88, 0.20),
      transparent 33%
    ),
    linear-gradient(
      105deg,
      #101313 0%,
      #080a0a 55%,
      #030404 100%
    );

  color: #fff;
}


/* subtle architectural lines */

.about-who-v2::before {
  content: '';

  position: absolute;
  inset: 0;

  pointer-events: none;

  opacity: 0.18;

  background:
    linear-gradient(
      90deg,
      transparent 0 9%,
      rgba(255,255,255,.035) 9% 9.1%,
      transparent 9.1% 25%,
      rgba(255,255,255,.025) 25% 25.1%,
      transparent 25.1% 100%
    );
}


.about-who-v2-shell {
  position: relative;
  z-index: 2;

  display: grid;

  grid-template-columns:
    minmax(0, 1.02fr)
    minmax(0, .98fr);

  align-items: center;

  gap: clamp(50px, 5.5vw, 90px);

  width: min(100%, 1440px);

  margin: 0 auto;
}


/* =========================================================
   LEFT IMAGE
========================================================= */

.about-who-v2-visual {
  position: relative;
}

.about-who-v2-image {
  position: relative;

  width: 100%;
  height: clamp(390px, 38vw, 570px);

  overflow: hidden;

  border-radius: 22px;

  background: #1a1c1c;
}

.about-who-v2-image img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  transform: scale(1.01);

  transition:
    transform 1.2s cubic-bezier(.22, 1, .36, 1);
}

.about-who-v2:hover .about-who-v2-image img {
  transform: scale(1.045);
}

.about-who-v2-image-shade {
  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      to top,
      rgba(0, 20, 25, .23),
      transparent 45%
    );

  pointer-events: none;
}


/* Who We Are floating label */

.about-who-v2-label {
  position: absolute;

  top: -18px;
  left: 30px;

  display: inline-flex;
  align-items: center;

  gap: 8px;

  padding: 10px 17px;

  border: 1px solid rgba(255,255,255,.14);

  border-radius: 999px;

  background: rgba(0, 71, 88, .94);

  box-shadow:
    0 12px 32px rgba(0,0,0,.24);

  color: #fff;

  font-size: 10px;
  font-weight: 700;

  letter-spacing: .08em;

  text-transform: uppercase;
}

.about-who-v2-label i {
  color: #e1bc77;
  font-style: normal;
}


/* =========================================================
   RIGHT CONTENT
========================================================= */

.about-who-v2-content {
  position: relative;

  max-width: 650px;
}

.about-who-v2-intro h1 {
  max-width: 640px;

  margin: 0;

  color: #fff;

  font-family: Arial, Helvetica, sans-serif;

  font-size: clamp(25px, 2.3vw, 36px);
  font-weight: 600;

  line-height: 1.3;

  letter-spacing: -.035em;
}

.about-who-v2-intro h1 span {
  color: #d5ae66;
}


/* =========================================================
   FEATURES
========================================================= */

.about-who-v2-features {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  column-gap: 42px;
  row-gap: 18px;

  margin-top: 34px;
}

.about-who-v2-feature {
  display: flex;
  align-items: center;

  gap: 10px;

  min-width: 0;

  color: #f4f4f1;

  font-size: 13px;
}

.about-who-v2-feature > span {
  position: relative;

  flex: 0 0 auto;

  color: var(--who-gold);

  font-size: 20px;
  font-weight: 400;

  line-height: 1;
}

.about-who-v2-feature strong {
  font-weight: 600;
  line-height: 1.35;
}


/* =========================================================
   DIVIDER
========================================================= */

.about-who-v2-divider {
  width: 100%;
  height: 1px;

  margin: 36px 0 27px;

  background:
    linear-gradient(
      90deg,
      rgba(180,143,78,.65),
      rgba(255,255,255,.12) 50%,
      transparent
    );
}


/* =========================================================
   DESCRIPTION
========================================================= */

.about-who-v2-description {
  max-width: 630px;

  margin: 0;

  color: rgba(255,255,255,.74);

  font-size: 13px;
  line-height: 1.85;
}


/* =========================================================
   BUTTON
========================================================= */

.about-who-v2-button {
  display: inline-flex;
  align-items: center;

  gap: 16px;

  margin-top: 32px;

  padding:
    7px
    7px
    7px
    21px;

  border: 1px solid rgba(255,255,255,.80);

  border-radius: 999px;

  color: #fff;

  font-size: 11px;
  font-weight: 700;

  text-decoration: none;

  transition:
    border-color 300ms ease,
    background 300ms ease,
    transform 300ms ease;
}

.about-who-v2-button i {
  display: grid;
  place-items: center;

  width: 38px;
  height: 38px;

  border-radius: 50%;

  background: var(--who-gold);

  color: #fff;

  font-size: 17px;
  font-style: normal;

  transition:
    transform 350ms cubic-bezier(.22, 1, .36, 1),
    background 300ms ease;
}

.about-who-v2-button:hover {
  border-color: var(--who-gold);

  background: rgba(180,143,78,.08);

  transform: translateY(-2px);
}

.about-who-v2-button:hover i {
  transform:
    rotate(45deg)
    scale(1.05);
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1000px) {

  .about-who-v2 {
    padding-top: 110px;
  }

  .about-who-v2-shell {
    grid-template-columns: 1fr;

    gap: 52px;
  }

  .about-who-v2-image {
    height: min(62vw, 570px);
  }

  .about-who-v2-content {
    max-width: 760px;
  }

  .about-who-v2-intro h1 {
    max-width: 720px;
  }
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 620px) {

  .about-who-v2 {
    padding:
      95px
      18px
      68px;
  }

  .about-who-v2-shell {
    gap: 42px;
  }

  .about-who-v2-image {
    height: 410px;

    border-radius: 18px;
  }

  .about-who-v2-label {
    top: -16px;
    left: 18px;
  }

  .about-who-v2-intro h1 {
    font-size: 27px;

    line-height: 1.25;
  }

  .about-who-v2-features {
    grid-template-columns: 1fr;

    gap: 16px;

    margin-top: 28px;
  }

  .about-who-v2-divider {
    margin:
      30px
      0
      24px;
  }

  .about-who-v2-description {
    font-size: 12px;

    line-height: 1.8;
  }

  .about-who-v2-button {
    margin-top: 28px;
  }
}


/* =========================================================
   WHO WE ARE V2 — VASUPRIY BRAND THEME
   Midnight Teal #004758
   Bronze Gold   #B48F4E
========================================================= */

.about-who-v2 {
  background:
    radial-gradient(
      circle at 88% 18%,
      rgba(180, 143, 78, 0.16) 0%,
      rgba(180, 143, 78, 0.05) 25%,
      transparent 48%
    ),
    radial-gradient(
      circle at 12% 85%,
      rgba(255, 255, 255, 0.07) 0%,
      transparent 38%
    ),
    linear-gradient(
      118deg,
      #003744 0%,
      #004758 48%,
      #005364 100%
    ) !important;

  color: #ffffff;
}


/* architectural background detail */

.about-who-v2::before {
  opacity: 1 !important;

  background:
    linear-gradient(
      90deg,
      transparent 0%,
      transparent 12%,
      rgba(255, 255, 255, 0.035) 12.1%,
      transparent 12.2%,
      transparent 31%,
      rgba(180, 143, 78, 0.07) 31.1%,
      transparent 31.2%,
      transparent 73%,
      rgba(255, 255, 255, 0.025) 73.1%,
      transparent 73.2%
    ) !important;
}


/* image gets subtle brand treatment */

.about-who-v2-image {
  border:
    1px solid
    rgba(255, 255, 255, 0.10);

  box-shadow:
    0 28px 65px rgba(0, 35, 43, 0.24);
}

.about-who-v2-image-shade {
  background:
    linear-gradient(
      to top,
      rgba(0, 71, 88, 0.38),
      transparent 45%
    ) !important;
}


/* WHO WE ARE pill */

.about-who-v2-label {
  background:
    rgba(180, 143, 78, 0.96) !important;

  border-color:
    rgba(255, 255, 255, 0.20) !important;

  box-shadow:
    0 12px 30px
    rgba(0, 40, 49, 0.22) !important;
}

.about-who-v2-label i {
  color: #ffffff !important;
}


/* heading */

.about-who-v2-intro h1 {
  color: #ffffff !important;
}

.about-who-v2-intro h1 span {
  color: #d8b66f !important;
}


/* feature ticks */

.about-who-v2-feature {
  color:
    rgba(255, 255, 255, 0.94) !important;
}

.about-who-v2-feature > span {
  color: #d8b66f !important;
}


/* divider */

.about-who-v2-divider {
  background:
    linear-gradient(
      90deg,
      #b48f4e 0%,
      rgba(180, 143, 78, 0.45) 28%,
      rgba(255, 255, 255, 0.12) 65%,
      transparent 100%
    ) !important;
}


/* paragraph */

.about-who-v2-description {
  color:
    rgba(255, 255, 255, 0.78) !important;
}


/* CTA */

.about-who-v2-button {
  border-color:
    rgba(255, 255, 255, 0.72) !important;

  color: #ffffff !important;

  background:
    rgba(255, 255, 255, 0.025);
}

.about-who-v2-button i {
  background:
    #b48f4e !important;

  color:
    #ffffff !important;
}

.about-who-v2-button:hover {
  border-color:
    #b48f4e !important;

  background:
    rgba(180, 143, 78, 0.13) !important;
}


/* subtle gold line at bottom */

.about-who-v2::after {
  content: '';

  position: absolute;

  right: 8%;
  bottom: 0;
  left: 8%;

  height: 1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(180, 143, 78, 0.55),
      transparent
    );
}


/* =========================================================
   OUR TEAM
========================================================= */

.about-team {
  --team-teal: #004758;
  --team-gold: #b48f4e;
  --team-ink: #171918;
  --team-muted: #646866;
  --team-bg: #f7f6f3;

  position: relative;
  padding: 95px 0 90px;
  overflow: hidden;

  background: var(--team-bg);
}

.about-team-container {
  position: relative;
  z-index: 2;

  width: min(94%, 1440px);
  margin: 0 auto;
}


/* =========================================================
   ARCHITECTURAL BACKGROUND
========================================================= */

.about-team-watermark {
  position: absolute;

  top: 50px;
  left: 8%;

  width: 420px;
  height: 470px;

  opacity: 0.065;

  pointer-events: none;

  transform: skewY(-5deg);
}

.about-team-watermark::before,
.about-team-watermark::after,
.about-team-watermark span {
  content: '';

  position: absolute;

  border: 1px solid var(--team-teal);
}

.about-team-watermark::before {
  left: 60px;
  bottom: 0;

  width: 120px;
  height: 330px;

  transform: skewY(-35deg);
}

.about-team-watermark::after {
  left: 165px;
  bottom: 0;

  width: 170px;
  height: 250px;

  transform: skewY(30deg);
}

.about-team-watermark span:nth-child(1) {
  left: 20px;
  bottom: 65px;

  width: 330px;
  height: 1px;

  transform: rotate(-25deg);
}

.about-team-watermark span:nth-child(2) {
  left: 70px;
  bottom: 160px;

  width: 300px;
  height: 1px;

  transform: rotate(32deg);
}

.about-team-watermark span:nth-child(3) {
  left: 125px;
  bottom: 20px;

  width: 1px;
  height: 360px;
}


/* =========================================================
   HEADING
========================================================= */

.about-team-heading {
  width: min(100%, 760px);

  margin:
    0
    auto
    68px;

  text-align: center;
}

.about-team-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;

  margin-bottom: 17px;

  padding: 7px 13px;

  border: 1px solid rgba(0, 71, 88, 0.13);
  border-radius: 999px;

  background: rgba(255,255,255,.55);

  color: var(--team-teal);

  font-size: 9px;
  font-weight: 800;

  letter-spacing: .08em;

  text-transform: uppercase;
}

.about-team-eyebrow i {
  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: var(--team-gold);
}

.about-team-heading h2 {
  margin: 0;

  color: var(--team-teal);

  font-family: Arial, Helvetica, sans-serif;

  font-size: clamp(43px, 4.3vw, 68px);
  font-weight: 600;

  line-height: .98;

  letter-spacing: -.055em;
}

.about-team-heading h2 span {
  color: var(--team-gold);
}

.about-team-heading p {
  width: min(100%, 550px);

  margin:
    22px
    auto
    0;

  color: var(--team-muted);

  font-size: 12px;
  line-height: 1.65;
}


/* =========================================================
   GRID
========================================================= */

.about-team-grid {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 16px;
}


/* =========================================================
   CARD
========================================================= */

.about-team-card {
  position: relative;

  min-height: 285px;

  padding:
    28px
    27px
    25px;

  overflow: hidden;

  border:
    1px solid
    rgba(0, 71, 88, .045);

  border-radius: 18px;

  background: rgba(255,255,255,.94);

  box-shadow:
    0 10px 30px rgba(0, 71, 88, .035);

  transition:
    transform 450ms cubic-bezier(.22, 1, .36, 1),
    box-shadow 450ms ease,
    border-color 350ms ease;
}

.about-team-card::before {
  content: '';

  position: absolute;

  right: 0;
  bottom: 0;
  left: 0;

  height: 3px;

  background: var(--team-gold);

  transform: scaleX(0);

  transform-origin: left;

  transition:
    transform 450ms cubic-bezier(.22, 1, .36, 1);
}

.about-team-card:hover {
  transform: translateY(-9px);

  border-color:
    rgba(180, 143, 78, .23);

  box-shadow:
    0 22px 48px rgba(0, 71, 88, .09);
}

.about-team-card:hover::before {
  transform: scaleX(1);
}


/* =========================================================
   CARD TOP
========================================================= */

.about-team-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  min-height: 58px;
}

.about-team-dot {
  width: 7px;
  height: 7px;

  margin-top: 3px;

  border-radius: 50%;

  background: var(--team-gold);
}


/* =========================================================
   ABSTRACT ICONS
========================================================= */

.about-team-icon {
  position: relative;

  width: 48px;
  height: 48px;

  color: var(--team-gold);
}

.about-team-icon-arch {
  position: absolute;

  top: 5px;

  width: 20px;
  height: 35px;

  border: 1px solid currentColor;

  border-radius: 20px 20px 0 0;
}

.about-team-icon-arch:first-child {
  left: 4px;
}

.about-team-icon-arch:last-child {
  right: 4px;
}


/* circles */

.about-team-icon--circles span {
  position: absolute;

  top: 7px;

  width: 24px;
  height: 34px;

  border: 1px solid currentColor;

  border-radius: 50%;
}

.about-team-icon--circles span:nth-child(1) {
  left: 1px;
}

.about-team-icon--circles span:nth-child(2) {
  left: 12px;
}

.about-team-icon--circles span:nth-child(3) {
  left: 23px;
}


/* diamond */

.about-team-icon--diamond span {
  position: absolute;

  width: 27px;
  height: 27px;

  border: 1px solid currentColor;

  transform: rotate(45deg);
}

.about-team-icon--diamond span:first-child {
  top: 9px;
  left: 4px;
}

.about-team-icon--diamond span:last-child {
  top: 9px;
  right: 1px;
}


/* layers */

.about-team-icon--layers span {
  position: absolute;

  right: 2px;

  width: 40px;
  height: 14px;

  border: 1px solid currentColor;

  border-radius: 50%;
}

.about-team-icon--layers span:nth-child(1) {
  top: 4px;
}

.about-team-icon--layers span:nth-child(2) {
  top: 16px;
}

.about-team-icon--layers span:nth-child(3) {
  top: 28px;
}


/* =========================================================
   CARD TYPOGRAPHY
========================================================= */

.about-team-card h3 {
  margin:
    3px
    0
    0;

  color: var(--team-teal);

  font-family: Arial, Helvetica, sans-serif;

  font-size: clamp(19px, 1.55vw, 24px);
  font-weight: 700;

  line-height: 1.06;

  letter-spacing: -.035em;
}

.about-team-line {
  width: 100%;
  height: 1px;

  margin:
    28px
    0
    18px;

  background:
    rgba(0, 71, 88, .12);
}

.about-team-card p {
  margin: 0;

  color: #666a68;

  font-size: 11px;
  line-height: 1.75;
}

.about-team-role {
  display: inline-block;

  margin-top: 20px;

  color: var(--team-gold);

  font-size: 9px;
  font-weight: 800;

  letter-spacing: .10em;

  text-transform: uppercase;
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1000px) {

  .about-team-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 18px;
  }

  .about-team-card {
    min-height: 275px;
  }
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

  .about-team {
    padding:
      72px
      0
      60px;
  }

  .about-team-container {
    width: min(90%, 560px);
  }

  .about-team-heading {
    margin-bottom: 45px;
  }

  .about-team-heading h2 {
    font-size: clamp(36px, 10vw, 48px);
  }

  .about-team-grid {
    grid-template-columns: 1fr;
  }

  .about-team-card {
    min-height: auto;

    padding: 26px 24px;
  }

  .about-team-watermark {
    left: -150px;

    opacity: .04;
  }
}


/* =========================================================
   OUR VISION — LUXURY CLOSING SECTION
========================================================= */

.about-vision {
  --vision-teal: #004758;
  --vision-deep: #003844;
  --vision-gold: #b48f4e;
  --vision-cream: #f5f1ea;
  --vision-ink: #172326;

  position: relative;

  padding:
    clamp(90px, 9vw, 140px)
    0
    60px;

  overflow: hidden;

  background:
    radial-gradient(
      circle at 87% 12%,
      rgba(180, 143, 78, .13),
      transparent 26%
    ),
    linear-gradient(
      135deg,
      #f8f5ef 0%,
      #f2eee6 100%
    );
}


/* =========================================================
   GIANT BACKGROUND WORD
========================================================= */

.about-vision-word {
  position: absolute;

  top: 25px;
  left: 50%;

  transform: translateX(-50%);

  color: transparent;

  -webkit-text-stroke:
    1px rgba(0, 71, 88, .065);

  font-family: Arial, Helvetica, sans-serif;

  font-size: clamp(110px, 19vw, 300px);
  font-weight: 800;

  line-height: .8;

  letter-spacing: -.08em;

  white-space: nowrap;

  pointer-events: none;
  user-select: none;
}


.about-vision-container {
  position: relative;
  z-index: 2;

  width: min(91%, 1380px);

  margin: 0 auto;
}


/* =========================================================
   TOP
========================================================= */

.about-vision-top {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 45px;
}

.about-vision-eyebrow {
  display: inline-flex;
  align-items: center;

  gap: 8px;

  padding:
    8px
    14px;

  border:
    1px solid rgba(0, 71, 88, .15);

  border-radius: 999px;

  color: var(--vision-teal);

  font-size: 9px;
  font-weight: 800;

  letter-spacing: .1em;

  text-transform: uppercase;
}

.about-vision-eyebrow i {
  color: var(--vision-gold);

  font-style: normal;
}

.about-vision-since {
  color: var(--vision-gold);

  font-size: 9px;
  font-weight: 800;

  letter-spacing: .16em;
}


/* =========================================================
   MAIN STATEMENT
========================================================= */

.about-vision-statement {
  position: relative;

  max-width: 1150px;

  margin-bottom:
    clamp(60px, 7vw, 100px);
}

.about-vision-statement h2 {
  margin: 0;

  color: var(--vision-teal);

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size:
    clamp(48px, 6.4vw, 98px);

  font-weight: 500;

  line-height: .93;

  letter-spacing: -.065em;

  text-transform: uppercase;
}

.about-vision-line-two {
  padding-left:
    clamp(20px, 7vw, 110px);
}

.about-vision-statement em {
  color: var(--vision-gold);

  font-family:
    Georgia,
    'Times New Roman',
    serif;

  font-weight: 400;
  font-style: italic;

  text-transform: none;
}

.about-vision-line-three {
  color: var(--vision-deep);
}


/* =========================================================
   CONTENT LAYOUT
========================================================= */

.about-vision-layout {
  display: grid;

  grid-template-columns:
    minmax(280px, .72fr)
    minmax(500px, 1.28fr);

  align-items: end;

  gap:
    clamp(55px, 7vw, 110px);
}


/* =========================================================
   COPY
========================================================= */

.about-vision-copy {
  padding-bottom: 25px;
}

.about-vision-index {
  display: block;

  margin-bottom: 25px;

  color: var(--vision-gold);

  font-size: 8px;
  font-weight: 800;

  letter-spacing: .16em;
}

.about-vision-lead {
  max-width: 430px;

  margin: 0;

  color: #4f5b5d;

  font-size:
    clamp(14px, 1.25vw, 17px);

  line-height: 1.8;
}

.about-vision-divider {
  width: 100%;
  height: 1px;

  margin:
    34px
    0
    27px;

  background:
    linear-gradient(
      90deg,
      var(--vision-gold),
      rgba(180,143,78,.15),
      transparent
    );
}


/* principles */

.about-vision-principles {
  display: grid;

  gap: 15px;
}

.about-vision-principles > div {
  display: flex;
  align-items: center;

  gap: 17px;
}

.about-vision-principles span {
  display: grid;
  place-items: center;

  flex: 0 0 31px;

  width: 31px;
  height: 31px;

  border:
    1px solid rgba(0, 71, 88, .17);

  border-radius: 50%;

  color: var(--vision-gold);

  font-size: 8px;
  font-weight: 800;
}

.about-vision-principles p {
  margin: 0;

  color: var(--vision-teal);

  font-size: 12px;
}

.about-vision-principles strong {
  color: var(--vision-gold);

  font-weight: 700;
}


/* =========================================================
   VISUAL
========================================================= */

.about-vision-visual {
  position: relative;

  padding:
    0
    55px
    55px
    0;
}

.about-vision-image {
  position: relative;

  height:
    clamp(470px, 47vw, 650px);

  overflow: hidden;

  border-radius:
    260px
    260px
    24px
    24px;

  background: var(--vision-teal);

  box-shadow:
    0 35px 80px
    rgba(0, 71, 88, .16);
}

.about-vision-image img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  transition:
    transform
    1.4s
    cubic-bezier(.22, 1, .36, 1);
}

.about-vision:hover
.about-vision-image img {
  transform: scale(1.045);
}

.about-vision-image-overlay {
  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      to top,
      rgba(0, 71, 88, .42),
      transparent 45%
    );
}


/* =========================================================
   FLOATING PHILOSOPHY CARD
========================================================= */

.about-vision-signature {
  position: absolute;

  right: 0;
  bottom: 0;

  display: flex;
  flex-direction: column;

  min-width: 205px;

  padding:
    24px
    27px;

  border:
    1px solid rgba(255,255,255,.13);

  border-radius: 17px;

  background:
    rgba(0, 71, 88, .96);

  box-shadow:
    0 20px 50px
    rgba(0, 50, 61, .22);

  color: #fff;
}

.about-vision-signature > span {
  margin-bottom: 8px;

  color: rgba(255,255,255,.62);

  font-size: 8px;
  font-weight: 700;

  letter-spacing: .15em;

  text-transform: uppercase;
}

.about-vision-signature strong {
  font-family:
    Georgia,
    'Times New Roman',
    serif;

  font-size: 20px;
  font-weight: 400;
}

.about-vision-signature i {
  margin: 0 4px;

  color: var(--vision-gold);

  font-style: normal;
}


/* =========================================================
   V ORBIT
========================================================= */

.about-vision-orbit {
  position: absolute;

  top: 10%;
  left: -48px;

  display: grid;
  place-items: center;

  width: 96px;
  height: 96px;

  border:
    1px solid rgba(180,143,78,.55);

  border-radius: 50%;

  background:
    rgba(245,241,234,.88);

  backdrop-filter: blur(8px);

  box-shadow:
    0 14px 35px
    rgba(0,71,88,.08);
}

.about-vision-orbit::before {
  content: '';

  position: absolute;

  inset: 8px;

  border:
    1px dashed
    rgba(0,71,88,.25);

  border-radius: 50%;

  animation:
    visionOrbit
    18s
    linear
    infinite;
}

.about-vision-orbit span {
  color: var(--vision-teal);

  font-family:
    Georgia,
    'Times New Roman',
    serif;

  font-size: 35px;

  font-style: italic;
}


/* =========================================================
   BOTTOM BRAND STRIP
========================================================= */

.about-vision-footer {
  display: flex;
  align-items: center;
  justify-content: center;

  flex-wrap: wrap;

  gap: 14px;

  margin-top: 75px;

  padding-top: 24px;

  border-top:
    1px solid rgba(0,71,88,.12);

  color: #667174;

  font-size: 8px;
  font-weight: 800;

  letter-spacing: .13em;

  text-transform: uppercase;
}

.about-vision-footer i {
  width: 5px;
  height: 5px;

  border-radius: 50%;

  background:
    var(--vision-gold);
}

.about-vision-footer strong {
  color: var(--vision-teal);

  font-weight: 800;
}


/* =========================================================
   ANIMATION
========================================================= */

@keyframes visionOrbit {
  to {
    transform: rotate(360deg);
  }
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 950px) {

  .about-vision-layout {
    grid-template-columns: 1fr;

    gap: 55px;
  }

  .about-vision-copy {
    max-width: 650px;
  }

  .about-vision-visual {
    width: min(92%, 720px);

    margin-left: auto;
  }
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 620px) {

  .about-vision {
    padding:
      75px
      0
      45px;
  }

  .about-vision-container {
    width: min(89%, 560px);
  }

  .about-vision-top {
    margin-bottom: 37px;
  }

  .about-vision-since {
    font-size: 7px;
  }

  .about-vision-statement {
    margin-bottom: 52px;
  }

  .about-vision-statement h2 {
    font-size:
      clamp(39px, 11.5vw, 58px);

    line-height: .98;
  }

  .about-vision-line-two {
    padding-left: 0;
  }

  .about-vision-lead {
    font-size: 13px;
  }

  .about-vision-visual {
    width: 100%;

    padding:
      0
      0
      65px;

    margin: 0;
  }

  .about-vision-image {
    height: 470px;

    border-radius:
      170px
      170px
      18px
      18px;
  }

  .about-vision-orbit {
    top: -30px;
    left: -15px;

    width: 76px;
    height: 76px;
  }

  .about-vision-orbit span {
    font-size: 28px;
  }

  .about-vision-signature {
    right: 15px;

    min-width: 180px;

    padding:
      20px
      22px;
  }

  .about-vision-footer {
    gap:
      9px
      11px;

    margin-top: 45px;

    text-align: center;
  }
}


@media (prefers-reduced-motion: reduce) {

  .about-vision-orbit::before {
    animation: none;
  }

  .about-vision-image img {
    transition: none;
  }
}


/* =========================================================
   OUR VISION — LUXURY V2 POLISH
========================================================= */

/* Premium layered ivory canvas */

.about-vision {
  background:
    radial-gradient(
      circle at 82% 18%,
      rgba(180, 143, 78, 0.16) 0%,
      rgba(180, 143, 78, 0.05) 20%,
      transparent 43%
    ),
    radial-gradient(
      circle at 8% 78%,
      rgba(0, 71, 88, 0.07) 0%,
      transparent 34%
    ),
    linear-gradient(
      125deg,
      #fbf9f5 0%,
      #f4efe7 48%,
      #f8f5ef 100%
    ) !important;
}


/* =========================================================
   VERY SUBTLE LUXURY GRAIN
========================================================= */

.about-vision::before {
  content: '';

  position: absolute;
  inset: 0;

  z-index: 0;

  pointer-events: none;

  opacity: 0.18;

  background-image:
    radial-gradient(
      rgba(0, 71, 88, 0.10) 0.45px,
      transparent 0.55px
    );

  background-size: 6px 6px;

  mask-image:
    linear-gradient(
      to bottom,
      rgba(0,0,0,.5),
      transparent 85%
    );
}


/* =========================================================
   GIANT VISION WORD
========================================================= */

.about-vision-word {
  top: 18px !important;

  opacity: 1;

  -webkit-text-stroke:
    1px rgba(0, 71, 88, 0.075) !important;

  letter-spacing: -0.09em !important;
}


/* =========================================================
   TOP LABEL — MORE LUXURY
========================================================= */

.about-vision-eyebrow {
  padding: 9px 16px !important;

  border-color:
    rgba(180, 143, 78, 0.28) !important;

  background:
    rgba(255, 255, 255, 0.48);

  box-shadow:
    inset 0 0 0 1px rgba(255,255,255,.5);

  backdrop-filter: blur(10px);
}

.about-vision-eyebrow i {
  text-shadow:
    0 0 12px rgba(180,143,78,.35);
}


/* EST 2019 */

.about-vision-since {
  position: relative;

  padding-left: 52px;
}

.about-vision-since::before {
  content: '';

  position: absolute;

  top: 50%;
  left: 0;

  width: 38px;
  height: 1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      #b48f4e
    );
}


/* =========================================================
   HERO TYPOGRAPHY
========================================================= */

.about-vision-statement h2 {
  text-shadow:
    0 1px 0 rgba(255,255,255,.55);
}


/* Metallic bronze-gold italic word */

.about-vision-statement em {
  color: #b48f4e !important;

  background:
    linear-gradient(
      115deg,
      #8f6b32 0%,
      #b48f4e 30%,
      #d7b979 52%,
      #a77f3e 78%,
      #c7a462 100%
    );

  -webkit-background-clip: text;
  background-clip: text;

  -webkit-text-fill-color: transparent;

  filter:
    drop-shadow(
      0 5px 16px rgba(180,143,78,.12)
    );
}


/* thin editorial line beside statement */

.about-vision-statement::after {
  content: '';

  position: absolute;

  right: 0;
  bottom: -30px;

  width: min(23vw, 280px);
  height: 1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(180,143,78,.7)
    );
}


/* =========================================================
   LEFT COPY — EDITORIAL
========================================================= */

.about-vision-index {
  position: relative;

  padding-left: 52px;
}

.about-vision-index::before {
  content: '';

  position: absolute;

  top: 50%;
  left: 0;

  width: 38px;
  height: 1px;

  background: #b48f4e;
}


.about-vision-lead::first-letter {
  float: left;

  margin:
    5px
    8px
    0
    0;

  color: #004758;

  font-family:
    Georgia,
    'Times New Roman',
    serif;

  font-size: 50px;
  line-height: .72;
}


/* principles */

.about-vision-principles > div {
  padding:
    5px
    0;

  transition:
    transform 300ms ease;
}

.about-vision-principles > div:hover {
  transform: translateX(7px);
}

.about-vision-principles span {
  background:
    rgba(255,255,255,.45);

  box-shadow:
    inset 0 0 0 3px
    rgba(255,255,255,.35);
}


/* =========================================================
   CINEMATIC IMAGE
========================================================= */

.about-vision-image {
  isolation: isolate;

  border:
    1px solid rgba(180,143,78,.20);

  box-shadow:
    0 45px 90px rgba(0,71,88,.17),
    0 10px 25px rgba(0,71,88,.08) !important;
}


/* cinematic image tone */

.about-vision-image img {
  filter:
    saturate(.88)
    contrast(1.03)
    brightness(.96);
}


/* warm luxury light */

.about-vision-image::before {
  content: '';

  position: absolute;
  z-index: 2;

  inset: 0;

  pointer-events: none;

  background:
    radial-gradient(
      circle at 75% 15%,
      rgba(221, 190, 127, .19),
      transparent 35%
    );
}


/* deeper teal gradient */

.about-vision-image-overlay {
  z-index: 3;

  background:
    linear-gradient(
      180deg,
      transparent 48%,
      rgba(0,71,88,.10) 67%,
      rgba(0,55,68,.48) 100%
    ) !important;
}


/* =========================================================
   GOLD FRAME OFFSET
========================================================= */

.about-vision-visual::before {
  content: '';

  position: absolute;

  z-index: -1;

  top: 34px;
  right: 18px;
  bottom: 20px;
  left: 35px;

  border:
    1px solid rgba(180,143,78,.32);

  border-radius:
    260px
    260px
    24px
    24px;

  pointer-events: none;
}


/* =========================================================
   PHILOSOPHY CARD — GLASS TEAL
========================================================= */

.about-vision-signature {
  overflow: hidden;

  border:
    1px solid rgba(215,185,121,.38) !important;

  background:
    linear-gradient(
      135deg,
      rgba(0,71,88,.97),
      rgba(0,53,65,.96)
    ) !important;

  box-shadow:
    0 25px 55px rgba(0,45,55,.27),
    inset 0 1px 0 rgba(255,255,255,.10) !important;

  backdrop-filter: blur(16px);
}

.about-vision-signature::before {
  content: '';

  position: absolute;

  top: 0;
  left: -30%;

  width: 45%;
  height: 100%;

  transform: skewX(-22deg);

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255,255,255,.08),
      transparent
    );

  transition:
    left 900ms cubic-bezier(.22,1,.36,1);
}

.about-vision-signature:hover::before {
  left: 120%;
}

.about-vision-signature strong {
  color: #fff;

  letter-spacing: -.02em;
}


/* =========================================================
   VASUPRIY V MEDALLION
========================================================= */

.about-vision-orbit {
  border:
    1px solid rgba(180,143,78,.65) !important;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.94),
      rgba(242,234,220,.94)
    ) !important;

  box-shadow:
    0 20px 45px rgba(0,71,88,.13),
    inset 0 0 0 7px rgba(180,143,78,.05) !important;
}

.about-vision-orbit::after {
  content: '';

  position: absolute;

  inset: 15px;

  border:
    1px solid rgba(180,143,78,.22);

  border-radius: 50%;
}

.about-vision-orbit span {
  position: relative;
  z-index: 2;

  color: #004758 !important;

  text-shadow:
    1px 1px 0 rgba(180,143,78,.15);
}


/* =========================================================
   BOTTOM STRIP
========================================================= */

.about-vision-footer {
  position: relative;

  padding-top: 27px !important;
}

.about-vision-footer::before {
  content: '';

  position: absolute;

  top: -1px;
  left: 50%;

  width: 90px;
  height: 2px;

  transform: translateX(-50%);

  background:
    linear-gradient(
      90deg,
      transparent,
      #b48f4e,
      transparent
    );
}

.about-vision-footer strong {
  position: relative;

  padding:
    7px
    13px;

  border:
    1px solid rgba(180,143,78,.20);

  border-radius: 999px;

  background:
    rgba(255,255,255,.38);
}


/* =========================================================
   RESPONSIVE LUXURY DETAILS
========================================================= */

@media (max-width: 950px) {

  .about-vision-statement::after {
    width: 160px;
  }

  .about-vision-visual::before {
    right: -12px;
  }
}


@media (max-width: 620px) {

  .about-vision::before {
    opacity: .10;
  }

  .about-vision-statement::after {
    display: none;
  }

  .about-vision-lead::first-letter {
    font-size: 42px;
  }

  .about-vision-visual::before {
    top: 22px;
    right: -8px;
    bottom: 48px;
    left: 15px;

    border-radius:
      170px
      170px
      18px
      18px;
  }

  .about-vision-since {
    padding-left: 0;
  }

  .about-vision-since::before {
    display: none;
  }
}


/* =========================================================
   OUR VISION — NAVBAR BRAND LOGO MEDALLION
========================================================= */

.about-vision-orbit {
  padding: 9px !important;

  box-sizing: border-box;

  background:
    rgba(255, 255, 255, 0.96) !important;

  border:
    1px solid rgba(180, 143, 78, 0.70) !important;
}

.about-vision-orbit-logo {
  position: relative;
  z-index: 4;

  display: block;

  width: 100%;
  height: 100%;

  padding: 5px;

  box-sizing: border-box;

  object-fit: contain;
  object-position: center;

  opacity: 1;

  filter: none !important;

  transform: none !important;
}


/* remove old V styling */

.about-vision-orbit > span {
  display: none !important;
}


/* keep decorative luxury rings behind logo */

.about-vision-orbit::before,
.about-vision-orbit::after {
  z-index: 1;
}

.about-vision-orbit::after {
  inset: 7px !important;

  border-color:
    rgba(180, 143, 78, 0.22) !important;
}


/* mobile */

@media (max-width: 620px) {

  .about-vision-orbit {
    padding: 7px !important;
  }

  .about-vision-orbit-logo {
    padding: 4px;
  }
}


/* =========================================================
   ABOUT PAGE — PREMIUM SCROLL REVEAL SYSTEM
========================================================= */

.about-page .about-scroll-reveal {
  --reveal-x: 0px;
  --reveal-y: 0px;
  --reveal-scale: 1;
  --reveal-delay: 0ms;

  opacity: 0;

  filter:
    blur(7px);

  transform:
    translate3d(
      var(--reveal-x),
      var(--reveal-y),
      0
    )
    scale(var(--reveal-scale));

  transition:
    opacity
      900ms
      cubic-bezier(.22, 1, .36, 1)
      var(--reveal-delay),

    transform
      1100ms
      cubic-bezier(.16, 1, .3, 1)
      var(--reveal-delay),

    filter
      850ms
      ease
      var(--reveal-delay);

  will-change:
    opacity,
    transform,
    filter;
}


/* LEFT -> CENTRE */

.about-page .reveal-left {
  --reveal-x: -55px;
}


/* RIGHT -> CENTRE */

.about-page .reveal-right {
  --reveal-x: 55px;
}


/* BOTTOM -> POSITION */

.about-page .reveal-up {
  --reveal-y: 48px;
}


/* TOP -> POSITION */

.about-page .reveal-down {
  --reveal-y: -35px;
}


/* LUXURY SCALE */

.about-page .reveal-scale {
  --reveal-y: 22px;
  --reveal-scale: .955;
}


/* FINAL STATE */

.about-page .about-scroll-reveal.is-revealed {
  opacity: 1;

  filter:
    blur(0);

  transform:
    translate3d(0, 0, 0)
    scale(1);
}


/* =========================================================
   EXTRA CINEMATIC IMAGE SETTLE
========================================================= */

.about-page
.about-scroll-reveal.about-process-visual,

.about-page
.about-scroll-reveal.about-what-visual,

.about-page
.about-scroll-reveal.about-vision-visual {

  transition-duration:
    1000ms,
    1250ms,
    900ms;
}


/* =========================================================
   CARDS — SLIGHT LUXURY ROTATION BEFORE REVEAL
========================================================= */

.about-page
.about-approach-card.about-scroll-reveal:not(.is-revealed):nth-child(odd),

.about-page
.about-speciality-card.about-scroll-reveal:not(.is-revealed):nth-child(odd),

.about-page
.about-team-card.about-scroll-reveal:not(.is-revealed):nth-child(odd) {

  transform:
    translate3d(
      var(--reveal-x),
      var(--reveal-y),
      0
    )
    scale(var(--reveal-scale))
    rotate(-1deg);
}


.about-page
.about-approach-card.about-scroll-reveal:not(.is-revealed):nth-child(even),

.about-page
.about-speciality-card.about-scroll-reveal:not(.is-revealed):nth-child(even),

.about-page
.about-team-card.about-scroll-reveal:not(.is-revealed):nth-child(even) {

  transform:
    translate3d(
      var(--reveal-x),
      var(--reveal-y),
      0
    )
    scale(var(--reveal-scale))
    rotate(1deg);
}


/* =========================================================
   MOBILE — LESS MOVEMENT, SAME PREMIUM FEEL
========================================================= */

@media (max-width: 700px) {

  .about-page .reveal-left {
    --reveal-x: -25px;
  }

  .about-page .reveal-right {
    --reveal-x: 25px;
  }

  .about-page .reveal-up {
    --reveal-y: 32px;
  }

  .about-page .reveal-down {
    --reveal-y: -22px;
  }

  .about-page .reveal-scale {
    --reveal-y: 20px;
    --reveal-scale: .975;
  }

  .about-page .about-scroll-reveal {
    filter:
      blur(4px);

    transition:
      opacity
        750ms
        cubic-bezier(.22, 1, .36, 1)
        var(--reveal-delay),

      transform
        900ms
        cubic-bezier(.16, 1, .3, 1)
        var(--reveal-delay),

      filter
        700ms
        ease
        var(--reveal-delay);
  }

  .about-page
  .about-scroll-reveal.is-revealed {
    filter: blur(0);
  }
}


/* =========================================================
   ACCESSIBILITY
========================================================= */

@media (prefers-reduced-motion: reduce) {

  .about-page .about-scroll-reveal,
  .about-page .about-scroll-reveal.is-revealed {

    opacity: 1 !important;

    filter: none !important;

    transform: none !important;

    transition: none !important;
  }
}


/* =========================================================
   OUR SPECIALITIES — 5 ITEM AUTO SLIDER
   Desktop: 3 visible
   Tablet: 2 visible
   Mobile: 1 visible
========================================================= */

.about-specialities-slider {
  position: relative;
  width: 100%;
  overflow: hidden;
  padding: 22px 2px 8px;
}

.about-specialities-slider .about-specialities-grid {
  display: flex;
  align-items: center;
  gap: clamp(20px, 2.4vw, 36px);

  width: 100%;

  overflow: visible;

  transition:
    opacity 280ms ease,
    transform 650ms cubic-bezier(0.22, 1, 0.36, 1);
}

.about-specialities-slider .about-speciality-card {
  flex:
    0 0
    calc(
      (100% - (clamp(20px, 2.4vw, 36px) * 2))
      / 3
    );

  min-width: 0;

  animation:
    speciality-card-enter
    700ms
    cubic-bezier(0.22, 1, 0.36, 1)
    both;
}

.about-specialities-slider
.about-speciality-card:nth-child(2) {
  animation-delay: 70ms;
}

.about-specialities-slider
.about-speciality-card:nth-child(3) {
  animation-delay: 140ms;
}

.about-specialities-slider
.about-speciality-card:nth-child(n + 4) {
  display: none;
}

@keyframes speciality-card-enter {
  from {
    opacity: 0;
    transform: translate3d(34px, 0, 0);
  }

  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}


/* Keep the centre card premium */

.about-specialities-slider
.about-speciality-card--featured {
  transform: translateY(-18px);
}

.about-specialities-slider
.about-speciality-card--featured
.about-speciality-image {
  height: 575px;
  border-radius: 220px 220px 24px 24px;
}


/* Navigation dots */

.about-specialities-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;

  margin-top: 34px;
}

.about-specialities-dots button {
  width: 7px;
  height: 7px;

  padding: 0;

  border: 0;
  border-radius: 999px;

  background: rgba(0, 74, 94, 0.22);

  cursor: pointer;

  transition:
    width 350ms ease,
    background 350ms ease,
    transform 350ms ease;
}

.about-specialities-dots button:hover {
  background: #af9166;
  transform: scale(1.15);
}

.about-specialities-dots button.is-active {
  width: 30px;
  background: #af9166;
}


/* =========================================================
   TABLET — 2 VISIBLE
========================================================= */

@media (max-width: 1000px) {

  .about-specialities-slider
  .about-speciality-card {
    flex:
      0 0
      calc(
        (100% - 24px)
        / 2
      );

    width: auto;
    margin: 0;
  }

  .about-specialities-slider
  .about-speciality-card:nth-child(3) {
    display: none;
  }

  .about-specialities-slider
  .about-speciality-card--featured {
    transform: none;
  }

  .about-specialities-slider
  .about-speciality-card--featured
  .about-speciality-image {
    height: 520px;
    border-radius: 190px 190px 24px 24px;
  }
}


/* =========================================================
   MOBILE — 1 VISIBLE
========================================================= */

@media (max-width: 650px) {

  .about-specialities-slider {
    padding-top: 5px;
  }

  .about-specialities-slider
  .about-specialities-grid {
    gap: 0;
  }

  .about-specialities-slider
  .about-speciality-card {
    display: none;
    flex: 0 0 100%;
    width: 100%;
  }

  .about-specialities-slider
  .about-speciality-card:first-child {
    display: block;
  }

  .about-specialities-slider
  .about-speciality-image,
  .about-specialities-slider
  .about-speciality-card--featured
  .about-speciality-image {
    height: 500px;
    border-radius: 160px 160px 20px 20px;
  }

  .about-specialities-dots {
    margin-top: 25px;
  }
}


/* Reduced motion */

@media (prefers-reduced-motion: reduce) {

  .about-specialities-slider
  .about-speciality-card {
    animation: none !important;
  }

  .about-specialities-slider
  .about-specialities-grid {
    transition: none !important;
  }
}


/* =========================================================
   OUR SPECIALITIES — TRUE SMOOTH 2 SECOND SLIDER
========================================================= */

.about-specialities-slider {
  overflow: hidden !important;
}

.about-specialities-slider .about-specialities-grid {
  --speciality-gap: clamp(20px, 2.4vw, 36px);

  display: flex !important;
  align-items: center;
  gap: var(--speciality-gap) !important;

  width: 100%;
  overflow: visible !important;

  transform: translate3d(0, 0, 0);

  transition:
    transform 2s cubic-bezier(0.65, 0, 0.35, 1) !important;

  will-change: transform;
}

.about-specialities-slider
.about-specialities-grid.is-sliding {
  transform:
    translate3d(
      calc(
        -1 * (
          (100% - (var(--speciality-gap) * 2)) / 3
          + var(--speciality-gap)
        )
      ),
      0,
      0
    );
}


/* 4th card must exist outside viewport for seamless entry */

.about-specialities-slider
.about-speciality-card:nth-child(4) {
  display: block !important;
}


/* Disable previous card-enter animation.
   Physical track now provides the movement. */

.about-specialities-slider
.about-speciality-card {
  animation: none !important;
}


/* =========================================================
   TABLET — 2 VISIBLE
========================================================= */

@media (max-width: 1000px) {

  .about-specialities-slider
  .about-specialities-grid {
    --speciality-gap: 24px;
  }

  .about-specialities-slider
  .about-speciality-card:nth-child(3),
  .about-specialities-slider
  .about-speciality-card:nth-child(4) {
    display: block !important;
  }

  .about-specialities-slider
  .about-specialities-grid.is-sliding {
    transform:
      translate3d(
        calc(
          -1 * (
            (100% - var(--speciality-gap)) / 2
            + var(--speciality-gap)
          )
        ),
        0,
        0
      );
  }
}


/* =========================================================
   MOBILE — 1 VISIBLE
========================================================= */

@media (max-width: 650px) {

  .about-specialities-slider
  .about-specialities-grid {
    --speciality-gap: 0px;
  }

  .about-specialities-slider
  .about-speciality-card,
  .about-specialities-slider
  .about-speciality-card:first-child,
  .about-specialities-slider
  .about-speciality-card:nth-child(2),
  .about-specialities-slider
  .about-speciality-card:nth-child(3),
  .about-specialities-slider
  .about-speciality-card:nth-child(4) {
    display: block !important;

    flex: 0 0 100% !important;
    width: 100% !important;
  }

  .about-specialities-slider
  .about-specialities-grid.is-sliding {
    transform: translate3d(-100%, 0, 0);
  }
}


/* Accessibility */

@media (prefers-reduced-motion: reduce) {

  .about-specialities-slider
  .about-specialities-grid {
    transition: none !important;
    transform: none !important;
  }
}

