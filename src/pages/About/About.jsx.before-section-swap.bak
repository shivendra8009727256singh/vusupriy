                <div className="about-what-detail">
                  <span aria-hidden="true">✓</span>

                  <p>
                    Clear visual planning for confident design
                    decisions and coordinated execution.
                  </p>
                </div>
              </article>

            </div>


            {/* CENTER VISUAL */}
            <div className="about-what-visual">

              <div className="about-what-arch about-what-arch--back">
                <img
                  src={whatWeDoLeft}
                  alt="Elegant Vasupriy residential interior"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div className="about-what-arch about-what-arch--front">
