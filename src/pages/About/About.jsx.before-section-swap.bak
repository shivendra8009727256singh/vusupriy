              partners to bring dependable materials, refined finishes
              and lasting value to every Vasupriy interior.
            </p>

          </div>

        </div>


        <div
          className="about-partners-marquee"
          aria-label="Vasupriy brand partners"
        >
          <div className="about-partners-track">

            {[0, 1].map((group) => (
              <div
                className="about-partners-group"
                key={group}
                aria-hidden={group === 1}
              >
                {brandPartners.map((partner) => (
                  <div
                    className="about-partner-card"
                    key={`${group}-${partner.name}`}
                  >
                    <img
                      src={partner.logo}
                      alt={group === 0 ? partner.name : ''}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                ))}
              </div>
            ))}

          </div>
        </div>


        <div className="about-partners-container">

          <div className="about-partners-bottom">
            <span>Quality Materials</span>
            <i aria-hidden="true" />
            <span>Trusted Brands</span>
            <i aria-hidden="true" />
            <span>Refined Finishes</span>
            <i aria-hidden="true" />
            <span>Built To Last</span>
          </div>

        </div>

      </section>

      {/* =====================================================
