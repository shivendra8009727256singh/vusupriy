                decoding="async"
              />

              <div
                className="about-who-v2-image-shade"
                aria-hidden="true"
              />
            </div>

            <span className="about-who-v2-label">
              <i aria-hidden="true">✦</i>
              Who We Are
            </span>

          </div>


          <div className="about-who-v2-content">

            <div className="about-who-v2-intro">

              <h1 id="about-who-v2-title">
                Whether it’s your home, office, or a commercial
                space, we bring your
                <span> vision to life.</span>
              </h1>

            </div>


            <div className="about-who-v2-features">

              <div className="about-who-v2-feature">
                <span aria-hidden="true">✓</span>
                <strong>Customized Interiors</strong>
              </div>

              <div className="about-who-v2-feature">
                <span aria-hidden="true">✓</span>
                <strong>Quality Materials</strong>
              </div>

              <div className="about-who-v2-feature">
                <span aria-hidden="true">✓</span>
                <strong>Residential &amp; Commercial</strong>
              </div>

              <div className="about-who-v2-feature">
                <span aria-hidden="true">✓</span>
                <strong>End-to-End Execution</strong>
              </div>

            </div>


            <div className="about-who-v2-divider" />


            <p className="about-who-v2-description">
              Established in 2019, Vasupriy Interiovilla creates
              thoughtful interiors where modern aesthetics,
              functionality and refined detailing work together.
              From space planning and material selection to
              customized solutions and final execution, we shape
              residential and commercial spaces around the people
              who use them.
            </p>


            <Link
              to="/interior-services"
              className="about-who-v2-button"
            >
              <span>More About Us</span>

              <i aria-hidden="true">
                ↗
              </i>
            </Link>

          </div>

        </div>
      </section>

      {/* =====================================================
          HOW WE WORK
      ====================================================== */}
      <section
        className="about-process"
        aria-labelledby="about-process-title"
      >
        <div className="about-process-container">

          <div className="about-process-intro">
            <div className="about-process-label-column">
              <span
                className="about-process-top-line"
                aria-hidden="true"
              />

              <span className="about-process-label">
                <i aria-hidden="true" />
                How We Work
              </span>

              <span
                className="about-process-vertical-line"
                aria-hidden="true"
              />
            </div>

            <div className="about-process-heading">
              <h2 id="about-process-title">
                A Thoughtful{' '}
                <span>Design Process</span>
                <br />
                Built For <strong>Results.</strong>
              </h2>

              <p>
                From the first conversation to final handover, our
                process keeps every stage clear, collaborative and
                focused on transforming your vision into a beautifully
                executed space.
              </p>
            </div>
          </div>


          <div className="about-process-content">

            <div className="about-process-visual">
              <div className="about-process-image-stack">
                {howWeWorkSteps.map((step, index) => (
                  <img
                    key={step.id}
                    src={step.image}
                    alt={step.title}
                    loading="lazy"
                    decoding="async"
                    className={
                      index === activeProcessStep
                        ? 'about-process-image about-process-image--active'
                        : 'about-process-image'
                    }
                  />
                ))}
              </div>
            </div>


            <div className="about-process-steps">

              <article
                className={`about-process-step ${activeProcessStep === 0
                    ? 'about-process-step--active'
                    : ''
                  }`}
                onMouseEnter={() => setActiveProcessStep(0)}
                onFocus={() => setActiveProcessStep(0)}
                onClick={() => setActiveProcessStep(0)}
                tabIndex={0}
              >
                <span className="about-process-number">
                  01
                </span>

                <div>
                  <h3>Initial Consultation</h3>
                  <p>
                    We understand your vision, lifestyle,
                    requirements, preferences and project goals.
                  </p>
                </div>
              </article>


              <article
                className={`about-process-step ${activeProcessStep === 1
                    ? 'about-process-step--active'
                    : ''
                  }`}
                onMouseEnter={() => setActiveProcessStep(1)}
                onFocus={() => setActiveProcessStep(1)}
                onClick={() => setActiveProcessStep(1)}
                tabIndex={0}
              >
                <span className="about-process-number">
                  02
                </span>

                <div>
                  <h3>Design &amp; Planning</h3>
                  <p>
                    We develop the space plan, design direction,
                    materials and details required for execution.
                  </p>
                </div>
              </article>


              <article
                className={`about-process-step ${activeProcessStep === 2
                    ? 'about-process-step--active'
                    : ''
                  }`}
                onMouseEnter={() => setActiveProcessStep(2)}
                onFocus={() => setActiveProcessStep(2)}
                onClick={() => setActiveProcessStep(2)}
                tabIndex={0}
              >
                <span className="about-process-number">
                  03
                </span>

                <div>
                  <h3>Implementation</h3>
                  <p>
                    Our team coordinates the work, materials and
                    execution with attention to quality and detail.
                  </p>
                </div>
              </article>


              <article
                className={`about-process-step ${activeProcessStep === 3
                    ? 'about-process-step--active'
                    : ''
                  }`}
                onMouseEnter={() => setActiveProcessStep(3)}
                onFocus={() => setActiveProcessStep(3)}
                onClick={() => setActiveProcessStep(3)}
                tabIndex={0}
              >
                <span className="about-process-number">
                  04
                </span>

                <div>
                  <h3>Project Handover</h3>
                  <p>
                    We complete final checks and hand over a
                    thoughtfully finished space ready to experience.
                  </p>
                </div>
              </article>

            </div>
          </div>

        </div>
      </section>


      {/* =====================================================
          WHAT WE DO
      ====================================================== */}
      <section
        className="about-what"
        aria-labelledby="about-what-title"
      >
        <div className="about-what-container">

          <div className="about-what-heading">
            <span className="about-what-eyebrow">
