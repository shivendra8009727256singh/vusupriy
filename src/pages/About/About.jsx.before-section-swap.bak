  { name: 'Marino', logo: partnerMarino },
  { name: 'REHAU', logo: partnerRehau },
]

function About() {

  /* =========================================================
     PREMIUM SCROLL REVEAL
  ========================================================= */

  useEffect(() => {
    const page = document.querySelector('.about-page')

    if (!page) return undefined

    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches

    /*
     * Existing About page elements are mapped here so we do not
     * need to modify every section's JSX just for animation.
     */
    const animationGroups = [
      /* WHO WE ARE */
      {
        selector: '.about-who-v2-label',
        animation: 'reveal-down',
      },
      {
        selector: '.about-who-v2-visual',
        animation: 'reveal-left',
      },
      {
        selector: '.about-who-v2-intro',
        animation: 'reveal-right',
      },
      {
        selector: '.about-who-v2-feature',
        animation: 'reveal-up',
        stagger: 90,
      },
      {
        selector: '.about-who-v2-description',
        animation: 'reveal-right',
      },
      {
        selector: '.about-who-v2-button',
        animation: 'reveal-up',
      },

      /* HOW WE WORK */
      {
        selector: '.about-process-heading',
        animation: 'reveal-up',
      },
      {
        selector: '.about-process-visual',
        animation: 'reveal-left',
      },
      {
        selector: '.about-process-step',
        animation: 'reveal-right',
        stagger: 90,
      },

      /* WHAT WE DO */
      {
        selector: '.about-what-heading',
        animation: 'reveal-up',
      },
      {
        selector: '.about-what-column--left .about-what-service',
        animation: 'reveal-left',
        stagger: 110,
      },
      {
        selector: '.about-what-visual',
        animation: 'reveal-scale',
      },
      {
        selector: '.about-what-column--right .about-what-service',
        animation: 'reveal-right',
        stagger: 110,
      },

      /* OUR APPROACH */
      {
        selector: '.about-approach-heading',
        animation: 'reveal-up',
      },
      {
        selector: '.about-approach-card',
        animation: 'reveal-up',
        stagger: 100,
      },
      {
        selector: '.about-approach-statement',
        animation: 'reveal-scale',
      },

      /* OUR PARTNERS */
      {
        selector: '.about-partners-heading',
        animation: 'reveal-up',
      },
      {
        selector: '.about-partners-marquee',
        animation: 'reveal-scale',
      },
      {
        selector: '.about-partners-bottom',
        animation: 'reveal-up',
      },

      /* OUR SPECIALITIES */
      {
        selector: '.about-specialities-heading',
        animation: 'reveal-up',
      },
      {
        selector: '.about-speciality-card',
        animation: 'reveal-up',
        stagger: 120,
      },
      {
        selector: '.about-specialities-footer',
        animation: 'reveal-up',
      },

      /* OUR TEAM */
      {
        selector: '.about-team-heading',
        animation: 'reveal-up',
      },
      {
        selector: '.about-team-card',
        animation: 'reveal-up',
        stagger: 100,
      },

      /* OUR VISION */
      {
        selector: '.about-vision-eyebrow',
        animation: 'reveal-left',
      },
      {
        selector: '.about-vision-since',
        animation: 'reveal-right',
      },
      {
        selector: '.about-vision-statement',
        animation: 'reveal-up',
      },
      {
        selector: '.about-vision-copy',
        animation: 'reveal-left',
      },
      {
        selector: '.about-vision-visual',
        animation: 'reveal-right',
      },
      {
        selector: '.about-vision-footer',
        animation: 'reveal-up',
      },
    ]

    const animatedElements = []

    animationGroups.forEach(
      ({ selector, animation, stagger = 0 }) => {
        const elements = page.querySelectorAll(selector)

        elements.forEach((element, index) => {
          element.classList.add(
            'about-scroll-reveal',
            animation
          )

          if (stagger) {
            element.style.setProperty(
              '--reveal-delay',
              `${index * stagger}ms`
            )
          }

          animatedElements.push(element)
        })
      }
    )

    if (reduceMotion) {
      animatedElements.forEach((element) => {
        element.classList.add('is-revealed')
      })

      return undefined
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return

          entry.target.classList.add('is-revealed')

          /*
           * Reveal once only.
           * This prevents content jumping every time the user
           * scrolls up and down.
           */
          observer.unobserve(entry.target)
        })
      },
      {
        threshold: 0.13,

        /*
         * Start slightly before the element reaches the
         * centre of the viewport.
         */
        rootMargin: '0px 0px -7% 0px',
      }
    )

    animatedElements.forEach((element) => {
      observer.observe(element)
    })

    return () => {
      observer.disconnect()

      animatedElements.forEach((element) => {
        element.classList.remove(
          'about-scroll-reveal',
          'reveal-left',
          'reveal-right',
          'reveal-up',
          'reveal-down',
          'reveal-scale',
          'is-revealed'
        )

        element.style.removeProperty('--reveal-delay')
      })
    }
  }, [])

  const [activeService, setActiveService] = useState(0)
  const [activeProcessStep, setActiveProcessStep] = useState(0)

  const currentService = whoWeAreServices[activeService]

  return (
    <main className="about-page">
      {/* =====================================================
          WHO WE ARE
      ====================================================== */}
      <section
