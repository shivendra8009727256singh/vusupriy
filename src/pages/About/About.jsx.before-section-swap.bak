              </div>

            </article>

          </div>


          <div className="about-specialities-footer">

            <span>Design</span>
            <i aria-hidden="true" />

            <span>Customize</span>
            <i aria-hidden="true" />

            <strong>Vasupriy Interiovilla</strong>

            <i aria-hidden="true" />
            <span>Execute</span>

            <i aria-hidden="true" />
            <span>Deliver</span>

          </div>

        </div>
